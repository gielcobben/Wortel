---
// Mark-up on the homepage: the section's words (HOME.markup in data/site.ts)
// over the mark-up film (components/films/MarkupFilm.astro), with a link to
// the page that shows everything it does (/mark-up).
//
// This file, HOME.markup and the two lines in pages/index.astro go together;
// taking out the import and the line in index.astro takes the section off the
// page.
import Section from '../Section.astro';
import { HOME } from '../../data/site';
import MarkupFilm from '../films/MarkupFilm.astro';
---
<Section id="mark-up" {...HOME.markup}>
  <MarkupFilm />
</Section>
