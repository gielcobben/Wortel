---
// The questions, in the right column of their section, beside the heading
// (Section.astro, aside). What Wortel is made of is in the bento above
// (Bento.astro).
import Section from '../Section.astro';
import { FAQ, HOME } from '../../data/site';
import { inline } from '../../data/inline';
---
<Section id="faq" aside {...HOME.questions}>
  <div class="list">
    {FAQ.map((f) => (
      <details>
        <summary><span>{f.q}</span><i aria-hidden="true"></i></summary>
        <p class="body" set:html={inline(f.a)} />
      </details>
    ))}
  </div>
</Section>

<style>
  .list { display: flex; flex-direction: column; }
  details { border-top: 1px solid var(--line); }
  details:last-child { border-bottom: 1px solid var(--line); }
  summary {
    list-style: none; cursor: pointer; display: flex; justify-content: space-between; align-items: center; gap: 24px;
    padding-block: 20px; font-size: 16px; line-height: 24px; font-weight: 500; color: var(--ink);
  }
  summary span { text-wrap: balance; }
  summary::-webkit-details-marker { display: none; }
  summary i { position: relative; width: 12px; height: 12px; flex: none; }
  summary i::before, summary i::after { content: ''; position: absolute; left: 0; top: 5px; width: 12px; height: 1.5px; background: var(--ink-3); border-radius: 1px; transition: transform 0.3s var(--ease-out); }
  summary i::after { transform: rotate(90deg); }
  details[open] summary i::after { transform: rotate(0); }
  details .body { margin: 0 0 24px; max-width: 784px; }
  /* The answer opens to its height instead of jumping in, where the browser
     can animate a details element (elsewhere it opens at once, as before). */
  details { interpolate-size: allow-keywords; }
  details::details-content { block-size: 0; overflow: clip; opacity: 0; transition: block-size 250ms var(--ease-out), opacity 200ms ease, content-visibility 250ms allow-discrete; }
  details[open]::details-content { block-size: auto; opacity: 1; }
  @media (prefers-reduced-motion: reduce) { details::details-content { transition: opacity 200ms ease, content-visibility 200ms allow-discrete; } }
</style>
