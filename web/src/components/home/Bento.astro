---
// The bento: what is around the terminal, as one calm poster.
//
// Ten tiles on a regular grid: six columns, rows of 160. A tile is one of
// two sizes and a small one. The large ones (four columns by two rows) hold
// a window or a preview, the medium ones (two by two) a list or a card, and
// the three small ones (one row) a single thing: two side by side, and the
// command, which is a long line, under them at twice the width. Large and medium alternate
// sides down the poster, so it reads as a rhythm and not as a puzzle.
//   - ONE piece of the product per tile and a label of a few words over it,
//     the same size and in the same place on every tile. No sentences.
//   - A fragment of the interface at its own size, with room around it, cut
//     by the tile where it does not fit.
//   - Each tile its own background: the page's fog, or its own crop of ONE
//     photo (three tiles). Light tiles on the site's one grey, no borders,
//     no shadows on the tiles themselves.
// Inside a tile things are centred, which the rest of the site never does:
// a poster is read at a glance, not down a left edge.
//
// It had seventeen tiles in six shapes, and read as busy. What went is what
// the homepage now shows in a section of its own or says in the paragraph
// over the poster: any agent as a command and who needs you (the terminal
// and agents sections), the diff and the rendered plan (See what it did),
// the browser (the splits and mark-up films), five settings and Free (the
// paragraph, and SPECS in data/site.ts for the Markdown pages).
//
// Everything drawn is the real app, generated from the canvas, 1:1 and never
// scaled. The panes are rendered once into a <template>, and scripts/bento.ts
// lifts the named part each tile shows out of them (a preview being marked
// up, the commits, the file tree), so nothing is redrawn here. The two
// windows are built from the canvas's panes the same way a stage's is. What
// macOS draws is drawn as macOS does (the Dock icon). Cursors stand still, as
// the app's does. The tiles' copy is BENTO in data/site.ts, in the order they
// are read (a tile's sentence is there for screen readers and is not shown),
// and the section's own heading and paragraph are HOME.glance.
import { BENTO, HOME } from '../../data/site';
import Section from '../Section.astro';
import Window from '../Window.astro';
import Lead from '../Lead.astro';
import Lights from '../Lights.astro';
import Sidebar from '../../app/gen/Sidebar.astro';
import Terminal from '../../app/gen/Terminal.astro';
import Palette from '../../app/gen/Palette.astro';
import AppContent from '../AppContent.astro';
import MarkUp from '../../app/gen/MarkUp.astro';
import History from '../../app/gen/History.astro';
import Files from '../../app/gen/Files.astro';
import SplitTerminal from '../../app/gen/SplitTerminal.astro';
import ZoomedSplit from '../../app/gen/ZoomedSplit.astro';
import NewTab from '../../app/gen/NewTab.astro';

// A tile that shows a part lifted out of a pane: which part, by its name.
// The mark-up tile's is the foot of a preview with Mark Up on: the note bar
// the app pins to its bottom, and two of the marks above it.
const PART: Record<string, string> = { markup: 'Preview', history: 'Commits', files: 'File tree' };
// The small tiles: one row, one thing.
const SMALL = ['send', 'looks', 'quit'];
---
<Section id="more" {...HOME.glance}>
  <Fragment slot="anchors">
    <span id="worktrees" class="anchor"></span><span id="survival" class="anchor"></span>
    <span id="zero-config" class="anchor"></span><span id="ghostty-engine" class="anchor"></span><span id="specs" class="anchor"></span>
  </Fragment>
    <ul class="bento" data-bento data-photo data-reveal>
      {BENTO.tiles.map((t, i) => (
        <li class:list={['tile', t.scene, { small: SMALL.includes(t.scene) }]} data-tile={t.scene} style={`--d:${i * 50}ms`}>
          {t.scene !== 'looks' && <p class="cap">{t.label}</p>}

          {t.scene === 'hero' && (
            <Window data-win="hero" style="--w:720px;--h:560px">
              <div class="flex min-h-0 min-w-[80px] flex-1 self-stretch"><Terminal /></div>
              <Lights slot="over" />
            </Window>
          )}

          {t.scene === 'splits' && (
            <Window data-win="splits" style="--w:720px;--h:400px">
              <div class="sp-col">
                <div class="sp-slot sp-top"><Terminal /></div>
                <div class="sp-rule"></div>
                <div class="sp-slot sp-low"><ZoomedSplit /></div>
              </div>
              <div class="sp-div"></div>
              <div class="sp-slot sp-new" data-end><NewTab /></div>
              <Lights slot="over" />
            </Window>
          )}

          {t.scene === 'worktree' && (
            <div class="wapp rows" data-rows inert>
              <div class="absolute inset-0 bg-sidebar backdrop-blur-[50px] backdrop-saturate-[1.8]"></div>
              <div class="relative flex w-[234px]"><Sidebar /></div>
            </div>
          )}

          {t.scene === 'send' && (
            <div class="wapp cmd"><p class="bg-background font-mono text-[14px] font-medium leading-[19px] tracking-[-0.155px] text-[#1f2328] dark:text-[#e6edf3]"><span class="text-[#666666] dark:text-[#999999]">$ </span>wortel send tests "run it"<i></i></p></div>
          )}

          {PART[t.scene] && <div class="wapp part bg-background" data-part={PART[t.scene]} data-note="flow" inert></div>}

          {t.scene === 'palette' && <div class="wapp pal" inert><Palette /></div>}

          {t.scene === 'quit' && <div class="app"><img src="/icon-256.png" width="56" height="56" alt="" loading="lazy" /><i></i></div>}

          {t.scene === 'looks' && (
            ['day', 'night'].map((half) => (
              <div class:list={['half', half]} aria-hidden="true">
                <p class="cap">{t.label}</p>
                <p class="ps1"><b class="a">➜</b> <b class="b">wortel</b> <b class="c">git:(</b><b class="d">main</b><b class="c">)</b> <i></i></p>
              </div>
            ))
          )}

          <p class="vh">{t.body}</p>
        </li>
      ))}
    </ul>
    <!-- The panes the tiles take their parts from, and what a window with no
         sidebar gains in its bar. Never shown: scripts/bento.ts clones from them. -->
    <template data-src><AppContent><MarkUp /></AppContent><History /><Files /><SplitTerminal /></template>
    <template data-tpl="lead"><Lead /></template>
</Section>

<script>
  import { initBento } from '../../scripts/bento';
  initBento();
</script>

<style>
  /* The poster: a panel, and the tiles on it. Six columns and rows of 160: a
     large tile is 4 by 2, a medium one 2 by 2, a small one a single row. */
  .bento {
    /* The site's blue, under a name the app's own tokens do not take (inside
       .wapp, --accent is the app's). */
    --gap: 16px; --cursor: var(--accent);
    list-style: none; margin: 0; padding: var(--gap); border-radius: 32px;
    display: grid; gap: var(--gap);
    grid-template-columns: repeat(6, minmax(0, 1fr)); grid-auto-rows: 160px;
    /* The site's one grey, the one the quiet buttons are filled with. */
    background: var(--btn-2);
  }
  /* One tile: its label at the top, 24 in, and what it shows 24 under that. */
  .tile {
    position: relative; overflow: hidden; isolation: isolate; min-width: 0; border-radius: 20px;
    display: flex; flex-direction: column; align-items: center; justify-content: flex-start; gap: 24px;
    padding: 24px; text-align: center;
    background: var(--fog-0); color: var(--ink);
  }
  /* Large and medium change sides from one pair of rows to the next. */
  .hero     { grid-area: 1 / 1 / 3 / 5; }
  .worktree { grid-area: 1 / 5 / 3 / 7; }
  .palette  { grid-area: 3 / 1 / 5 / 3; }
  .splits   { grid-area: 3 / 3 / 5 / 7; }
  .markup   { grid-area: 5 / 1 / 7 / 5; }
  .history  { grid-area: 5 / 5 / 7 / 7; }
  .files    { grid-area: 7 / 1 / 9 / 3; }
  .quit     { grid-area: 7 / 3 / 8 / 5; }
  .looks    { grid-area: 7 / 5 / 8 / 7; }
  .send     { grid-area: 8 / 3 / 9 / 7; }

  /* ---- what a tile stands on -------------------------------------------------
     The page's fog, and three tiles that are each their own crop of one photo. */
  .worktree, .hero, .quit { background: #2b3328; }
  .worktree::before, .hero::before, .quit::before {
    content: ''; position: absolute; inset: 0 auto; z-index: -1;
    left: calc((1 - var(--zoom)) * var(--ax) * 100%); width: calc(var(--zoom) * 100%);
    background: linear-gradient(rgb(16 22 15 / 0.3), rgb(16 22 15 / 0.3)), var(--lake-veil), url(/img/skye.jpg) var(--at) / cover no-repeat;
  }
  /* Their photo comes when the poster nears, like a stage's (site.css). */
  :global(.js) .bento:not([data-near]) :is(.worktree, .hero, .quit)::before { background-image: none; }
  /* The crop, as a stage's (site.css): --zoom times the tile's width, and
     never smaller than the tile, however tall a narrow screen makes it. */
  .hero { --at: 62% 78%; --ax: 0.62; --zoom: 1.6; }
  .worktree { --at: 18% 62%; --ax: 0.18; --zoom: 3; }
  .quit { --at: 0% 92%; --ax: 0; --zoom: 3; }
  .worktree .cap, .hero .cap, .quit .cap { color: #fff; text-shadow: 0 1px 12px rgb(0 0 0 / 0.3); }

  /* It assembles in reading order. The panel itself does not move. */
  :global(.js) .bento[data-reveal] { opacity: 1; translate: none; filter: none; }
  :global(.js) .bento[data-reveal] .tile {
    opacity: 0; scale: 0.96;
    transition: opacity 500ms var(--ease-out) var(--d), scale 800ms var(--ease-settle) var(--d);
  }
  :global(.js) .bento[data-reveal]:global(.in) .tile { opacity: 1; scale: 1; }
  @media (prefers-reduced-motion: reduce) {
    :global(.js) .bento[data-reveal] .tile { scale: 1; transition: opacity 400ms ease var(--d); }
  }

  /* One label, a few words, the same size and place on every tile. */
  .cap { position: relative; z-index: 2; margin: 0; flex: none; font: 500 17px/24px var(--font-display); letter-spacing: -0.012em; text-wrap: balance; color: var(--ink); }

  /* ---- the two windows -------------------------------------------------------
     A window is as wide as its tile lets it be, 24 in from each side, and
     never narrower than it is drawn: a narrow tile cuts its right side. It is
     taller than the tile, which cuts its foot. With no sidebar it owns the
     traffic lights (Lights) and the corner pair, Running and "…"
     (Window.astro), as the app's does: its main row starts clear of the
     lights. */
  .hero :global(.win), .splits :global(.win) { position: absolute; left: 24px; top: 72px; width: max(var(--w), calc(100% - 48px)); max-width: none; text-align: left; }
  .tile :global([data-solo] header[data-name="Main bar"]) { padding-left: 78px; padding-right: 72px; }
  /* The window in splits: a session's terminal, the shell ⇧⌘D put under it
     with a dev server running, and beside both a split holding a new tab,
     which lists what it can become. Each has its own row of tabs. */
  .sp-col { display: flex; flex-direction: column; flex: none; width: 320px; min-height: 0; }
  .sp-slot { display: flex; min-width: 0; min-height: 0; }
  .sp-slot > :global(*) { flex: 1; }
  .sp-top { flex: none; height: 136px; }
  .sp-low, .sp-new { flex: 1; }
  .sp-rule { height: 1px; flex: none; background: var(--sidebar-border); }
  .sp-div { width: 1px; flex: none; align-self: stretch; background: var(--sidebar-border); }
  /* The top left row starts clear of the traffic lights, and is not the
     rightmost: it ends 8 from its split's edge. */
  .splits :global(header[data-name="Main bar"]) { padding-left: 78px; padding-right: 8px; }
  /* A row lower down is a band, as the splits film has it (PanesFilm.astro). */
  .sp-low :global(header) { height: 36px; padding-right: 8px; border-bottom-width: 0; background: linear-gradient(var(--muted), var(--muted)), var(--background); }
  .sp-low :global(header .bg-sidebar-accent) { background-color: var(--card); }
  .sp-top :global([data-name="Terminal"]), .sp-low :global([data-name="Terminal"]) { justify-content: flex-start; }

  /* ---- parts of the app, at their own size, cut by the tile ------------------ */
  .part, .pal, .rows { text-align: left; }
  /* A part lifted out of a pane: a page of the app with one corner showing,
     running to the tile's right edge and its foot. */
  .part {
    position: absolute; left: 24px; top: 72px; right: 0; bottom: 0; display: flex; flex-direction: column; overflow: hidden;
    border-radius: 12px 0 0 0; box-shadow: 0 0 0 1px var(--line), 0 12px 32px rgb(0 0 0 / 0.1);
  }
  .part > :global(*) { flex: 1 1 auto; min-height: 0; width: 100%; overflow: hidden; }
  /* Mark Up on a rendered plan: the foot of the preview, down to the tile's
     edge, so the note bar the app pins to the bottom is in view, whole, with
     the arrow and the highlight above it. 650 wide is the preview at which
     the plan's column reaches its 602 and wraps as the canvas drew it, which
     is where the marks were placed; the tile is wider than that, so the
     preview stands in its middle. */
  .markup { container-type: inline-size; }
  .markup .part { left: calc(50% - 325px); right: auto; width: 650px; border-radius: 12px 12px 0 0; }
  /* In a tile narrower than the preview, the part of it the two marks are in
     (the column's 242nd point) is in the middle and the tile cuts both
     sides. The note bar stays whole: it is as wide as the tile shows of the
     preview, 8 in from each side, as the app has it in a preview that
     narrow, its sentence wrapping around the chips as a text view's does
     (data-note="flow", styles/app.css).
     The plan is moved up by the lines the bar gains, so the marks stay
     clear of it. */
  @container (max-width: 698px) {
    .markup .part { left: calc(50% - 266px); }
    /* From the tile's left edge, 8 in, or the preview's own, 16 in, whichever
       is further right; to 8 short of the tile's right edge. In the
       preview's points: the tile is 100cqw and its padding of 24 each side
       wide, and the preview starts 266 left of its middle. */
    .markup .part :global([data-name="Note bar"]) {
      --from: max(16px, calc(266px - 50cqw - 16px));
      left: var(--from); right: auto; width: calc(50cqw + 282px - var(--from)); margin: 0;
    }
    .markup .part :global([data-name="Markdown"]) { padding-bottom: 24px; }
  }
  @container (max-width: 480px) {
    .markup .part :global([data-name="Markdown"]) { padding-bottom: 48px; }
  }
  /* On the narrowest phones the bar's row is wider than the bar: Move, the
     divider before it and Clear Note give way, so the pens and Copy stay
     whole, as in the mark-up film (MarkupFilm.astro). */
  @container (max-width: 230px) {
    .markup .part :global([data-name="Tool row"] :is([data-name="Move"], [data-name="Divider"], [data-name="Clear Note"])) { display: none; }
  }

  /* The top of the command palette. */
  .pal { position: absolute; left: 24px; top: 72px; width: 560px; }
  .pal :global([data-name="Command palette"]) { box-shadow: 0 0 0 1px var(--line), 0 16px 40px rgb(0 0 0 / 0.16); }

  /* Three rows of the real sidebar on its own glass, as wide as the sidebar
     is: bento.ts leaves one folder and its worktree sessions. The glass takes
     the card's corners: a backdrop filter is not clipped by its parent's
     rounded ones (app.css gives only a window's glass its 18). */
  .rows > :first-child { border-radius: inherit; }
  .rows { position: relative; display: flex; width: 234px; margin-block: auto; overflow: hidden; border-radius: 14px; box-shadow: 0 16px 40px rgb(0 0 0 / 0.3), 0 0 0 0.5px rgb(0 0 0 / 0.3); }
  .rows :global([data-name="Sidebar bar"]), .rows :global([data-name="Sidebar footer"]) { display: none; }
  .rows :global([data-name="Sessions"]) { overflow: hidden; padding-block: 6px; }
  .rows :global([data-name="Working"] > div) { animation: wave 1.4s ease-in-out infinite; }
  .rows :global([data-name="Working"] > div:nth-child(2)) { animation-delay: 0.18s; }
  .rows :global([data-name="Working"] > div:nth-child(3)) { animation-delay: 0.36s; }
  @keyframes wave { 50% { opacity: 0.25; } }

  /* ---- the small tiles: the label, and one thing in the room under it -------- */
  .small > :not(.cap, .vh, .half) { margin-block: auto; }
  /* One command, in the terminal's own type, with the cursor after it. */
  .cmd { overflow: hidden; border-radius: 999px; box-shadow: 0 0 0 1px var(--line), 0 4px 16px rgb(0 0 0 / 0.06); }
  .cmd p { margin: 0; padding: 8px 24px; white-space: pre; display: flex; align-items: center; }
  .cmd i { width: 8.5px; height: 17px; margin-left: 8.5px; background: var(--cursor); }
  /* The app in the Dock, with the dot that says it is running. */
  .app { position: relative; width: 56px; height: 62px; }
  .app img { display: block; width: 56px; height: 56px; filter: drop-shadow(0 4px 10px rgb(0 0 0 / 0.35)); }
  .app i { position: absolute; bottom: 0; left: 50%; width: 4px; height: 4px; margin-left: -2px; border-radius: 50%; background: #fff; box-shadow: 0 0 0 0.5px rgb(0 0 0 / 0.3); }

  /* The same line by day and by night, in the terminal's two themes (GitHub
     Light and Dark, the app's own colours). Both halves hold the same thing
     in the same place, the label at the top like every tile's, and each is
     cut to its side of one diagonal. */
  .looks { padding: 0; }
  .half {
    position: absolute; inset: 0; display: flex; flex-direction: column; align-items: center; padding: 24px;
    background: #ffffff; --fg: #1f2328; --a: #116329; --b: #1b7c83; --c: #0969da; --d: #cf222e; --k: #0969da;
    clip-path: polygon(0 0, 58% 0, 42% 100%, 0 100%);
  }
  .half.night {
    background: #0d1117; --fg: #e6edf3; --a: #3fb950; --b: #39c5cf; --c: #58a6ff; --d: #ff7b72; --k: #3081f7;
    clip-path: polygon(58% 0, 100% 0, 100% 100%, 42% 100%);
  }
  .half .cap { color: var(--fg); }
  .ps1 { margin: auto 0; white-space: pre; font: 500 14px/19px var(--font-mono); letter-spacing: -0.155px; color: var(--fg); }
  .ps1 b { font-weight: 700; }
  .ps1 .a { color: var(--a); font-weight: 500; } .ps1 .b { color: var(--b); } .ps1 .c { color: var(--c); } .ps1 .d { color: var(--d); }
  .ps1 i { display: inline-block; width: 8.5px; height: 17px; vertical-align: -3px; background: var(--k); }

  @media (prefers-reduced-motion: reduce) {
    .rows :global([data-name="Working"] > div) { animation: none; }
  }

  /* Narrower than the poster can hold: the same tiles in one column, in the
     order they are read, a large or medium one two rows tall. */
  @media (max-width: 960px) {
    .bento { grid-template-columns: minmax(0, 1fr); border-radius: 28px; }
    .tile { grid-area: auto; grid-row: span 2; }
    .tile.small { grid-row: span 1; }
  }
  @media (max-width: 760px) {
    .cmd p { padding-inline: 16px; }
  }
</style>
