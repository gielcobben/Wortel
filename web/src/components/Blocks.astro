---
// One Block[] from src/data/site.ts, as HTML.
//
// Extracted the day /docs appeared: the landing page and the reference page
// render the same three shapes (a paragraph, a list, a two-column table) out of
// the same array type, and a second copy of this markup is a second place for
// `scope` to go missing off a table header. llms-full.txt.ts has the third
// renderer, to Markdown rather than HTML, and is the one that cannot share.
//
// No styles of its own. Everything here is styled by `.doc` in global.css,
// which is what lets the same block land on the landing page's 324px column
// beside the window and on /docs at 568px without knowing which it is in.
import type { Block } from '../data/site';

interface Props {
  blocks: Block[];
}

const { blocks } = Astro.props;
---

{blocks.map((block) => (
  <>
    {'p' in block && <p>{block.p}</p>}
    {'list' in block && (
      <ul>{block.list.map((li) => <li>{li}</li>)}</ul>
    )}
    {'table' in block && (
      <div class="scroller">
        <table class={block.table.mono === 'last' ? 'mono-last' : 'mono-first'}>
          <thead>
            <tr>
              <th scope="col">{block.table.head[0]}</th>
              <th scope="col">{block.table.head[1]}</th>
            </tr>
          </thead>
          <tbody>
            {block.table.rows.map(([k, v]) => (
              <tr><th scope="row">{k}</th><td>{v}</td></tr>
            ))}
          </tbody>
        </table>
      </div>
    )}
  </>
))}
