---
import '../styles/global.css';
import { SITE } from '../data/site';

interface Props {
  title?: string;
  description?: string;
  /** Path of this page, leading slash. Canonical + og:url are built from it. */
  path?: string;
  /** JSON-LD graph nodes. Rendered as one @graph so crawlers see one document. */
  schema?: unknown[];
}

const {
  title = SITE.title,
  description = SITE.description,
  path = '/',
  schema = [],
} = Astro.props;

// Built off the configured `site` rather than Astro.url, so a preview host or a
// wrangler dev origin can never emit a canonical pointing at itself.
const canonical = new URL(path, SITE.url).href;
const ogImage = new URL('/og.png', SITE.url).href;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="generator" content={Astro.generator} />

    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <!-- max-image-preview:large is what lets the og image ride along in a
         result; the default (`standard`) shows a thumbnail or nothing. -->
    <meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1" />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={SITE.name} />
    <meta property="og:locale" content="en_US" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:type" content="image/png" />
    <meta property="og:image:alt" content={`${SITE.name}: ${SITE.tagline}`} />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <meta name="twitter:image:alt" content={`${SITE.name}: ${SITE.tagline}`} />

    <meta name="apple-mobile-web-app-title" content={SITE.name} />
    <meta name="theme-color" media="(prefers-color-scheme: dark)" content="#1c1d27" />
    <meta name="theme-color" media="(prefers-color-scheme: light)" content="#ffffff" />

    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <!-- Raster fallback: Google's favicon crawler documents a >=48px square
         image, and some feed readers still won't take an SVG. -->
    <link rel="icon" href="/favicon-96.png" type="image/png" sizes="96x96" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />

    <!-- Both faces paint in the first screen (the wordmark and the app replica),
         so they're worth the early fetch rather than waiting on CSS parse. -->
    <link rel="preload" href="/fonts/geist-pixel-square.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/handlee.woff2" as="font" type="font/woff2" crossorigin />
    <!-- The download and the version line both come off this host. -->
    <link rel="preconnect" href="https://updates.wortel.sh" crossorigin />

    <!-- A pointer for retrieval agents: the same content, already flattened.
         `describedby` is the registered relation for "this document is
         described by that one". -->
    <link rel="alternate" type="text/plain" href="/llms.txt" title="llms.txt: a site map for language models" />
    <link rel="describedby" type="text/markdown" href="/llms-full.txt" title="Full page content as Markdown" />

    {schema.length > 0 && (
      <script
        type="application/ld+json"
        set:html={JSON.stringify({ '@context': 'https://schema.org', '@graph': schema })}
      />
    )}
  </head>
  <body>
    <slot />
  </body>
</html>
