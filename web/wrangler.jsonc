{
  // Cloudflare Worker that serves the static Astro build at wortel.sh.
  // Deploy with `npm run deploy` (astro build && wrangler deploy).
  //
  // It was assets-only until PostHog arrived. `main` does NOT put a script in
  // front of the site: Cloudflare matches a static asset first and only invokes
  // the Worker when nothing matches, so every page and font is served exactly
  // as before and worker/index.ts runs for /ph/* alone. See that file for why
  // the analytics traffic is proxied rather than sent to posthog.com direct.
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "wortel-web",
  // Cobben account — the one that holds the wortel.sh zone.
  "account_id": "c91d5fdf38b8d28d8220c2a7d5b5610f",
  "compatibility_date": "2026-07-15",
  "main": "./worker/index.ts",
  "assets": {
    "directory": "./dist",
    // Only meaningful alongside `main`: it is how the Worker hands a request
    // back to the assets layer instead of inventing its own 404.
    "binding": "ASSETS",
    // Astro builds /compare/index.html, and the default ("auto-trailing-slash")
    // serves that at /compare/ while redirecting /compare to it. But every
    // canonical tag and every sitemap entry on this site is written WITHOUT the
    // slash (Layout.astro builds them from a `path` prop like "/compare"), so
    // the default made every subpage canonical point at a redirect and filled
    // the sitemap with URLs that 307. Serving the no-slash form is the half of
    // that pair worth keeping: it matches what the site already claims about
    // itself, and it is what the internal links use.
    "html_handling": "drop-trailing-slash"
  },
  // Route the apex + www at wortel.sh. Requires the wortel.sh zone on this
  // Cloudflare account; adjust/remove if you deploy to a *.workers.dev URL first.
  "routes": [
    { "pattern": "wortel.sh", "custom_domain": true }
  ]
}
