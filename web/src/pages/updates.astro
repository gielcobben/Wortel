---
// The changelog: every release note, newest first, each with its own anchor.
// The notes are the Markdown files in src/content/releases/, the same ones
// release-notes/[version].html.ts turns into Sparkle's in-app dialog.
import Layout from '../layouts/Layout.astro';
import { getCollection, render } from 'astro:content';
import { compareVersions } from '../content.config';
import { SITE } from '../data/site';

const entries = await getCollection('releases');
const releases = await Promise.all(
  entries
    .sort((a, b) => compareVersions(b.id, a.id))
    .map(async (entry) => ({ entry, Content: (await render(entry)).Content })),
);
const latest = releases[0];
/** Releases shown in full; the rest fold into one row each. */
const FULL = 12;
const oldest = releases[releases.length - 1];
const fmt = (d: Date) => d.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric', timeZone: 'UTC' });
const abs = (p: string) => new URL(p, SITE.url).href;
const title = `Changelog: every ${SITE.name} release`;
const description =
  `Release notes for every version of ${SITE.name}, the native macOS terminal built on Ghostty. ` +
  `${releases.length} releases since ${oldest ? fmt(oldest.entry.data.date) : ''}.`;
const schema = [{
  '@type': 'WebPage', '@id': abs('/updates#webpage'), url: abs('/updates'), name: title, description,
  isPartOf: { '@id': abs('/#website') }, about: { '@id': abs('/#app') }, inLanguage: 'en',
  ...(latest && { dateModified: latest.entry.data.date.toISOString().slice(0, 10) }),
}];
---
<Layout title={title} description={description} path="/updates" schema={schema}>
  <header class="column phead" data-reveal-group>
    <h1 class="display" data-reveal>Changelog</h1>
    <p class="lead" data-reveal>
      {releases.length} releases since {oldest && fmt(oldest.entry.data.date)}. Wortel updates itself, so this page is for reading.
    </p>
  </header>

  <div class="column log">
    {releases.slice(0, FULL).map(({ entry, Content }, i) => (
      <article class="rel" id={entry.id}>
        <p class="meta">
          <a class="ver" href={`#${entry.id}`} data-ph="changelog_opened" data-ph-version={entry.id}>{entry.id}</a>
          <time datetime={entry.data.date.toISOString().slice(0, 10)}>{fmt(entry.data.date)}</time>
          {i === 0 && <span class="pill">Latest</span>}
        </p>
        <h2 class="t">{entry.data.title}</h2>
        <div class="prose"><Content /></div>
      </article>
    ))}
    <section class="older">
      <h2 class="label">Earlier releases</h2>
      {releases.slice(FULL).map(({ entry, Content }) => (
        <details class="old" id={entry.id}>
          <summary data-ph="changelog_opened" data-ph-version={entry.id}>
            <span class="ver">{entry.id}</span>
            <span class="ot">{entry.data.title}</span>
          </summary>
          <div class="prose">
            <p class="label"><time datetime={entry.data.date.toISOString().slice(0, 10)}>{fmt(entry.data.date)}</time></p>
            <Content />
          </div>
        </details>
      ))}
    </section>
  </div>
</Layout>

<script>
  // A link to an older release opens it.
  const open = () => {
    const el = location.hash && document.getElementById(decodeURIComponent(location.hash.slice(1)));
    if (el instanceof HTMLDetailsElement) { el.open = true; el.scrollIntoView(); }
  };
  open();
  window.addEventListener('hashchange', open);
</script>

<style>
  .rel { padding-block: 56px; border-top: 1px solid var(--line); scroll-margin-top: 56px; }
  .meta { display: flex; align-items: center; gap: 16px; margin: 0 0 16px; }
  .ver { font: 500 14px/24px var(--font-mono); color: var(--ink); }
  .ver:hover { text-decoration: underline; text-underline-offset: 4px; }
  time { font-size: 14px; line-height: 24px; color: var(--ink-3); }
  .pill { font-size: 12px; line-height: 16px; font-weight: 500; padding: 4px 8px; border-radius: 999px; background: var(--blue-soft); color: var(--blue); }
  .t { margin: 0 0 24px; font: 600 24px/32px var(--font-display); letter-spacing: -0.02em; color: var(--ink); text-wrap: balance; }
  .older { padding-top: 56px; border-top: 1px solid var(--line); }
  .older .label { margin: 0 0 16px; }
  .old { border-top: 1px solid var(--line); scroll-margin-top: 56px; }
  .old summary { list-style: none; cursor: pointer; display: grid; grid-template-columns: 120px 1fr; gap: 16px; align-items: baseline; padding-block: 16px; }
  .old summary::-webkit-details-marker { display: none; }
  .old .ot { font-size: 15px; line-height: 24px; color: var(--ink); }
  .old summary:hover .ot { text-decoration: underline; text-underline-offset: 4px; }
  .old .prose { padding: 0 0 40px; }
  @media (max-width: 640px) { .old summary { grid-template-columns: 1fr; gap: 0; } }
</style>
