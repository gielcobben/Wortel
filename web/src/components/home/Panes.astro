---
// The window, explained by the ways people arrange it, and by letting you.
//
// One live window built from the canvas's pane library. Its chapters are
// arrangements you would actually use, named for what you are doing rather
// than for the panes involved. The window's own controls work too: the
// sidebar and column buttons, the tabs, the sessions. scripts/panes.ts moves
// it the way the app does, a place at a time. The window is never scaled.
import Section from '../Section.astro';
import Stage from '../Stage.astro';
import { HOME } from '../../data/site';
import Window from '../Window.astro';
import Sidebar from '../../app/gen/Sidebar.astro';
import TerminalNarrow from '../../app/gen/TerminalNarrow.astro';
import FileMain from '../../app/gen/FileMain.astro';
import AppContent from '../AppContent.astro';
import Browser from '../../app/gen/Browser.astro';
import Changes from '../../app/gen/Changes.astro';
import History from '../../app/gen/History.astro';
import Files from '../../app/gen/Files.astro';
import BottomStrip from '../../app/gen/BottomStrip.astro';
import Lead from '../Lead.astro';
import Lights from '../Lights.astro';

const chapters = ['Changes', 'History', 'Browser', 'Files', 'Terminal'];
---
<Section id="panes" {...HOME.window}>
  <Fragment slot="anchors"><span id="sessions" class="anchor"></span><span id="git-and-files" class="anchor"></span></Fragment>
    <Stage film="panes" chapters={chapters} photo="skye" at="50% 50%">
      <Window live data-pwin>
        <div class="slot sb" data-slot="sidebar">
          <div class="pane" data-pane="sidebar"><Sidebar /></div>
        </div>
        <div class="divider" data-div="sidebar"></div>
        <div class="mainarea">
          <div class="slot main" data-slot="main">
            <div class="pane" data-pane="terminal"><TerminalNarrow /></div>
            <div class="pane" data-pane="file"><AppContent><FileMain /></AppContent></div>
            <div class="pane" data-pane="browser"><AppContent><Browser /></AppContent></div>
          </div>
          <div class="slot strip" data-slot="strip">
            <div class="pane" data-pane="strip"><BottomStrip /></div>
          </div>
        </div>
        <div class="divider" data-div="side"></div>
        <div class="slot side" data-slot="side">
          <div class="pane" data-pane="changes"><Changes /></div>
          <div class="pane" data-pane="history"><History /></div>
          <div class="pane" data-pane="files"><Files /></div>
        </div>
        <Lights slot="over" />
      </Window>
      <!-- What the main bar gains when a neighbour is hidden, as the canvas
           draws its "No sidebar" and "Terminal" states. Cloned by panes.ts. -->
      <template data-tpl="lead">
        <Lead />
      </template>
      <template data-tpl="trail">
        <div data-name="Toolbar divider" class="h-4 w-px shrink-0 bg-input"></div>
        <div data-name="Show Side Column" class="flex size-7 shrink-0 items-center justify-center">
          <div class="h-[15px] w-[20px] shrink-0 bg-sidebar-accent-foreground [mask-image:url(/app/fcba5c820534b40058a17d1ab0846f7f.png)] [mask-size:100%_100%]"></div>
        </div>
      </template>
    </Stage>
</Section>

<script>
  import { initPanes } from '../../scripts/panes';
  initPanes();
</script>

<style>
  [data-film="panes"] :global([data-pane="browser"] img[data-name="Web page"]) { object-position: 50% 0; }

  /* Slots, sized the way the canvas sizes them: the sidebar 234, the column
     384, or 234 when it holds the file tree. A divider stays where it was
     dragged, so the strip's height is ours. */
  .slot { position: relative; display: grid; min-height: 0; min-width: 0; overflow: hidden; }
  .slot > * { grid-area: 1 / 1; min-width: 0; min-height: 0; }
  .sb { width: 234px; flex: none; }
  .mainarea { display: flex; flex-direction: column; flex: 1; min-width: 80px; min-height: 0; }
  .main { flex: 1; min-height: 80px; }
  .strip { flex: none; height: 200px; min-height: 0; }
  /* One track as wide as the column, so the file tree's narrower pane is
     not held at the width of the widest pane stacked with it. */
  .side { width: 384px; flex: none; grid-template-columns: 100%; }
  .divider { width: 1px; flex: none; background: var(--sidebar-border); align-self: stretch; }
  .pane { display: flex; }
  /* A folding slot clips its pane, the way a split view does, instead of
     reflowing it through every width on the way to zero. */
  .sb .pane { min-width: 234px; }
  .side .pane { min-width: 384px; }
  .side [data-pane="files"] { min-width: 234px; }
  .strip .pane { min-height: 200px; }
  .pane > :global(*) { flex: 1; }
  .pane:not(:first-child) { visibility: hidden; opacity: 0; }

  /* On a phone: the main pane as wide as the stage, and the column beside
     it just as wide, so each is whole when the film pans to it
     (scripts/panes.ts). */
  @media (max-width: 760px) {
    :global([data-film="panes"] .stage .win) { width: calc(200% + 1px); }
    .side { width: calc((100% - 1px) / 2); }
    .side .pane, .side [data-pane="files"] { min-width: 100%; }
  }

  /* The window owns the traffic lights (Lights.astro); the pane's copy hides. */
  [data-film="panes"] :global([data-pane="sidebar"] [data-name="Traffic lights"]) { visibility: hidden; }
</style>
