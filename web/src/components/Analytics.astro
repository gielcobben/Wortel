    posthog.init(KEY, {
      // Same origin, proxied by worker/index.ts.
      api_host: window.location.origin + '/ph',
      ui_host: 'https://eu.posthog.com',
      defaults: '2026-05-30',
      person_profiles: 'identified_only',
      // Nothing on the reader's machine, so nothing to consent to. PostHog
      // counts visitors by a daily hash instead: see the note above.
      cookieless_mode: 'always',
      autocapture: false,
      disable_session_recording: true,
      disable_surveys: true,
      // How fast each page is for the people reading it (LCP, CLS, INP, FCP),
      // which a page whose pitch is speed should know. Not the network timing
      // half: that is every resource URL the page loads, and nobody reads it.
      capture_performance: { web_vitals: true, network_timing: false },
    });

    // Declared events: see components/Analytics.astro for the convention.
    document.addEventListener('click', (e) => {
      const el = e.target instanceof Element ? e.target.closest('[data-ph]') : null;
      if (!el) return;
      const props = {};
      for (const [k, v] of Object.entries(el.dataset)) {
        // phLocation yes, photo no: the capital is the attribute boundary, and
        // without checking it any data-ph* word would be read as a property.
        if (k.length < 3 || !k.startsWith('ph') || k[2] !== k[2].toUpperCase()) continue;
        // phToVersion -> to_version
        props[k.slice(2).replace(/^./, (c) => c.toLowerCase())
                       .replace(/[A-Z]/g, (c) => '_' + c.toLowerCase())] = v;
      }
      window.posthog?.capture(el.dataset.ph, props);
    }, true);

    // The app window, once per page load.
    document.addEventListener('click', (e) => {
      const frame = e.target instanceof Element ? e.target.closest('[data-ph-demo]') : null;
      if (!frame || frame.dataset.phSeen) return;
      frame.dataset.phSeen = '1';
      window.posthog?.capture('demo_engaged');
    }, true);
  </script>
)}
