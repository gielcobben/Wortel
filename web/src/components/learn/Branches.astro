---
// Worktrees, drawn the way the name has it: the repository at the surface,
// and under it the folders its branches grow into, one agent in each. The
// roots draw themselves down when the picture arrives. The paths are the
// ones Wortel makes (~/.wortel/worktrees/<repo>/<branch>, macos/Wortel/Git/
// GitWorktree.swift); the words are LEARN.branches in data/site.ts.
//
// Not the app, so not a window: a picture in the site's own type, on the
// panel the bento stands on.
import { LEARN } from '../../data/site';
const { repo, trees, shared } = LEARN.branches;
// The roots: from the middle of the repository's card to the top middle of
// each folder's, on a box that stretches with the panel (the lines keep
// their width, vector-effect).
const n = trees.length;
const ends = trees.map((_, i) => ((i + 0.5) / n) * 600);
---
<figure class="roots" data-reveal data-nosnippet>
  <div class="surface">
    <div class="card repo">
      <p class="branch"><i class="glyph" aria-hidden="true"></i>{repo.branch}</p>
      <p class="path">{repo.path}</p>
      <p class="who">{repo.who}</p>
    </div>
  </div>
  <svg class="lines" viewBox="0 0 600 96" preserveAspectRatio="none" aria-hidden="true">
    {ends.map((x) => <path d={`M300 0 C300 56 ${x} 40 ${x} 96`} pathLength="1" vector-effect="non-scaling-stroke" />)}
  </svg>
  <ul class="trees" style={`--n:${n}`}>
    {trees.map((t, i) => (
      <li class="card" style={`--d:${0.5 + i * 0.12}s`}>
        <p class="branch"><i class="glyph" aria-hidden="true"></i>{t.branch}</p>
        <p class="path">{t.path}</p>
        <p class="who">{t.who}</p>
      </li>
    ))}
  </ul>
  <p class="shared">{shared}</p>
</figure>

<style>
  .roots {
    position: relative; margin: 0; padding: 48px 48px 56px; border-radius: 32px; background: var(--btn-2);
    display: flex; flex-direction: column; align-items: center; overflow: hidden;
  }
  /* The surface: a hairline across the panel at the repository's middle. */
  .surface { position: relative; width: 100%; display: flex; justify-content: center; }
  .surface::before { content: ''; position: absolute; left: -48px; right: -48px; top: 50%; height: 1px; background: var(--line-2); }
  .card {
    position: relative; display: flex; flex-direction: column; gap: 4px; min-width: 0;
    padding: 16px 24px; border-radius: 16px; background: var(--fog-0);
    box-shadow: 0 0 0 1px var(--line), 0 8px 24px rgb(0 0 0 / 0.04);
  }
  .repo { width: min(360px, 100%); }
  .card p { margin: 0; min-width: 0; }
  .branch { display: flex; align-items: center; gap: 8px; font: 500 15px/24px var(--font-sans); color: var(--ink); }
  /* The app's own branch mark (the sidebar's arrow.triangle.branch). */
  .glyph { flex: none; width: 11px; height: 11px; background: var(--ink-3); -webkit-mask: url(/app/0084794371f21a82f249b93e2dd6c5a5.png) 0 0 / 100% 100%; mask: url(/app/0084794371f21a82f249b93e2dd6c5a5.png) 0 0 / 100% 100%; }
  .path { font: 500 12px/16px var(--font-mono); color: var(--ink-3); overflow-wrap: anywhere; }
  .who { font-size: 13px; line-height: 24px; color: var(--ink-2); }
  .lines { display: block; width: 100%; height: 96px; overflow: visible; }
  .lines path { fill: none; stroke: var(--ink-3); stroke-width: 1; stroke-dasharray: 1; stroke-dashoffset: 0; }
  .shared { margin: 32px 0 0; font-size: 13px; line-height: 16px; color: var(--ink-3); text-align: center; }
  .trees { list-style: none; margin: 0; padding: 0; width: 100%; display: grid; grid-template-columns: repeat(var(--n), minmax(0, 1fr)); gap: 24px; }

  /* They grow down when the picture arrives, then the folders come up. */
  :global(.js) .roots[data-reveal] { translate: none; filter: none; }
  :global(.js) .roots[data-reveal] .lines path { stroke-dashoffset: 1; transition: stroke-dashoffset 1100ms var(--ease-settle) 250ms; }
  :global(.js) .roots[data-reveal]:global(.in) .lines path { stroke-dashoffset: 0; }
  :global(.js) .roots[data-reveal] .trees .card { opacity: 0; translate: 0 8px; transition: opacity 600ms var(--ease-out) var(--d), translate 800ms var(--ease-settle) var(--d); }
  :global(.js) .roots[data-reveal]:global(.in) .trees .card { opacity: 1; translate: none; }
  @media (prefers-reduced-motion: reduce) {
    :global(.js) .roots[data-reveal] .lines path { stroke-dashoffset: 0; transition: none; }
    :global(.js) .roots[data-reveal] .trees .card { translate: none; transition: opacity 400ms ease var(--d); }
  }

  /* On a phone the folders stack, and one root runs down beside them. */
  @media (max-width: 760px) {
    .roots { padding: 32px 16px; align-items: stretch; }
    .surface::before { left: -16px; right: -16px; }
    .repo { width: 100%; }
    .lines { display: none; }
    .shared { text-align: left; margin-top: 24px; }
    .trees { grid-template-columns: 1fr; gap: 16px; margin-top: 32px; padding-left: 24px; border-left: 1px solid var(--ink-3); }
  }
</style>
