---
import Layout from '../layouts/Layout.astro';
import WortelApp from '../demo/WortelApp.svelte';

// The Sparkle feed lives at updates.wortel.sh; the newest signed zip is always
// mirrored to Wortel-latest.zip, so a single stable download URL works forever.
const DOWNLOAD = 'https://updates.wortel.sh/Wortel-latest.zip';

const features = [
  ['Sessions', 'Named, not numbered'],
  ['Launch', 'Cold start stays lean'],
  ['Switching', 'One frame, no flash'],
  ['No config', 'No tabs, splits, or settings'],
  ['Engine', 'Ghostty VT parser + Metal'],
];
---

<Layout>
  <main class="page">
    <div class="left">
      <div class="intro">
        <h1 class="mark">Wortel</h1>
        <p class="tagline">A minimal, native macOS terminal.</p>
        <p class="desc">
          Ghostty’s engine, stripped to what you actually use — named sessions,
          instant launch, instant switching. No tabs, no splits, no config to
          babysit. It’s finished the moment you open it.
        </p>
        <p class="links">
          <a class="download" href={DOWNLOAD}>
            <svg viewBox="0 0 16 16" width="15" height="15" aria-hidden="true">
              <path d="M8 1v8.5M8 9.5 4.75 6.25M8 9.5l3.25-3.25M2.5 12.5h11"
                fill="none" stroke="currentColor" stroke-width="1.4"
                stroke-linecap="round" stroke-linejoin="round" />
            </svg>
            Download for macOS
          </a>
        </p>
      </div>

      <div class="features">
        <p class="head">Features</p>
        <dl>
          {features.map(([name, desc]) => (
            <div>
              <dt>{name}</dt>
              <dd>{desc}</dd>
            </div>
          ))}
        </dl>
      </div>
    </div>

    <div class="stage">
      <div class="app-frame">
        <WortelApp client:load sidebar={true} initialTab="history" />
      </div>
    </div>
  </main>

  <!-- is:inline so it runs synchronously before first paint: it sets the window's
       centered position, and a deferred script would let the app paint top-left
       first and then visibly jump to centre on load. -->
  <script is:inline>
    // Snap the app box to whole 36px grid cells — but as explicit pixel values so
    // the CSS width/height transition has two real lengths to ease between. (A
    // pure-CSS `round(down, 100%, 36px)` snaps correctly but can't animate: its
    // computed value never changes, only the used/pixel value does at layout time,
    // and transitions only fire on computed-value changes.)
    const CELL = 36;
    const TITLEBAR = 51;  // the app's chrome strip — its drag handle
    // The cap is defined once, in global.css, and read back here — the stylesheet
    // needs it to paint the right size immediately, and this script needs it to
    // work out the leftover slack. Two copies would drift and reintroduce the
    // resize-on-load.
    const rootStyle = getComputedStyle(document.documentElement);
    const MAX_W = parseFloat(rootStyle.getPropertyValue('--app-max-w'));
    const MAX_H = parseFloat(rootStyle.getPropertyValue('--app-max-h'));

    const stage = document.querySelector('.stage');
    const frame = document.querySelector('.app-frame');
    const narrow = window.matchMedia('(max-width: 900px)');

    let slack = { x: 0, y: 0 };  // exact px the window may travel — the drag's bounds
    let range = { x: 0, y: 0 };  // the same, floored to whole cells — where it rests
    let pos = { x: 0, y: 0 };    // where it is, relative to its (432,36) anchor
    let dragged = false;         // until the user drags, the window stays centered
                                 // in the slack; after, it stays where they left it
    let settleTimer;

    const clamp = (v, max) => Math.min(Math.max(0, v), max);
    // max is always a multiple of CELL, so a rested window sits on a grid
    // intersection exactly like its anchor does.
    const toCell = (v, max) => clamp(Math.round(v / CELL) * CELL, max);

    const apply = () => {
      frame.style.transform = pos.x || pos.y ? `translate(${pos.x}px, ${pos.y}px)` : '';
    };

    // While dragging: follow the pointer to the exact pixel, no snapping.
    function drag(x, y) {
      pos = { x: clamp(x, slack.x), y: clamp(y, slack.y) };
      apply();
    }

    // On release: ease the last few px onto the nearest intersection. A timer
    // rather than transitionend, which never fires when the window is already
    // parked on the grid and the transform doesn't change.
    function rest(animate) {
      pos = { x: toCell(pos.x, range.x), y: toCell(pos.y, range.y) };
      frame.classList.toggle('settling', !!animate);
      apply();
      clearTimeout(settleTimer);
      if (animate) settleTimer = setTimeout(() => frame.classList.remove('settling'), 220);
    }

    function layout() {
      // Below the stacking breakpoint the desktop grid math doesn't apply — hand
      // sizing back to the stylesheet.
      if (narrow.matches) {
        frame.style.width = frame.style.height = frame.style.transform = '';
        slack = { x: 0, y: 0 };
        range = { x: 0, y: 0 };
        return;
      }
      const cs = getComputedStyle(stage);
      const availW = stage.clientWidth - parseFloat(cs.paddingLeft) - parseFloat(cs.paddingRight);
      const availH = stage.clientHeight - parseFloat(cs.paddingTop) - parseFloat(cs.paddingBottom);
      // cap at the reference window first, then snap down to whole cells
      const w = Math.max(CELL, Math.floor(Math.min(availW, MAX_W) / CELL) * CELL);
      const h = Math.max(CELL, Math.floor(Math.min(availH, MAX_H) / CELL) * CELL);
      frame.style.width = w + 'px';
      frame.style.height = h + 'px';
      // whatever slack the cap leaves behind is the room the window drags through
      slack = { x: Math.max(0, availW - w), y: Math.max(0, availH - h) };
      range = {
        x: Math.floor(slack.x / CELL) * CELL,
        y: Math.floor(slack.y / CELL) * CELL,
      };
      // Until the first drag, sit centered in the slack (rest() then snaps that to
      // the nearest cell). Afterwards honour where the user left it — rest() just
      // re-clamps in case the slack shrank out from under it.
      if (!dragged) pos = { x: slack.x / 2, y: slack.y / 2 };
      rest(false);
    }

    frame.addEventListener('pointerdown', (e) => {
      if (!range.x && !range.y) return;                  // nowhere to go
      // >= so the row at y=51 belongs to .git-grip's resize, not to the drag
      if (e.clientY - frame.getBoundingClientRect().top >= TITLEBAR) return;
      if (e.target.closest('button, a, input, [role="separator"]')) return;

      // a drag interrupting a settle must be instant again from the first frame
      clearTimeout(settleTimer);
      frame.classList.remove('settling');

      const grab = { x: e.clientX - pos.x, y: e.clientY - pos.y };
      // flip on the first actual move, not on click — a click that doesn't move
      // shouldn't pin the window and disable auto-centering
      const onMove = (ev) => { dragged = true; drag(ev.clientX - grab.x, ev.clientY - grab.y); };
      const stop = () => {
        rest(true);
        document.body.classList.remove('dragging-app');
        window.removeEventListener('pointermove', onMove);
        window.removeEventListener('pointerup', stop);
        window.removeEventListener('pointercancel', stop);
      };
      document.body.classList.add('dragging-app');
      window.addEventListener('pointermove', onMove);
      window.addEventListener('pointerup', stop);
      window.addEventListener('pointercancel', stop);
      e.preventDefault();  // no text selection while dragging
    });

    // Observe the stage rather than window so we react to its actual box changing.
    new ResizeObserver(layout).observe(stage);
    narrow.addEventListener('change', layout);
    layout();
  </script>
</Layout>
