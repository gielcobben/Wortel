#
# Enables integration between zsh and ghostty.
#
# This is an autoloadable function. It's invoked automatically in shells
# directly spawned by Ghostty but not in any other shells. For example, running
# `exec zsh`, `sudo -E zsh`, `tmux`, or plain `zsh` will create a shell where
# ghostty-integration won't automatically run. Zsh users who want integration with
# Ghostty in all shells should add the following lines to their .zshrc:
#
#   if [[ -n $GHOSTTY_RESOURCES_DIR ]]; then
#     source "$GHOSTTY_RESOURCES_DIR"/shell-integration/zsh/ghostty-integration
#   fi
#
# Implementation note: We can assume that alias expansion is disabled in this
# file, so no need to quote defensively. We still have to defensively prefix all
# builtins with `builtin` to avoid accidentally invoking user-defined functions.
# We avoid `function` reserved word as an additional defensive measure.

# Note that updating options with `builtin emulate -L zsh` affects the global options
# if it's called outside of a function. So nearly all code has to be in functions.
_entrypoint() {
    builtin emulate -L zsh -o no_warn_create_global -o no_aliases

    [[ -o interactive ]]              || builtin return 0  # non-interactive shell
    (( ! $+_ghostty_state ))          || builtin return 0  # already initialized

    # We require zsh 5.1+ (released Sept 2015) for features like functions_source,
    # introspection arrays, and array pattern substitution.
    if ! { builtin autoload -- is-at-least 2>/dev/null && is-at-least 5.1; }; then
        builtin echo "Zsh ${ZSH_VERSION} is too old for ghostty shell integration (5.1+ required)" >&2
        builtin return 1
    fi

    # 0: no OSC 133 [AC] marks have been written yet.
    # 1: the last written OSC 133 C has not been closed with D yet.
    # 2: none of the above.
    builtin typeset -gi _ghostty_state

    # Attempt to create a writable file descriptor to the TTY so that we can print
    # to the TTY later even when STDOUT is redirected. This code is fairly subtle.
    #
    # - It's tempting to do `[[ -t 1 ]] && exec {_ghostty_state}>&1` but we cannot do this
    #   because it'll create a file descriptor >= 10 without O_CLOEXEC. This file
    #   descriptor will leak to child processes.
    # - If we do `exec {3}>&1`, the file descriptor won't leak to the child processes
    #   but it'll still leak if the current process is replaced with another. In
    #   addition, it'll break user code that relies on fd 3 being available.
    # - Zsh doesn't expose dup3, which would have allowed us to copy STDOUT with
    #   O_CLOEXEC. The only way to create a file descriptor with O_CLOEXEC is via
    #   sysopen.
    # - `zmodload zsh/system` and `sysopen -o cloexec -wu _ghostty_fd -- /dev/tty` can
    #   fail with an error message to STDERR (the latter can happen even if /dev/tty
    #   is writable), hence the redirection of STDERR. We do it for the whole block
    #   for performance reasons (redirections are slow).
    # - We must open the file descriptor right here rather than in _ghostty_deferred_init
    #   because there are broken zsh plugins out there that run `exec {fd}< <(cmd)`
    #   and then close the file descriptor more than once while suppressing errors.
    #   This could end up closing our file descriptor if we opened it in
    #   _ghostty_deferred_init.
    typeset -gi _ghostty_fd
    {
        builtin zmodload zsh/system && (( $+builtins[sysopen] )) && {
            { [[ -w     $TTY ]] && builtin sysopen -o cloexec -wu _ghostty_fd --     $TTY } ||
            { [[ -w /dev/tty ]] && builtin sysopen -o cloexec -wu _ghostty_fd -- /dev/tty }
        }
    } 2>/dev/null || (( _ghostty_fd = 1 ))

    # Defer initialization so that other zsh init files can be configure
    # the integration.
    builtin typeset -ag precmd_functions
    precmd_functions+=(_ghostty_deferred_init)
}

_ghostty_deferred_init() {
    builtin emulate -L zsh -o no_warn_create_global -o no_aliases

    # Enable semantic markup with OSC 133.
    _ghostty_precmd() {
        builtin local -i cmd_status=$?
        builtin emulate -L zsh -o no_warn_create_global -o no_aliases

        # Don't write OSC 133 D when our precmd handler is invoked from zle.
        # Some plugins do that to update prompt on cd.
        if ! builtin zle; then
            # This code works incorrectly in the presence of a precmd or chpwd
            # hook that prints. For example, sindresorhus/pure prints an empty
            # line on precmd and marlonrichert/zsh-snap prints $PWD on chpwd.
            # We'll end up writing our OSC 133 D mark too late.
            #
            # Another failure mode is when the output of a command doesn't end
            # with LF and prompst_sp is set (it is by default). In this case
            # we'll incorrectly state that '%' from prompt_sp is a part of the
            # command's output.
            if (( _ghostty_state == 1 )); then
                # The last written OSC 133 C has not been closed with D yet.
                # Close it and supply status.
                builtin print -nu $_ghostty_fd '\e]133;D;'$cmd_status'\a'
                (( _ghostty_state = 2 ))
            elif (( _ghostty_state == 2 )); then
                # There might be an unclosed OSC 133 C. Close that.
                builtin print -nu $_ghostty_fd '\e]133;D\a'
            fi
        fi

        builtin local mark1=$'%{\e]133;A;cl=line\a%}'
        if [[ -o prompt_percent ]]; then
            builtin typeset -g precmd_functions
            if [[ ${precmd_functions[-1]} == _ghostty_precmd ]]; then
                # This is the best case for us: we can add our marks to PS1 and
                # PS2. This way our marks will be printed whenever zsh
                # redisplays prompt: on reset-prompt, on SIGWINCH, and on
                # SIGCHLD if notify is set. Themes that update prompt
                # asynchronously from a `zle -F` handler might still remove our
                # marks. Oh well.

                # Restore PS1/PS2 to their pre-mark state if nothing else has
                # modified them since we last added marks. This avoids exposing
                # PS1 with our marks to other hooks (which can break themes like
                # Pure that use pattern matching to strip/rebuild the prompt).
                # If PS1 was modified (by a theme, async update, etc.), we
                # keep the modified version, prioritizing the theme's changes.
                builtin local ps1_changed=0
                if [[ -n ${_ghostty_saved_ps1+x} ]]; then
                    if [[ $PS1 == $_ghostty_marked_ps1 ]]; then
                        PS1=$_ghostty_saved_ps1
                        PS2=$_ghostty_saved_ps2
                    elif [[ $PS1 != $_ghostty_saved_ps1 ]]; then
                        ps1_changed=1
                    fi
                fi

                # Save the clean PS1/PS2 before we add marks.
                _ghostty_saved_ps1=$PS1
                _ghostty_saved_ps2=$PS2

                # Add our marks. Since we always start from a clean PS1
                # (either restored above or freshly set by a theme), we can
                # unconditionally add mark1 and markB.
                builtin local mark2=$'%{\e]133;A;k=s\a%}'
                builtin local markB=$'%{\e]133;B\a%}'
                # If PS1 ends with a bare '%', it combines with the '{'
                # in markB to form a '%{' prompt escape, swallowing the
                # marker and producing a visible '{'. Fix by doubling the
                # trailing '%' so it becomes a literal '%%'. (Ghostty
                # 43f3dc5f1.)
                [[ $PS1 == *[^%]% || $PS1 == % ]] && PS1=$PS1%
                PS1=${mark1}${PS1}${markB}

                # Handle multiline prompts by marking newline-separated
                # continuation lines with k=s (mark2). We skip the newline
                # immediately after mark1 to avoid introducing a double
                # newline due to OSC 133;A's fresh-line behavior.
                #
                # We skip this when PS1 changed because injecting marks into
                # newlines can break pattern matching in themes that
                # strip/rebuild the prompt dynamically (e.g., Pure).
                if (( ! ps1_changed )) && [[ $PS1 == *$'\n'* ]]; then
                    if [[ $PS1 == ${mark1}$'\n'* ]]; then
                        builtin local rest=${PS1#${mark1}$'\n'}
                        if [[ $rest == *$'\n'* ]]; then
                            PS1=${mark1}$'\n'${rest//$'\n'/$'\n'${mark2}}
                        fi
                    else
                        PS1=${PS1//$'\n'/$'\n'${mark2}}
                    fi
                fi

                # PS2 mark is needed when clearing the prompt on resize
                [[ $PS2 == *[^%]% || $PS2 == % ]] && PS2=$PS2%
                PS2=${mark2}${PS2}${markB}

                # Save the marked PS1 so we can detect modifications
                # by other hooks in the next cycle.
                _ghostty_marked_ps1=$PS1
                (( _ghostty_state = 2 ))
            else
                # If our precmd hook is not the last, we cannot rely on prompt
                # changes to stick, so we don't even try. At least we can move
                # our hook to the end to have better luck next time. If there is
                # another piece of code that wants to take this privileged
                # position, this won't work well. We'll break them as much as
                # they are breaking us.
                precmd_functions=(${precmd_functions:#_ghostty_precmd} _ghostty_precmd)
                # Plugins that invoke precmd hooks from zle do that before zle
                # is trashed. This means that the cursor is in the middle of
                # BUFFER and we cannot print our mark there. Prompt might
                # already have a mark, so the following reset-prompt will write
                # it. If it doesn't, there is nothing we can do.
                if ! builtin zle; then
                    builtin print -rnu $_ghostty_fd -- $mark1[3,-3]
                    (( _ghostty_state = 2 ))
                fi
            fi
        elif ! builtin zle; then
            # Without prompt_percent we cannot patch prompt. Just print the
            # mark, except when we are invoked from zle. In the latter case we
            # cannot do anything.
            builtin print -rnu $_ghostty_fd -- $mark1[3,-3]
            (( _ghostty_state = 2 ))
        fi
    }

    # Wortel: walk to the program a simple command launches. Advances `i` (the
    # caller's index into its `words`, which this sees because zsh's scoping is
    # dynamic) past env assignments (FOO=bar), launchers (sudo, nohup, exec...)
    # and package runners (npx, `pnpm dlx`), stopping at `e`, the segment's last
    # word. REPLY is the program's word, or empty when the segment has none.
    _ghostty_wortel_program() {
        builtin emulate -L zsh -o no_warn_create_global -o no_aliases
        builtin local w
        REPLY=
        while (( i <= e )); do
            w=$words[i]
            case $w in
                *=*)                                              (( i++ )); continue ;;
                sudo|doas|command|builtin|exec|nohup|nice|stdbuf|setsid|env)
                                                                  (( i++ )); continue ;;
                npx|bunx|pnpx|uvx|pipx)                           (( i++ )); continue ;;
                npm|pnpm|yarn|bun|deno)
                    # Package runners: in `pnpm dlx codex` or `bun x pi` the
                    # program is the word after the subcommand. Only skip when
                    # the subcommand is actually there — a bare `bun` is a REPL,
                    # and it must keep reaching the dual-use check.
                    case $words[i+1] in
                        x|dlx|exec|run)                           (( i += 2 )); continue ;;
                    esac
                    REPLY=$w; return ;;
                -*)                                               (( i++ )); continue ;;
                *)                                                REPLY=$w; return ;;
            esac
        done
    }

    # Wortel: the agent a word names, in REPLY; false (and REPLY empty) when it
    # names none. Either the program itself or the package a runner fetches it
    # as: `npx @anthropic-ai/claude-code` is the documented way to run Claude
    # without installing it, and the app still has to know it is `claude` to
    # resume it (likewise `bunx @mariozechner/pi-coding-agent` is pi). Quotes
    # and a leading backslash (`\claude`, to skip an alias) are not part of the
    # name, and neither is a version pin (`opencode-ai@latest`).
    _ghostty_wortel_agent_name() {
        builtin emulate -L zsh -o no_warn_create_global -o no_aliases
        REPLY=${${(Q)1}:t}
        [[ $REPLY == ?*@* ]] && REPLY=${REPLY%%@*}
        case $REPLY in
            claude|pi|aider|codex|cursor-agent|gemini|opencode|goose|cline|ollama|llm|crush|amp) ;;
            claude-code)        REPLY=claude ;;
            pi-coding-agent)    REPLY=pi ;;
            gemini-cli)         REPLY=gemini ;;
            opencode-ai)        REPLY=opencode ;;
            aider-chat)         REPLY=aider ;;
            *)                  REPLY=; return 1 ;;
        esac
    }

    # Wortel: true if a REPL that is also a script runner (python, node...)
    # was started bare. `python script.py`, `node app.js`, `python -m mod` and
    # `-c ...` are batch jobs that should keep the spinner; arguments are the
    # words after the program.
    _ghostty_wortel_bare_repl() {
        builtin emulate -L zsh -o no_warn_create_global -o no_aliases
        builtin local a
        for a in "$@"; do
            case $a in
                -i|-q|-u|-B|-E|-O|-OO|-s|-S|-I|--) continue ;;
                -c|-m)             return 1 ;;
                *[\<\>\|\&\;]*)    return 0 ;;
                -*)                continue ;;
                *)                 return 1 ;;
            esac
        done
        return 0
    }

    # Wortel: true if the command line launches a long-lived interactive
    # program (agent CLI, editor, pager, REPL, system monitor, TUI) that sits
    # at its own prompt instead of returning to the shell. For those the
    # synthetic busy spinner (OSC 9;4;3 in preexec) would never clear until you
    # quit — no OSC 133;D fires — so we skip it and let the program drive its
    # own progress if it reports any. Batch commands (builds, tests) still spin.
    #
    # Every command on the line is looked at, not just the first: `cd x &&
    # claude` and `git diff | less` end in a program that holds the terminal,
    # and judged by their first word they spun for as long as it ran.
    _ghostty_wortel_interactive() {
        builtin emulate -L zsh -o no_warn_create_global -o no_aliases
        builtin local -a words
        words=(${(z)1})
        builtin local -i s=1 e i n=$#words
        builtin local cmd REPLY
        while (( s <= n )); do
            # The segment runs to the next word that starts another command
            # on the same line (`&&`, `;`, `|`, `&`...).
            for (( e = s; e <= n; e++ )); do
                case $words[e] in
                    ';'|'&&'|'||'|'|'|'|&'|'&'|'&|'|'&!') break ;;
                esac
            done
            (( i = s, s = e + 1, e-- ))
            _ghostty_wortel_program
            cmd=${${(Q)REPLY}:t}
            [[ -z $cmd ]] && continue
            case $cmd in
                claude|pi|aider|codex|cursor-agent|gemini|opencode|goose|cline|ollama|llm|crush|amp) return 0 ;;
                vi|vim|nvim|vis|nano|emacs|emacsclient|helix|hx|kak|micro|ne|joe) return 0 ;;
                less|more|most|moar|man|bat|w3m|lynx) return 0 ;;
                top|htop|btop|btm|glances|gtop|nvtop|s-tui) return 0 ;;
                ssh|mosh|et|autossh|telnet|tmux|screen|byobu|zellij|dtach|abduco) return 0 ;;
                watch|journalctl|dmesg) return 0 ;;
                fzf|sk|gitui|lazygit|lazydocker|k9s|tig|ranger|nnn|yazi|lf|vifm|mc|broot|xplr) return 0 ;;
                gdb|lldb|pdb) return 0 ;;
                psql|mysql|mariadb|sqlite3|litecli|pgcli|mycli|redis-cli|mongosh|mongo|usql|duckdb|clickhouse-client|cqlsh) return 0 ;;
                # A job brought back to the foreground is, nearly always, the
                # editor or agent that Ctrl-Z put there. Spinning for it spun
                # for the rest of that program's life.
                fg|%*) return 0 ;;
                python|python2|python3|ipython|bpython|ptpython|node|nodejs|bun|deno|irb|pry|php|lua|luajit|julia|R|ghci|iex|erl|scala|clj|clojure)
                    _ghostty_wortel_bare_repl ${words[i+1,e]} && return 0
                    continue ;;
            esac
            # The leading word is not a program we know. It may well be a
            # wrapper no list can ever enumerate — `devx pi`, a repo's own
            # `./run claude`, a company shim — so look just past it: if one of
            # the next couple of bare words names an agent, believe that over
            # the wrapper.
            #
            # Only two words, and flags skipped, to keep it from reading an
            # agent's name out of an unrelated argument. The asymmetry is
            # deliberate: a false positive costs a missing spinner on one
            # command, while a false negative leaves a spinner turning for the
            # entire session — which is the failure people actually report.
            # (Package names count too: `npx @anthropic-ai/claude-code` is
            # Claude, and that arrives here, with `npx` already walked past.)
            _ghostty_wortel_agent_name $REPLY && return 0
            _ghostty_wortel_wrapped_agent $cmd ${words[i+1,e]} && return 0
        done
        return 1
    }

    # Wortel: given the leading command and the words after it, set REPLY to
    # the agent it wraps and return true — else false. Shared by the
    # interactive check and the marker so a wrapper-launched agent is both
    # spinner-exempt and resumable.
    #
    # Guarded on both ends. Tools whose arguments are patterns or paths are
    # excluded outright, because `rg claude src` and `git log claude` are
    # ordinary commands that must keep their spinner, and no syntax
    # distinguishes a wrapper's subcommand from a search term. Past that, only
    # the first two bare words are read, so an agent's name buried deep in an
    # argument list is not mistaken for the program being launched.
    _ghostty_wortel_wrapped_agent() {
        builtin emulate -L zsh -o no_warn_create_global -o no_aliases
        builtin local lead=${${(Q)1}:t} w
        builtin shift
        REPLY=
        case $lead in
            git|hg|svn|jj|grep|rg|ag|ack|fd|find|ls|cat|sed|awk|jq|yq|xargs|echo|printf) return 1 ;;
            cp|mv|rm|ln|mkdir|touch|tar|zip|unzip|open|chmod|chown|stat|file|du|df) return 1 ;;
            curl|wget|scp|rsync|diff|patch|wc|sort|uniq|head|tail|tr|cut|comm|tee) return 1 ;;
            make|cargo|go|rustc|swift|swiftc|xcodebuild|gradle|mvn|pip|pip3|brew) return 1 ;;
            which|type|whereis|whatis|history|kill|pkill|pgrep|ps|test) return 1 ;;
            # Somewhere else entirely: another machine, a multiplexer's own
            # server, a container. `ssh box claude`, `tmux new claude` and
            # `docker exec -it c claude` were recorded as a claude running
            # *here*, so a relaunch typed `claude --resume` into the local
            # shell — and for tmux, whose server outlives the session, a
            # second copy beside the one still running in it. (These are
            # interactive for the spinner by name, before this is asked.)
            ssh|mosh|et|autossh|telnet|tmux|screen|byobu|zellij|dtach|abduco) return 1 ;;
            docker|podman|nerdctl|kubectl|oc|limactl|lima|multipass|vagrant|distrobox|toolbox|devcontainer|orb|orbctl) return 1 ;;
        esac
        builtin local -i looked=0
        for w in "$@"; do
            case $w in
                -*|*=*) continue ;;
            esac
            (( looked++ ))
            _ghostty_wortel_agent_name $w && return 0
            (( looked >= 2 )) && break
        done
        return 1
    }

    # Wortel: if the command line launches an agent CLI, set `reply` to
    # (agent model cwd argv) for the marker; else leave it empty. Recorded per
    # session (keyed by WORTEL_SESSION_ID) so a relaunch can resume the agent.
    #
    # `cd ~/proj && claude` launches the agent somewhere other than $PWD,
    # which is where it is resumed (and where Claude keeps its transcripts),
    # so the walk follows leading `cd`s it can resolve without running
    # anything — `-`, `~`, absolute and relative paths — to a directory that
    # exists. Anything it can't see the end of (a dirstack entry, CDPATH, a
    # failed cd, `z proj`) records nothing rather than the wrong directory.
    # Otherwise only the line's first command is considered, as before.
    _ghostty_wortel_agent() {
        builtin emulate -L zsh -o no_warn_create_global -o no_aliases
        reply=()
        builtin local -a words args
        words=(${(z)1})
        builtin local -i s=1 e i k sep n=$#words
        builtin local cwd=$PWD dir model= REPLY
        while (( s <= n )); do
            # The segment runs to the next word that starts another command
            # on the same line (`&&`, `;`, `|`, `&`...).
            for (( e = s; e <= n; e++ )); do
                case $words[e] in
                    ';'|'&&'|'||'|'|'|'|&'|'&'|'&|'|'&!') break ;;
                esac
            done
            (( i = s, sep = e, e-- ))
            _ghostty_wortel_program
            case ${(Q)REPLY} in
                cd|pushd) ;;
                *) break ;;
            esac
            # Only `cd x && …` and `cd x; …`: after `||` or `|` the next
            # command may run in a directory the cd never reached.
            case $words[sep] in
                ';'|'&&') ;;
                *) return ;;
            esac
            args=("${(@Q)words[i+1,e]}")
            [[ $args[1] == (-L|-P|-q|--) ]] && builtin shift args
            (( $#args <= 1 )) || return
            dir=${args[1]-}
            case $dir in
                '')         dir=$HOME ;;
                -)          dir=$OLDPWD ;;
                '~')        dir=$HOME ;;
                '~/'*)      dir=$HOME/${dir#'~/'} ;;
                [-+~]*)     return ;;
                /*)         ;;
                *)          [[ -n $CDPATH && $dir != (.|..)(|/*) ]] && return
                            dir=$cwd/$dir ;;
            esac
            dir=${dir:a}
            [[ -n $dir && -d $dir ]] || return
            cwd=$dir
            (( s = sep + 1 ))
        done
        (( s <= n )) || return
        builtin local program=$REPLY
        if ! _ghostty_wortel_agent_name "$program"; then
            # Wrapper form (`devx pi`): record the agent, not the wrapper, so
            # the session is resumable and the app knows which agent is running.
            _ghostty_wortel_wrapped_agent "$program" ${words[i+1,e]} || return
        fi
        # The model the command selects (--model/-m/--models value), if any.
        # Best-effort, for the sidebar badge and to record what an agent was
        # using.
        args=("${(@Q)words[i+1,e]}")
        for (( k = 1; k <= $#args; k++ )); do
            case $args[k] in
                --model=*|--models=*|-m=*)  model=${args[k]#*=}; break ;;
                --model|--models|-m)        model=${args[k+1]-}; break ;;
            esac
        done
        # The command from the agent on (the whole line, unless a cd chain was
        # walked past), one line: the resume fallback for agents with no
        # "continue last" of their own. Rebuilt from the words, since zsh hands
        # preexec the expanded text with each `;` turned into a newline.
        reply=($REPLY "$model" "$cwd" "${${(j: :)words[s,n]}//$'\n'/ }")
    }

    # Wortel: directory shared with the app (AgentResumeStore) for agent markers.
    _ghostty_wortel_agent_dir="${WORTEL_DATA_DIR:-$HOME/Library/Application Support/Wortel}/agents"
    # For the marker's start time and the exit log, without forking `date`.
    builtin zmodload -F zsh/datetime p:EPOCHSECONDS 2>/dev/null
    # "<pid> <agent> <startedat>" of an agent Ctrl-Z stopped, while it lives.
    # See _ghostty_wortel_clear_agent.
    builtin typeset -g _ghostty_wortel_stopped=

    # Wortel: clear this session's agent marker. Runs at every prompt (registered
    # into precmd below), so a marker only survives while an agent is actually
    # running — which is precisely when no prompt fires.
    #
    # And log the exit first. A marker here means the command that just ended
    # was an agent, and the status precmd hands in as `$1` is the only trace of
    # *why* it ended once the scrollback is gone: 129 and up is a signal (129
    # SIGHUP, 130 SIGINT, 143 SIGTERM), anything else the agent's own choice.
    # On 2026-10-07 nine agents exited within a minute of a relaunch and nothing
    # on the machine could say how. One line, appended on this path only; a
    # plain prompt does nothing beyond the stat it always did.
    #
    # **Only a marker this shell wrote.** The file is keyed by session, and a
    # session can briefly have two shells: the one a relaunch forked and the
    # old one still dying after its keeper went away. The dying shell's last
    # prompt deleted the new shell's marker, and the new shell's first prompt
    # logged the dead one's agent as an exit that never happened. So: our own
    # marker is cleared and logged; a dead shell's is cleared quietly; a live
    # other shell's is left alone.
    #
    # **Not an agent that was only stopped.** Ctrl-Z returns to a prompt with
    # the agent still alive as a suspended job (status 128+SIGTSTP, 146 here),
    # and `fg` launches no agent, so clearing the marker then left the agent
    # untracked for the rest of its life: no badge, and nothing to resume. So
    # a stop keeps the marker and remembers the job's pid (and which marker it
    # belongs to), and every prompt after that keeps it for as long as that
    # process lives — through `fg`, `bg` and stopping again. Its real exit is
    # logged at the first prompt after it, as any other.
    _ghostty_wortel_clear_agent() {
        builtin emulate -L zsh -o no_warn_create_global -o no_aliases
        [[ -n $WORTEL_SESSION_ID ]] || return
        builtin local marker="$_ghostty_wortel_agent_dir/$WORTEL_SESSION_ID"
        if [[ ! -f $marker ]]; then
            _ghostty_wortel_stopped=
            return
        fi
        builtin local line agent= owner= started= job state
        while IFS= builtin read -r line; do
            case $line in
                agent=*)     agent=${line#agent=} ;;
                shellpid=*)  owner=${line#shellpid=} ;;
                startedat=*) started=${line#startedat=} ;;
            esac
        done < "$marker" 2>/dev/null
        if [[ -n $owner && $owner != $$ ]]; then
            builtin kill -0 $owner 2>/dev/null && return
            command rm -f "$marker" 2>/dev/null
            return
        fi
        if [[ -n $_ghostty_wortel_stopped &&
              ${_ghostty_wortel_stopped#* } == "$agent $started" ]] &&
           builtin kill -0 ${_ghostty_wortel_stopped%% *} 2>/dev/null; then
            return
        fi
        case $1 in
            14[5-9]|150)
                # SIGSTOP, SIGTSTP, SIGTTIN, SIGTTOU (macOS numbers 17, 18,
                # 21, 22; 19 and 20 are Linux's). The status alone could be an
                # exit code, so it also takes the current job being suspended,
                # which is where a stop leaves the command it stopped.
                for job state in "${(@kv)jobstates}"; do
                    [[ $state == suspended:+:* ]] || continue
                    _ghostty_wortel_stopped="${${state#suspended:+:}%%=*} $agent $started"
                    # Nothing is in progress while it is stopped, but the app
                    # ignores the prompt's 133;D while a marker is live (see
                    # docs/agent-signals.md), so a turn stopped halfway would
                    # keep its spinner for as long as it stays stopped.
                    builtin print -nu $_ghostty_fd '\e]9;4;0\a'
                    return
                done ;;
        esac
        _ghostty_wortel_stopped=
        builtin print -r -- "${EPOCHSECONDS:-$(command date +%s)} session=$WORTEL_SESSION_ID agent=$agent status=${1:-?} shellpid=$$" \
            >> "$_ghostty_wortel_agent_dir/exits.log" 2>/dev/null
        command rm -f "$marker" 2>/dev/null
    }

    _ghostty_preexec() {
        builtin emulate -L zsh -o no_warn_create_global -o no_aliases

        # Restore the original PS1/PS2 if nothing else has modified them
        # since our precmd added marks. This ensures other preexec hooks
        # see a clean PS1 without our marks. If PS1 was modified (e.g.,
        # by an async theme update), we leave it alone.
        if [[ -n ${_ghostty_saved_ps1+x} && $PS1 == $_ghostty_marked_ps1 ]]; then
            PS1=$_ghostty_saved_ps1
            PS2=$_ghostty_saved_ps2
        fi

        # This will work incorrectly in the presence of a preexec hook that
        # prints. For example, if MichaelAquilina/zsh-you-should-use installs
        # its preexec hook before us, we'll incorrectly mark its output as
        # belonging to the command (as if the user typed it into zle) rather
        # than command output.
        builtin print -nu $_ghostty_fd '\e]133;C\a'
        # Wortel: mark the session busy for the sidebar spinner. OSC 9;4;3 is
        # ConEmu's "indeterminate progress"; Ghostty forwards it as a progress
        # report. It clears automatically at the next prompt (OSC 133;D) — but
        # long-lived interactive programs never return to the prompt, so for
        # those we skip it (see _ghostty_wortel_interactive) to avoid a spinner
        # that spins for the whole session.
        #
        # Both checks read `$3`, the text that actually runs, not `$1`, the
        # line as typed: with `alias cc='claude --dangerously-skip-permissions'`
        # the typed line is `cc`, which names no agent, so the agent got no
        # marker and spun the spinner for as long as it ran. `$3` also carries
        # the alias's flags into argv, which is what a resume is rebuilt from.
        if ! _ghostty_wortel_interactive "${3:-$1}"; then
            builtin print -nu $_ghostty_fd '\e]9;4;3;\a'
        fi
        # Wortel: record a launched agent CLI so a relaunch can resume it. Keyed
        # by the surface's session id; cleared at the next prompt. A marker that
        # outlives the app means the agent was still running at quit.
        if [[ -n $WORTEL_SESSION_ID ]]; then
            # REPLY/reply are the detection's out-parameters (not a `$(...)`,
            # which forked a subshell for every command anyone typed).
            builtin local REPLY
            builtin local -a reply
            _ghostty_wortel_agent "${3:-$1}"
            if (( $#reply )); then
                builtin local dir=$_ghostty_wortel_agent_dir
                builtin local tmp="$dir/.$WORTEL_SESSION_ID.$$"
                [[ -d $dir ]] || command mkdir -p "$dir" 2>/dev/null
                # key=value marker read by AgentResumeStore: the agent, the model
                # it was launched with (if any), the cwd (to resume the right
                # project), and the command (one line) as a resume fallback.
                {
                    builtin print -r -- "agent=$reply[1]"
                    builtin print -r -- "model=$reply[2]"
                    builtin print -r -- "cwd=${reply[3]//[[:cntrl:]]/}"
                    builtin print -r -- "argv=$reply[4]"
                    # The shell's own pid. The agent runs as a descendant of it,
                    # so the app can ask the process table whether it is *really*
                    # still running rather than trusting this file to be current.
                    builtin print -r -- "shellpid=$$"
                    # When the agent started, so the app can tell which transcript
                    # the agent created (and so which conversation it is in).
                    builtin print -r -- "startedat=${EPOCHSECONDS:-$(command date +%s)}"
                } > "$tmp" 2>/dev/null &&
                # Renamed into place whole. The app watches the folder, which
                # fires once, when the name appears; written in place, it read
                # the marker after its first line and never again, so it knew
                # the agent but not its command, start or shell, and could not
                # tell which conversation it was in. A write or rename that
                # fails takes its dot-file with it: nothing else would.
                command mv -f "$tmp" "$dir/$WORTEL_SESSION_ID" 2>/dev/null ||
                    command rm -f "$tmp" 2>/dev/null
            fi
        fi
        (( _ghostty_state = 1 ))
    }

    # Enable reporting current working dir to terminal. Ghostty supports
    # the kitty-shell-cwd format.
    # Wortel: "localhost", not "$HOST". libghostty accepts an OSC 7 only when
    # its host is "localhost" or an exact gethostname() match — anything else,
    # including a missing host, is treated as a remote path and dropped ("OSC 7
    # uri must contain a hostname" / "OSC 7 host () must be local"). $HOST
    # breaks that two ways:
    # it's just a parameter, so an environment that clears it (shadowenv does)
    # emits a hostless URI; and it's captured at shell start, so it goes stale
    # the moment macOS renames the machine mid-session — routine on a network
    # where mDNS hands you the "-2" suffix after a name collision. The shell
    # this script runs in is always local, so localhost is true by construction
    # and immune to both. A remote shell over ssh reports its own hostname and
    # is still correctly rejected: that integration is the remote host's copy,
    # not this one.
    #
    # The directory name comes from the filesystem, so it is untrusted text
    # (Ghostty 6eb24a0f0). Plain `print` expands backslash escapes in every
    # argument, $PWD included, so a directory named 'x\a\e]52;c;SGVsbG8=\a'
    # ended this OSC 7 early and wrote "Hello" to the clipboard with OSC 52; a
    # raw ESC or BEL byte in the name did the same. So `print -r` (a backslash
    # in the path stays a backslash), the framing ESC and BEL written with
    # $'...', and ${PWD//[[:cntrl:]]} to drop raw control bytes from the name.
    _ghostty_report_pwd() {
      builtin print -rnu $_ghostty_fd -- \
        $'\e]7;kitty-shell-cwd://localhost'"${PWD//[[:cntrl:]]}"$'\a'
    }
    chpwd_functions=(${chpwd_functions[@]} "_ghostty_report_pwd")
    # An executed program could change cwd and report the changed cwd, so also report cwd at each new prompt
    # as in this case chpwd_functions is insufficient. chpwd_functions is still needed for things like: cd x && something
    functions[_ghostty_precmd]+="
        _ghostty_report_pwd"
    _ghostty_report_pwd
    # Wortel: clear the agent marker at every prompt (see _ghostty_wortel_clear_agent).
    # `$cmd_status` is precmd's own local, the status of the command that just
    # ended; single-quoted so it is read then, not now.
    functions[_ghostty_precmd]+='
        _ghostty_wortel_clear_agent $cmd_status'

    if [[ "$GHOSTTY_SHELL_FEATURES" == *"title"* ]]; then
      # Enable terminal title changes, formatted for user-friendly display.
      # The command's title is cut to 200 characters: libghostty drops an OSC
      # longer than 2048 bytes whole, so a pasted heredoc or a long
      # `claude "<prompt>"` would otherwise leave the old title standing.
      functions[_ghostty_precmd]+="
          builtin print -rnu $_ghostty_fd \$'\\e]2;'\"\${(%):-%(4~|…/%3~|%~)}\"\$'\\a'"
      functions[_ghostty_preexec]+="
          builtin print -rnu $_ghostty_fd \$'\\e]2;'\"\${\${1//[[:cntrl:]]}[1,200]}\"\$'\\a'"
    fi

    if [[ "$GHOSTTY_SHELL_FEATURES" == *"cursor"* ]]; then
      # Enable cursor shape changes depending on the current keymap.
      # This implementation leaks blinking block cursor into external commands
      # executed from zle. For example, users of fzf-based widgets may find
      # themselves with a blinking block cursor within fzf.
      _ghostty_zle_line_init _ghostty_zle_line_finish _ghostty_zle_keymap_select() {
        builtin local steady=0
        [[ "$GHOSTTY_SHELL_FEATURES" == *"cursor:steady"* ]] && steady=1
        case ${KEYMAP-} in
            vicmd|visual) builtin print -nu "$_ghostty_fd" "\e[$(( 1 + steady )) q" ;; # block
            *)            builtin print -nu "$_ghostty_fd" "\e[$(( 5 + steady )) q" ;; # bar
        esac
      }
      # Restore the default shape before executing an external command
      functions[_ghostty_preexec]+="
	  builtin print -rnu $_ghostty_fd \$'\\e[0 q'"
    fi

    # Emit semantic prompt markers at line-init if PS1 doesn't contain our
    # marks. This ensures the terminal sees prompt markers even if another
    # plugin (like zinit or oh-my-posh) regenerated PS1 after our precmd ran.
    # We use 133;P instead of 133;A to avoid fresh-line behavior which would
    # disrupt the display since the prompt has already been drawn. We also
    # emit 133;B to mark the input area, which is needed for click-to-move.
    (( $+functions[_ghostty_zle_line_init] )) || _ghostty_zle_line_init() { builtin true; }
    functions[_ghostty_zle_line_init]="
        if [[ \$PS1 != *$'%{\\e]133;A'* ]]; then
            builtin print -nu \$_ghostty_fd '\\e]133;P;k=i\\a\\e]133;B\\a'
        fi
    "${functions[_ghostty_zle_line_init]}

    # WORTEL: put the bundled `wortel` command on PATH.
    #
    # This replaces upstream's block, which appended $GHOSTTY_BIN_DIR —
    # Contents/MacOS — so its own `ghostty` command would work. Wortel ships no
    # binary there. The only thing that directory holds is the app's own
    # executable, named `Wortel`, and the disk is case-insensitive: `wortel`
    # matched it, so typing our command launched a SECOND COPY OF THE APP,
    # which then failed to bind the CLI socket the first copy was holding.
    #
    # Turning it off in wortel.conf does not work, which is why the block is
    # deleted rather than disabled: the guard is `== *"path"*`, and a feature
    # list containing `no-path` matches that just as happily as one containing
    # `path`. (So does `no-cursor` against `*"cursor"*`. Worth knowing before
    # trusting any negation here.)
    #
    # Prepended, not appended: the command that ships with *this* app is the one
    # that speaks this app's protocol, and it should win over an older copy
    # someone symlinked onto their PATH. WORTEL_BIN_DIR is exported per surface
    # by GhosttyRuntime — a variable of our own rather than an override of PATH,
    # because libghostty's env_vars can only add.
    if [[ -n "$WORTEL_BIN_DIR" ]] && [[ ":$PATH:" != *":$WORTEL_BIN_DIR:"* ]]; then
      builtin export PATH="$WORTEL_BIN_DIR:$PATH"
    fi

    # And take Contents/MacOS back off, because the core puts it there whatever
    # the `path` feature says — verified from inside a session: the feature list
    # arrives as "ssh-env,ssh-terminfo,title" and the directory is on PATH
    # anyway.
    #
    # Nothing in it is meant to be run by name. The only file is the app's own
    # executable, `Wortel`, which a case-insensitive disk hands over for
    # `wortel` — so leaving it means any accident of ordering launches a SECOND
    # COPY OF THE APP rather than failing cleanly. Being first is not a strong
    # enough guarantee for a failure that severe.
    if [[ -n "$GHOSTTY_BIN_DIR" ]]; then
      PATH=":$PATH:"
      PATH="${PATH//:$GHOSTTY_BIN_DIR:/:}"
      PATH="${PATH#:}"
      PATH="${PATH%:}"
      builtin export PATH
    fi

    # Sudo
    if [[ "$GHOSTTY_SHELL_FEATURES" == *"sudo"* ]] && [[ -n "$TERMINFO" ]]; then
      # Wrap `sudo` command to ensure Ghostty terminfo is preserved
      function sudo() {
        builtin local sudo_has_sudoedit_flags="no"
        for arg in "$@"; do
          # Check if argument is '-e' or '--edit' (sudoedit flags)
          if [[ "$arg" == "-e" || $arg == "--edit" ]]; then
            sudo_has_sudoedit_flags="yes"
            builtin break
          fi
          # Check if argument is neither an option nor a key-value pair
          if [[ "$arg" != -* && "$arg" != *=* ]]; then
            builtin break
          fi
        done
        if [[ "$sudo_has_sudoedit_flags" == "yes" ]]; then
          builtin command sudo "$@";
        else
          builtin command sudo --preserve-env=TERMINFO "$@";
        fi
      }
    fi

    # SSH Integration
    if [[ "$GHOSTTY_SHELL_FEATURES" == *ssh-* ]]; then
      function ssh() {
        emulate -L zsh
        setopt local_options no_glob_subst

        local ssh_term ssh_opts
        ssh_term="xterm-256color"
        ssh_opts=()

        # Configure environment variables for remote session
        if [[ "$GHOSTTY_SHELL_FEATURES" == *ssh-env* ]]; then
          # SendEnv, not `SetEnv COLORTERM=truecolor`: a SetEnv given with -o
          # replaces every SetEnv in the user's own ~/.ssh/config (ssh takes the
          # first value of an option). COLORTERM is set on the ssh command at
          # the bottom instead. (Ghostty 69554f414.)
          ssh_opts+=(-o "SendEnv COLORTERM TERM_PROGRAM TERM_PROGRAM_VERSION")
        fi

        # Install terminfo on remote host if needed
        if [[ "$GHOSTTY_SHELL_FEATURES" == *ssh-terminfo* ]]; then
          local ssh_user ssh_hostname

          while IFS=' ' read -r ssh_key ssh_value; do
            case "$ssh_key" in
              user) ssh_user="$ssh_value" ;;
              hostname) ssh_hostname="$ssh_value" ;;
            esac
            [[ -n "$ssh_user" && -n "$ssh_hostname" ]] && break
          done < <(command ssh -G "$@" 2>/dev/null)

          if [[ -n "$ssh_hostname" ]]; then
            local ssh_target="${ssh_user}@${ssh_hostname}"

            # Check if terminfo is already cached
            if "$GHOSTTY_BIN_DIR/ghostty" +ssh-cache --host="$ssh_target" >/dev/null 2>&1; then
              ssh_term="xterm-ghostty"
            elif (( $+commands[infocmp] )); then
              local ssh_terminfo ssh_cpath_dir ssh_cpath

              ssh_terminfo=$(infocmp -0 -x xterm-ghostty 2>/dev/null)

              if [[ -n "$ssh_terminfo" ]]; then
                print -r -- "Setting up xterm-ghostty terminfo on $ssh_hostname..." >&2

                ssh_cpath_dir=$(mktemp -d "/tmp/ghostty-ssh-$ssh_user.XXXXXX" 2>/dev/null) || ssh_cpath_dir="/tmp/ghostty-ssh-$ssh_user.$$"
                ssh_cpath="$ssh_cpath_dir/socket"

                # Wortel: install first, then accept an entry already there
                # only when this host has no tic. Upstream's script stopped at
                # any existing xterm-ghostty, so a host set up by an older
                # release never got a newer entry, even once the cache had let
                # go of it (see Resources/ghostty/bin/ghostty). Into
                # ~/.terminfo always, so root never overwrites the system's.
                if builtin print -r "$ssh_terminfo" | command ssh "${ssh_opts[@]}" -o ControlMaster=yes -o ControlPath="$ssh_cpath" -o ControlPersist=60s "$@" '
                  command -v tic >/dev/null 2>&1 && mkdir -p ~/.terminfo 2>/dev/null && tic -x -o ~/.terminfo - 2>/dev/null && exit 0
                  infocmp xterm-ghostty >/dev/null 2>&1 && exit 0
                  exit 1
                ' 2>/dev/null; then
                  ssh_term="xterm-ghostty"
                  ssh_opts+=(-o "ControlPath=$ssh_cpath")

                  # Cache successful installation
                  "$GHOSTTY_BIN_DIR/ghostty" +ssh-cache --add="$ssh_target" >/dev/null 2>&1 || true
                else
                  print "Warning: Failed to install terminfo." >&2
                fi
              else
                print "Warning: Could not generate terminfo data." >&2
              fi
            else
              print "Warning: ghostty command not available for cache management." >&2
            fi
          fi
        fi

        # Execute SSH with TERM environment variable
        TERM="$ssh_term" COLORTERM=truecolor command ssh "${ssh_opts[@]}" "$@"
      }
    fi

    # Some zsh users manually run `source ~/.zshrc` in order to apply rc file
    # changes to the current shell. This is a terrible practice that breaks many
    # things, including our shell integration. For example, Oh My Zsh and Prezto
    # (both very popular among zsh users) will remove zle-line-init and
    # zle-line-finish hooks if .zshrc is manually sourced. Prezto will also remove
    # zle-keymap-select.
    #
    # Another common (and much more robust) way to apply rc file changes to the
    # current shell is `exec zsh`. This will remove our integration from the shell
    # unless it's explicitly invoked from .zshrc. This is not an issue with
    # `exec zsh` but rather with our implementation of automatic shell integration.

    # In the ideal world we would use add-zle-hook-widget to hook zle-line-init
    # and similar widget. This breaks user configs though, so we have do this
    # horrible thing instead.
    builtin local hook func widget orig_widget flag
    for hook in line-init line-finish keymap-select; do
        func=_ghostty_zle_${hook/-/_}
        (( $+functions[$func] )) || builtin continue
        widget=zle-$hook
        if [[ $widgets[$widget] == user:azhw:* &&
              $+functions[add-zle-hook-widget] -eq 1 ]]; then
            # If the widget is already hooked by add-zle-hook-widget at the top
            # level, add our hook at the end. We MUST do it this way. We cannot
            # just wrap the widget ourselves in this case because it would
            # trigger bugs in add-zle-hook-widget.
            add-zle-hook-widget $hook $func
        else
            if (( $+widgets[$widget] )); then
                # There is a widget but it's not from add-zle-hook-widget. We
                # can rename the original widget, install our own and invoke
                # the original when we are called.
                #
                # Note: The leading dot is to work around bugs in
                # zsh-syntax-highlighting.
                orig_widget=._ghostty_orig_$widget
                builtin zle -A $widget $orig_widget
                if [[ $widgets[$widget] == user:* ]]; then
                    # No -w here to preserve $WIDGET within the original widget.
                    flag=
                else
                    flag=w
                fi
                functions[$func]+="
                    builtin zle $orig_widget -N$flag -- \"\$@\""
            fi
            builtin zle -N $widget $func
        fi
    done

    if (( $+functions[_ghostty_preexec] )); then
        builtin typeset -ag preexec_functions
        preexec_functions+=(_ghostty_preexec)
    fi

    builtin typeset -ag precmd_functions
    if (( $+functions[_ghostty_precmd] )); then
        precmd_functions=(${precmd_functions:#_ghostty_deferred_init} _ghostty_precmd)
        _ghostty_precmd
    else
        precmd_functions=(${precmd_functions:#_ghostty_deferred_init})
    fi

    # Unfunction _ghostty_deferred_init to save memory. Don't unfunction
    # ghostty-integration though because decent public functions aren't supposed to
    # to unfunction themselves when invoked. Unfunctioning is done by calling code.
    builtin unfunction _ghostty_deferred_init
}

_entrypoint
