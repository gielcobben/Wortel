---
// A stage: a part of the foggy lake with the controls on top (the chapter
// tabs, and play/pause beside them) and the window under them.
// scripts/film.ts drives it. The words about it are the section's
// (Section.astro), and stay as they are whatever chapter plays.
interface Props {
  /** The scene's name: scripts find the scene by [data-film="name"]. */
  film?: string;
  /** The chapters' names, as the tabs show them. */
  chapters?: string[];
  /** Which photo (a file in public/img, lake by default), which part of it
      (a background-position), and how far in. */
  photo?: string;
  at?: string;
  zoom?: string;
  /** In the first screen: its photo comes with the page, not when it nears. */
  eager?: boolean;
  /** The window's size, in the app's own points. */
  w?: number;
  h?: number;
  /** Come in the first time it is on screen; 'manual' leaves the moment to a
      script, which adds .in itself (the hero, in its own sequence). */
  reveal?: boolean | 'manual';
  class?: string;
}
const { film, chapters = [], photo = 'lake', at = '50% 62%', zoom = 'cover', w = 1104, h = 704, reveal = true, eager = false, class: cls } = Astro.props;
---
<div data-film={film}>
  <div class:list={['stage', cls]} data-photo={eager ? undefined : ''} data-reveal={reveal === true ? '' : reveal || undefined} style={`--photo:url(/img/${photo}.jpg);--photo-s:url(/img/${photo}-1600.webp);--at:${at};--zoom:${zoom};--w:${w}px;--h:${h}px`}>
    {chapters.length > 0 && (
      <div class="controls">
        <div class="chapters glass" role="tablist" aria-label="Chapters">
          <span class="thumb still" aria-hidden="true">{chapters.map((c) => <span>{c}</span>)}</span>
          {chapters.map((c, i) => (
            <button type="button" role="tab" data-chapter={i} aria-selected={i === 0 ? 'true' : 'false'} tabindex={i === 0 ? 0 : -1}>{c}</button>
          ))}
        </div>
        <button type="button" class="play glass" data-play aria-label="Pause" aria-pressed="false">
          <svg class="i-pause" width="12" height="14" viewBox="0 0 12 14" aria-hidden="true"><rect x="1" y="1" width="3.5" height="12" rx="1" fill="currentColor"/><rect x="7.5" y="1" width="3.5" height="12" rx="1" fill="currentColor"/></svg>
          <svg class="i-play" width="12" height="14" viewBox="0 0 12 14" aria-hidden="true"><path d="M2.5 1.6v10.8a.6.6 0 0 0 .9.5l8.4-5.4a.6.6 0 0 0 0-1L3.4 1.1a.6.6 0 0 0-.9.5z" fill="currentColor"/></svg>
        </button>
      </div>
    )}
    <div class="set"><slot /></div>
  </div>
</div>
