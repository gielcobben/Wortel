---
// At a glance and the questions, in the one text column the site uses for
// anything read rather than looked at.
import { SPECS, FAQ } from '../../data/site';
---
<section class="section" id="faq">
  <span id="specs" class="anchor"></span>
  <div class="column">
    <div class="head" data-reveal-group>
      <h2 class="h2" data-reveal>Questions.</h2>
    </div>
    <dl class="specs">
      {SPECS.map(([k, v]) => (
        <div class="row"><dt>{k}</dt><dd>{v}</dd></div>
      ))}
    </dl>
    <div class="list">
      {FAQ.map((f) => (
        <details>
          <summary><span>{f.q}</span><i aria-hidden="true"></i></summary>
          <p class="body">{f.a}</p>
        </details>
      ))}
    </div>
  </div>
</section>

<style>
  .specs { margin: 0 0 64px; }
  .row { display: grid; grid-template-columns: 160px 1fr; gap: 24px; padding-block: 12px; border-top: 1px solid var(--line); }
  .row:last-child { border-bottom: 1px solid var(--line); }
  dt { font-size: 15px; line-height: 24px; color: var(--ink-3); }
  dd { margin: 0; font-size: 15px; line-height: 24px; color: var(--ink); }
  @media (max-width: 640px) { .row { grid-template-columns: 1fr; gap: 0; } }

  .list { display: flex; flex-direction: column; }
  details { border-top: 1px solid var(--line); }
  details:last-child { border-bottom: 1px solid var(--line); }
  summary {
    list-style: none; cursor: pointer; display: flex; justify-content: space-between; align-items: center; gap: 24px;
    padding-block: 20px; font-size: 16px; line-height: 24px; font-weight: 500; color: var(--ink);
  }
  summary::-webkit-details-marker { display: none; }
  summary i { position: relative; width: 12px; height: 12px; flex: none; }
  summary i::before, summary i::after { content: ''; position: absolute; left: 0; top: 5px; width: 12px; height: 1.5px; background: var(--ink-3); border-radius: 1px; transition: transform 0.3s var(--ease-out); }
  summary i::after { transform: rotate(90deg); }
  details[open] summary i::after { transform: rotate(0); }
  details .body { margin: 0 0 24px; }
</style>
