---
import { SPECS, FAQ } from '../../data/site';
---
<section class="engine section" id="specs">
  <div class="page">
    <div class="split" data-reveal-group>
      <div class="k"><p class="eyebrow" data-reveal>Under the surface</p></div>
      <div class="v">
        <h2 class="h2" data-reveal>Ghostty’s engine,<br /><span class="tone">exactly as it ships.</span></h2>
        <p class="body" data-reveal>
          Wortel embeds libghostty, so the VT parser, the Metal renderer and the glyph atlas are upstream’s, unmodified. Terminal behaviour, throughput and latency are Ghostty’s. Wortel’s own code is the window around them.
        </p>
      </div>
    </div>
    <dl class="specs" data-reveal-group="0.04">
      {SPECS.map(([k, v]) => (
        <div class="row" data-reveal><dt>{k}</dt><dd>{v}</dd></div>
      ))}
    </dl>
  </div>
</section>

<section class="faq section" id="faq">
  <div class="page split">
    <div class="k"><h2 class="h2">Questions</h2></div>
    <div class="v list">
      {FAQ.map((f) => (
        <details>
          <summary><span>{f.q}</span><i aria-hidden="true"></i></summary>
          <p class="body">{f.a}</p>
        </details>
      ))}
    </div>
  </div>
</section>

<style>
  .engine .split .h2 { margin: 0 0 24px; }
  .specs { margin: 80px 0 0; display: grid; grid-template-columns: repeat(12, 1fr); column-gap: 32px; }
  .row { grid-column: 5 / span 8; display: grid; grid-template-columns: 200px 1fr; gap: 32px; padding-block: 16px; border-top: 1px solid var(--line); }
  .row:last-child { border-bottom: 1px solid var(--line); }
  dt { font-size: 15px; line-height: 24px; color: var(--ink-3); }
  dd { margin: 0; font-size: 15px; line-height: 24px; color: var(--ink); }
  @media (max-width: 900px) { .row { grid-column: 1 / -1; grid-template-columns: 120px 1fr; } }

  .faq { padding-top: 0; }
  .list { display: flex; flex-direction: column; }
  details { border-top: 1px solid var(--line); }
  details:last-child { border-bottom: 1px solid var(--line); }
  summary {
    list-style: none; cursor: pointer; display: flex; justify-content: space-between; align-items: center; gap: 24px;
    padding-block: 24px; font-size: 17px; line-height: 24px; font-weight: 500; color: var(--ink);
  }
  summary::-webkit-details-marker { display: none; }
  summary i { position: relative; width: 16px; height: 16px; flex: none; }
  summary i::before, summary i::after { content: ''; position: absolute; left: 0; top: 7px; width: 16px; height: 1.5px; background: var(--ink-2); border-radius: 1px; transition: transform 0.3s var(--ease-out); }
  summary i::after { transform: rotate(90deg); }
  details[open] summary i::after { transform: rotate(0); }
  details .body { margin: 0 0 24px; max-width: 680px; }
</style>
