---
// The homepage tells one story, top to bottom, and every part of it has the
// same shape (see styles/site.css, and components/Section.astro): what
// Wortel is, the window and how it splits, showing an agent what you mean,
// a terminal first, the agents in it, everything else at a glance, and the
// questions. Splits and mark-up come straight after the landing: they are
// what sets Wortel apart, and mark-up picks up where splits ends.
import Layout from '../layouts/Layout.astro';
import Hero from '../components/home/Hero.astro';
import Start from '../components/home/Start.astro';
import Agents from '../components/home/Agents.astro';
import Panes from '../components/home/Panes.astro';
import Markup from '../components/home/Markup.astro';
import Bento from '../components/home/Bento.astro';
import Glance from '../components/home/Glance.astro';
import { homeSchema } from '../data/schema';
import { latestRelease } from '../data/release';

const schema = homeSchema(await latestRelease());
---

<Layout path="/" schema={schema} markdown="/index.md">
  <Fragment slot="head">
    {/* The photo the first window stands on is the largest thing in the first
        screen, and a background the browser only finds once the stylesheet is
        read: named here, it is fetched with the page and ahead of the rest.
        The same two files and the same width as .stage in site.css. */}
    <link rel="preload" as="image" href="/img/lake.jpg" fetchpriority="high" media="(min-width: 901px)" />
    <link rel="preload" as="image" href="/img/lake-1600.webp" type="image/webp" fetchpriority="high" media="(max-width: 900px)" />
  </Fragment>
  <Hero />
  <Panes />
  <Markup />
  <Start />
  <Agents />
  <Bento />
  <Glance />
</Layout>

<script>
  import '../scripts/scenes';
</script>
