<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  The keeper's launchd job, registered by the app with SMAppService on first
  use (see KeeperConnection.launch). launchd's process rather than the app's,
  so it has a coalition of its own: macOS 27's Dock treats an app's spawned
  processes that outlive it as the app "Running in Background" and offers to
  stop them, and on 2026-10-07 that stopped the keeper and every session with
  it. Under launchd it is listed under Wortel in Login Items instead. Not run
  at load and not kept alive: the app starts it when it needs it, and it
  exits by itself once it holds nothing.
-->
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>sh.wortel.keeper</string>
    <key>BundleProgram</key>
    <string>Contents/Resources/bin/wortel-keeper</string>
    <key>RunAtLoad</key>
    <false/>
    <key>KeepAlive</key>
    <false/>
    <key>ProcessType</key>
    <string>Interactive</string>
    <key>AssociatedBundleIdentifiers</key>
    <array>
        <string>com.gielcobben.Wortel</string>
    </array>
</dict>
</plist>
