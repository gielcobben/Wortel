{
  // Cloudflare Worker that serves the static Astro build at wortel.sh.
  // Deploy with `npm run deploy` (astro build && wrangler deploy).
  //
  // It was assets-only until PostHog arrived. `main` does NOT put a script in
  // front of the site: Cloudflare matches a static asset first and only invokes
  // the Worker when nothing matches, so every page and font is served exactly
  // as before and worker/index.ts runs for /ph/* and the letter's three
  // routes alone. See that file for why the analytics traffic is proxied
  // rather than sent to posthog.com direct.
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "wortel-web",
  // Cobben account — the one that holds the wortel.sh zone.
  "account_id": "c91d5fdf38b8d28d8220c2a7d5b5610f",
  "compatibility_date": "2026-07-15",
  // Since compatibility date 2025-04-01 (`assets_navigation_prefers_asset_serving`)
  // a browser navigation (Sec-Fetch-Mode: navigate) to a path with no file is
  // answered by the assets layer with the 404 page and never reaches the
  // Worker, whatever its method. That made the letter's links and buttons dead
  // in a browser: the confirm link opened the 404 page, and the Confirm, Leave
  // and no-JavaScript Subscribe buttons got a 405 (found 2026-11-27; a curl
  // without that header reached the Worker, which is how it was missed). This
  // flag turns that off, so a navigation that matches no file reaches the
  // Worker like any other request, and worker/index.ts hands what is not its
  // own back to ASSETS for the same 404 page. A file is still served first.
  "compatibility_flags": ["assets_navigation_has_no_effect"],
  "main": "./worker/index.ts",
  "assets": {
    "directory": "./dist",
    // Only meaningful alongside `main`: it is how the Worker hands a request
    // back to the assets layer instead of inventing its own 404.
    "binding": "ASSETS",
    // Astro builds /compare/index.html, and the default ("auto-trailing-slash")
    // serves that at /compare/ while redirecting /compare to it. But every
    // canonical tag and every sitemap entry on this site is written WITHOUT the
    // slash (Layout.astro builds them from a `path` prop like "/compare"), so
    // the default made every subpage canonical point at a redirect and filled
    // the sitemap with URLs that 307. Serving the no-slash form is the half of
    // that pair worth keeping: it matches what the site already claims about
    // itself, and it is what the internal links use.
    "html_handling": "drop-trailing-slash",
    // A path that matches no file gets dist/404.html (src/pages/404.astro)
    // with a 404 status, instead of an empty body. It comes back through the
    // Worker (index.ts hands a path it does not own to ASSETS).
    "not_found_handling": "404-page"
    // No run_worker_first. The letter needed the Worker in front of two pages,
    // and a list here was tried: with it, every POST to a path NOT on the list
    // got a 405 from the assets layer instead of reaching the Worker, /ph's
    // analytics included (wrangler 4.134, 2026-11-26). So the letter's routes
    // are paths with no file behind them, like /ph (worker/letter-routes.ts),
    // and the flag above lets a browser's navigation reach them too.
  },
  // The letter's list: addresses that asked for an email when something big
  // ships. Created in the EU jurisdiction (`wrangler d1 create wortel-letter
  // --jurisdiction eu`), schema in migrations/. privacy.md says what is in it.
  "d1_databases": [
    { "binding": "DB", "database_name": "wortel-letter", "database_id": "d1254000-91d7-4dc3-810e-b4c6cc81b42c", "migrations_dir": "migrations" }
  ],
  // Cloudflare Email Sending, for the one mail this site sends: the
  // confirmation link. Needs wortel.sh onboarded to Email Sending and the
  // Workers Paid plan, without which it only reaches verified addresses.
  "send_email": [
    { "name": "EMAIL", "allowed_sender_addresses": ["letter@wortel.sh"] }
  ],
  // Once a day: deletes the letter's addresses not confirmed within a week
  // (worker/index.ts, `scheduled`). Joins sweep too, but on a week with none
  // nothing else would, and /privacy promises the week.
  "triggers": { "crons": ["17 3 * * *"] },
  // Joins per IP, counted in memory at the edge and never stored.
  "ratelimits": [
    { "name": "JOIN_LIMIT", "namespace_id": "1001", "simple": { "limit": 5, "period": 60 } }
  ],
  // The apex only. www.wortel.sh is NOT routed here: it is a proxied
  // placeholder record (AAAA 100::) plus a zone Redirect Rule that 301s it to
  // https://wortel.sh with the path and query kept (Rules > Redirect Rules in
  // the dashboard). Serving the site on both hosts would make two copies of
  // every page; a redirect keeps one.
  "routes": [
    { "pattern": "wortel.sh", "custom_domain": true }
  ]
}
