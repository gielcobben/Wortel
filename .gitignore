.DS_Store
xcuserdata/
*.xcodeproj
DerivedData/
build/
.wrangler/

# Sparkle release archives — large binaries; R2 (wortel-updates) is the
# canonical store. releases/appcast.xml stays tracked as a record of the feed.
macos/releases/*.zip
macos/releases/*.delta
# generate_appcast retires archives past --maximum-versions into here.
macos/releases/old_updates/

# Web app (web/) — Node + Astro + Cloudflare build output
node_modules/
web/dist/
.astro/

# Claude Code transient worktrees
.claude/worktrees/

# Pixel-comparison harness for the app replica: 2x reference screenshots of the
# real app (several MB each) and the /compare page that overlays the live window
# on them. Local tools, not the site — and shipping them would put 7MB of
# screenshots on wortel.sh. See web/README.md.
web/public/refs/
web/src/pages/compare.astro
