---
// The page for a URL that leads nowhere. Built to dist/404.html, which
// wrangler.jsonc's `not_found_handling: "404-page"` serves with a 404 status
// for any path that matches no file. A miss reaches worker/index.ts first
// (wrangler.jsonc, `assets_navigation_has_no_effect`), which hands what is not
// its own back to ASSETS and gets this page.
//
// It drops the query and fragment from its own address before analytics
// starts, because a 404's address can carry a secret: a letter link with its
// `?t=` token, mangled on the way (a slash added, a path cut short), would
// otherwise go to PostHog as the page view's URL and to the next page as the
// referrer. Nobody needs the query of a page that does not exist.
//
// noindex and no canonical: it is the answer for every bad URL at once, so it
// is not a page of its own, and a search result pointing at it would be a bug.
import Layout from '../layouts/Layout.astro';
import { SITE } from '../data/site';

const links: [string, string][] = [
  ['/', 'What Wortel is'],
  ['/docs', 'Commands and shortcuts'],
  ['/updates', 'The changelog'],
  ['/compare', 'How it compares'],
];
---
<Layout title={`Not found: ${SITE.name}`} description="There is no page at this address." path="/404" noindex bare>
  <script is:inline slot="head">if (location.search || location.hash) history.replaceState(null, '', location.pathname)</script>
  <header class="page phead" data-reveal-group>
    <img class="icon" src="/icon-256.png" width="96" height="96" alt="" data-reveal />
    <h1 class="display" data-reveal>Nothing grows here.</h1>
    <p class="lead" data-reveal>
      There is no page at this address. It may have moved, or the link was mistyped.
    </p>
    <div class="ctas" data-reveal>
      <a class="btn" href="/">Go to the homepage</a>
      <a class="btn ghost" href="/download#404">Download Wortel</a>
    </div>
    <ul class="more" data-reveal>
      {links.map(([href, label]) => <li><a class="link" href={href}>{label}</a></li>)}
    </ul>
  </header>
</Layout>

<style>
  .icon { display: block; width: 96px; height: 96px; margin-bottom: 32px; }
  .ctas { display: flex; flex-wrap: wrap; gap: 8px; margin-top: 32px; }
  .more { list-style: none; padding: 0; margin: 32px 0 0; display: flex; flex-wrap: wrap; gap: 16px 24px; }
</style>
