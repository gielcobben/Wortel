---
// /docs: the reference. Everything here comes from DOCS_SECTIONS in site.ts,
// which llms-full.txt renders too.
import Layout from '../layouts/Layout.astro';
import Blocks from '../components/Blocks.astro';
import { SITE, DOCS, DOCS_SECTIONS } from '../data/site';
const abs = (p: string) => new URL(p, SITE.url).href;
const schema = [{
  '@type': 'TechArticle', '@id': abs('/docs#article'), url: abs('/docs'), headline: DOCS.title,
  description: DOCS.description, isPartOf: { '@id': abs('/#website') }, about: { '@id': abs('/#app') }, inLanguage: 'en',
}];
---
<Layout title={DOCS.title} description={DOCS.description} path="/docs" schema={schema}>
  <header class="column phead" data-reveal-group>
    <h1 class="display" data-reveal>{DOCS.heading}</h1>
    <p class="lead" data-reveal>{DOCS.lead}</p>
    <nav class="toc" aria-label="On this page" data-reveal>
      {DOCS_SECTIONS.map((s) => <a href={`#${s.id}`}>{s.title}</a>)}
    </nav>
  </header>
  <div class="column">
    {DOCS_SECTIONS.map((s) => (
      <section id={s.id} class="sec">
        <h2 class="t">{s.title}</h2>
        {s.lead && <p class="lead">{s.lead}</p>}
        <div class="prose"><Blocks blocks={s.blocks} /></div>
      </section>
    ))}
  </div>
</Layout>
<style>
  .toc { display: flex; flex-wrap: wrap; justify-content: center; gap: 8px; margin-top: 16px; }
  .toc a { height: 32px; padding: 0 16px; display: inline-flex; align-items: center; border-radius: 999px; font-size: 14px; color: var(--ink-2); background: var(--bg-1); box-shadow: inset 0 0 0 1px var(--line); transition: color 0.2s; }
  .toc a:hover { color: var(--ink); }
  .sec { padding-block: 56px; border-top: 1px solid var(--line); scroll-margin-top: 56px; }
  .t { margin: 0; font: 600 24px/32px var(--font-display); letter-spacing: -0.02em; color: var(--ink); }
  .sec .lead { font-size: 17px; line-height: 28px; margin: 8px 0 24px; }
</style>
