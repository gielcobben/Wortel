---
import '../../styles/app.css';
import '../../styles/site.css';
import HeroWindow from '../../app/gen/HeroWindow.astro';
import Mark from '../../components/Mark.astro';
---
<html><head><meta charset="utf-8"></head>
<body style="margin:0">
<div style="position:relative;width:1200px;height:630px;overflow:hidden;background:#fbfaf7">
  <img src="/img/lake.jpg" style="position:absolute;inset:0;width:100%;height:100%;object-fit:cover;object-position:50% 60%" alt="">
  <div style="position:absolute;left:72px;top:64px;display:flex;align-items:center;gap:10px;color:#1b1b17;font:600 28px/1 BlinkMacSystemFont;letter-spacing:-.035em"><Mark size={32} />wortel</div>
  <h1 style="position:absolute;left:72px;top:136px;margin:0;font:600 64px/1.04 BlinkMacSystemFont;letter-spacing:-.032em;color:#1b1b17">Many agents.<br><span style="color:#85837a">One calm terminal.</span></h1>
  <p style="position:absolute;left:72px;top:300px;margin:0;font:400 22px/1.4 BlinkMacSystemFont;color:#4d4b44;max-width:440px">A native macOS terminal on Ghostty’s engine. Free.</p>
  <div class="wapp dark" style="position:absolute;left:600px;top:120px;width:1000px;height:640px;display:flex;border-radius:18px;box-shadow:0 40px 80px -24px rgb(40 38 28/.45)"><HeroWindow /></div>
</div>
</body></html>
