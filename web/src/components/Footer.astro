---
import { SITE } from '../data/site';
import { latestRelease } from '../data/release';
interface Props { bare?: boolean }
const { bare = false } = Astro.props;
const latest = await latestRelease();
const links: [string, string][] = [
  ['Changelog', '/updates'], ['Docs', '/docs'], ['Compare', '/compare'], ['About', '/about'],
  ['Privacy', '/privacy'], ['Terms', '/terms'], ['llms.txt', '/llms.txt'],
];
---
<footer class="foot">
  {!bare && (
    <section class="cta page" data-reveal-group>
      <img src="/icon-512.png" width="96" height="96" alt="" data-reveal />
      <h2 class="h2" data-reveal>Try Wortel.</h2>
      <p class="lead" data-reveal>Free for macOS {SITE.minMacOS} {SITE.minMacOSName} or later. It updates itself.</p>
      <div data-reveal>
        <a class="btn" href={SITE.download} data-ph="download_clicked" data-ph-location="footer" data-ph-version={latest?.version}>Download for macOS</a>
      </div>
      {latest && <p class="label" data-reveal>Version {latest.version}{latest.size && ` · ${latest.size}`}</p>}
    </section>
  )}
  <div class="page base">
    <nav class="links" aria-label="Footer">
      {links.map(([t, h]) => <a href={h}>{t}</a>)}
    </nav>
    <p class="label">© {new Date().getFullYear()} {SITE.author} · Built on <a class="link" href="https://ghostty.org">Ghostty</a> · Wortel is Dutch for root</p>
  </div>
</footer>

<style>
  .foot { margin-top: 160px; }
  .cta { display: flex; flex-direction: column; align-items: center; text-align: center; gap: 16px; padding-bottom: 160px; }
  .cta img { margin-bottom: 8px; }
  .cta .btn { margin-top: 16px; }
  .base { display: flex; flex-direction: column; align-items: center; gap: 16px; padding-block: 40px 48px; border-top: 1px solid var(--line); text-align: center; }
  .links { display: flex; flex-wrap: wrap; justify-content: center; gap: 8px 24px; }
  .links a { font-size: 14px; line-height: 24px; color: var(--ink-2); transition: color 0.2s; }
  .links a:hover { color: var(--ink); }
</style>
