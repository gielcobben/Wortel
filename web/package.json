{
  "name": "@wortel/web",
  "type": "module",
  "version": "0.1.0",
  "private": true,
  "description": "Landing page for Wortel — wortel.sh",
  "scripts": {
    "dev": "astro dev",
    "build": "astro build && rm -rf dist/refs dist/pixel && find dist -name .DS_Store -delete",
    "check": "astro check && tsc -p worker",
    "preview": "astro preview",
    "deploy": "npm run build && wrangler deploy",
    "cf-preview": "npm run build && wrangler dev"
  },
  "engines": {
    "node": ">=22.18"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.12",
    "@cloudflare/workers-types": "^5.20261109.1",
    "@tailwindcss/vite": "^4.3.5",
    "@types/node": "^26.6.6",
    "astro": "^5.0.0",
    "tailwindcss": "^4.3.5",
    "typescript": "^5.9.3",
    "wrangler": "^4.134.0"
  },
  "dependencies": {
    "gsap": "^3.15.1"
  }
}
