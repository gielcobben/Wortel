---
// The day, part by part: the index under /learn's opening. Each part at its
// time, in order, on one line across the page; a link to it. On a phone, a
// list. The words are each part's own (LEARN.parts in data/site.ts).
import { LEARN } from '../../data/site';
---
<nav class="day" aria-label={LEARN.dayLabel} data-reveal>
  <ol style={`--n:${LEARN.parts.length}`}>
    {LEARN.parts.map((p) => (
      <li><a href={`#${p.id}`}><span class="t">{p.at}</span><span class="n">{p.title}</span></a></li>
    ))}
  </ol>
</nav>

<style>
  .day { margin-top: 64px; }
  ol { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(var(--n), minmax(0, 1fr)); column-gap: 8px; border-top: 1px solid var(--line); }
  a { position: relative; display: flex; flex-direction: column; gap: 8px; padding-top: 16px; color: var(--ink-2); transition: color 200ms ease; }
  /* A mark on the line where each part starts. */
  a::before { content: ''; position: absolute; left: 0; top: -4px; width: 7px; height: 7px; border-radius: 50%; background: var(--fog-0); box-shadow: inset 0 0 0 1px var(--ink-3); transition: background-color 200ms ease, box-shadow 200ms ease; }
  .t { font-size: 13px; line-height: 16px; font-variant-numeric: tabular-nums; color: var(--ink-3); }
  .n { font-size: 14px; line-height: 24px; text-wrap: balance; }
  @media (hover: hover) and (pointer: fine) {
    a:hover { color: var(--ink); }
    a:hover::before { background: var(--ink); box-shadow: none; }
  }
  @media (max-width: 1100px) {
    ol { grid-template-columns: repeat(5, minmax(0, 1fr)); row-gap: 32px; border-top: 0; }
    li { border-top: 1px solid var(--line); }
  }
  @media (max-width: 640px) {
    .day { margin-top: 48px; }
    ol { grid-template-columns: 1fr; row-gap: 0; border-bottom: 1px solid var(--line); }
    a { flex-direction: row; align-items: center; gap: 16px; min-height: 48px; padding: 8px 0; }
    a::before { display: none; }
    .t { width: 48px; flex: none; }
  }
</style>
