---
import Layout from '../layouts/Layout.astro';
import Hero from '../components/home/Hero.astro';
import Panes from '../components/home/Panes.astro';
import Features from '../components/home/Features.astro';
import Faq from '../components/home/Faq.astro';
import { homeSchema } from '../data/schema';
import { latestRelease } from '../data/release';

const schema = homeSchema(await latestRelease());
---

<Layout path="/" schema={schema}>
  <Hero />
  <Panes />
  <Features />
  <Faq />
</Layout>
