---
// The brand mark: a prompt, the cursor, and under the surface its reflection.
// Wortel is Dutch for root; the part below the line is the root.
interface Props { size?: number; class?: string }
const { size = 24, class: cls } = Astro.props;
---
<svg class={cls} width={size} height={size} viewBox="0 0 32 32" fill="currentColor" aria-hidden="true">
  <path d="M5.5 8.5 11.5 13l-6 4.5" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round" />
  <rect x="15" y="4" width="9" height="15" rx="1.8" />
  <rect class="root" x="15" y="21" width="9" height="8" rx="1.8" opacity=".3" />
</svg>
