---
import { SITE } from '../data/site';
import GitHubMark from './GitHubMark.astro';
const here = Astro.url.pathname.replace(/\/$/, '') || '/';
const links = [
  ['Learn', '/learn'],
  ['Changelog', '/updates'],
  ['Docs', '/docs'],
  ['Compare', '/compare'],
  ['About', '/about'],
];
---
<header class="nav">
  <div class="page bar">
    <a class="brand tap" href="/" aria-label="Wortel, home">
      <img src="/icon-128.png" width="24" height="24" alt="" />
      <span>Wortel</span>
    </a>
    <nav class="links" aria-label="Main">
      {links.map(([t, h]) => (
        <a href={h} aria-current={here === h || here.startsWith(h + '/') ? 'page' : undefined}>{t}</a>
      ))}
    </nav>
    <div class="acts">
      <a class="btn sm ghost gh" href={SITE.repo} target="_blank" rel="noopener" aria-label="Wortel on GitHub"><GitHubMark /><span>GitHub</span></a>
      <a class="btn sm" href="/download#nav">Download</a>
    </div>
    <details class="menu">
      <summary class="tap" aria-label="Menu"><span></span><span></span></summary>
      <nav class="sheet" aria-label="Main">
        {links.map(([t, h]) => <a href={h} aria-current={here === h || here.startsWith(h + '/') ? 'page' : undefined}>{t}</a>)}
      </nav>
    </details>
  </div>
</header>

<style>
  .nav {
    position: fixed; inset: 0 0 auto; z-index: 50; height: 64px;
    background: var(--nav);
    backdrop-filter: saturate(1.8) blur(20px);
    -webkit-backdrop-filter: saturate(1.8) blur(20px);
  }
  .bar { height: 64px; display: flex; align-items: center; gap: 32px; }
  .brand { display: inline-flex; align-items: center; gap: 8px; font: 600 17px/24px var(--font-display); letter-spacing: -0.02em; color: var(--ink); }
  .links { display: flex; gap: 24px; margin-left: auto; }
  .acts { display: flex; gap: 8px; }
  .gh { padding-left: 12px; }
  .links a { font-size: 14px; line-height: 24px; color: var(--ink-2); transition: color 200ms ease; }
  .links a[aria-current] { color: var(--ink); }
  @media (hover: hover) and (pointer: fine) { .links a:hover { color: var(--ink); } .sheet a:hover { background: var(--btn-2); } }
  .menu { display: none; position: relative; }
  .menu summary { list-style: none; cursor: pointer; width: 32px; height: 32px; border-radius: 999px; display: flex; flex-direction: column; justify-content: center; align-items: center; gap: 5px; background: var(--btn-2); }
  .menu summary::-webkit-details-marker { display: none; }
  .menu summary span { width: 14px; height: 1.5px; border-radius: 1px; background: var(--ink); transition: transform 0.25s var(--ease-out); }
  .menu[open] summary span:first-child { transform: translateY(3.25px) rotate(45deg); }
  .menu[open] summary span:last-child { transform: translateY(-3.25px) rotate(-45deg); }
  .sheet {
    position: absolute; right: 0; top: 40px; min-width: 200px; padding: 8px;
    display: flex; flex-direction: column; border-radius: 16px;
    background: var(--fog-0); box-shadow: 0 0 0 1px var(--line), 0 16px 40px rgb(0 0 0 / 0.12);
    /* It opens out of the button in its top right corner. */
    transform-origin: calc(100% - 16px) -8px;
    transition: opacity 150ms var(--ease-out), transform 150ms var(--ease-out);
  }
  @starting-style { .menu[open] .sheet { opacity: 0; transform: scale(0.96); } }
  .sheet a { height: 40px; display: flex; align-items: center; padding: 0 16px; border-radius: 8px; font-size: 15px; color: var(--ink); }
  .sheet a[aria-current] { background: var(--btn-2); }
  @media (max-width: 700px) {
    .links { display: none; }
    .acts { margin-left: auto; }
    /* On a phone the source is its mark alone, the size of the menu button. */
    .gh { width: 32px; padding: 0; justify-content: center; }
    .gh span { display: none; }
    .bar { gap: 8px; }
    .menu { display: block; }
  }
  /* Under a finger the menu's rows are taller. */
  @media (pointer: coarse) { .sheet a { height: 48px; } }
</style>

<script>
  // The menu closes when a tap lands outside it, on Escape, and when one of
  // its links is followed (a link to the page you are on would leave it open).
  const menu = document.querySelector<HTMLDetailsElement>('.nav .menu');
  if (menu) {
    document.addEventListener('click', (e) => {
      if (!menu.open) return;
      const t = e.target as Node;
      if (!menu.contains(t) || (t instanceof Element && t.closest('.sheet a'))) menu.open = false;
    });
    document.addEventListener('keydown', (e) => { if (e.key === 'Escape' && menu.open) { menu.open = false; menu.querySelector('summary')?.focus(); } });
  }
</script>
