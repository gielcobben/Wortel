---
import Layout from '../layouts/Layout.astro';
import Hero from '../components/home/Hero.astro';
import Panes from '../components/home/Panes.astro';
import Resize from '../components/home/Resize.astro';
import Statement from '../components/home/Statement.astro';
import Agents from '../components/home/Agents.astro';
import Worktrees from '../components/home/Worktrees.astro';
import Survival from '../components/home/Survival.astro';
import NoSettings from '../components/home/NoSettings.astro';
import Command from '../components/home/Command.astro';
import Engine from '../components/home/Engine.astro';
import { homeSchema } from '../data/schema';
import { latestRelease } from '../data/release';

const schema = homeSchema(await latestRelease());
---

<Layout path="/" schema={schema} overHero>
  <Hero />
  <Statement />
  <Panes />
  <Resize />
  <Agents />
  <Worktrees />
  <Survival />
  <NoSettings />
  <Command />
  <Engine />
</Layout>

<script>
  import '../scripts/sections';
</script>
