---
// Nothing to configure. The one knob there is works on the card.
import TermCard from '../TermCard.astro';
const lines = [
  { cmd: 'ls ~/.config/wortel' },
  { out: 'ls: /Users/you/.config/wortel: No such file or directory', tone: 'err' as const },
  { cmd: '# good. nothing to sync, nothing to break.', pause: 0.6 },
];
---
<section class="ns section" id="zero-config">
  <div class="page">
    <div class="split" data-reveal-group>
      <div class="k"><p class="eyebrow" data-reveal>Zero configuration</p></div>
      <div class="v">
        <h2 class="h2" data-reveal>Nothing to configure.<br /><span class="tone">On purpose.</span></h2>
        <p class="body" data-reveal>
          A terminal you can spend an afternoon tuning is a terminal you will. Wortel chose the font, the theme, the keybinds and the scrollback once, and treats them as finished. The layout is yours, by dragging. The settings are nobody’s, because there are none.
        </p>
      </div>
    </div>
    <div class="row">
      <div class="card" data-fontdemo>
        <TermCard title="~" lines={lines} height={176} />
        <div class="knob">
          <p class="small">The one setting there is: font size, per session.</p>
          <div class="btns">
            <button type="button" data-font="-1" aria-label="Smaller text"><kbd>⌘</kbd><kbd>−</kbd></button>
            <button type="button" data-font="0" aria-label="Reset text size"><kbd>⌘</kbd><kbd>0</kbd></button>
            <button type="button" data-font="1" aria-label="Larger text"><kbd>⌘</kbd><kbd>+</kbd></button>
          </div>
        </div>
      </div>
      <ul class="nots" data-reveal-group="0.06">
        {['No settings window', 'No dotfile to keep in sync', 'No theme gallery', 'No plugin API', 'No layout presets'].map((t) => (
          <li data-reveal><span class="x">×</span>{t}</li>
        ))}
      </ul>
    </div>
  </div>
</section>
<style>
  .split .h2 { margin: 0 0 24px; }
  .row { display: grid; grid-template-columns: 7fr 5fr; gap: 64px; margin-top: 80px; align-items: start; }
  .knob { display: flex; justify-content: space-between; align-items: center; gap: 16px; margin-top: 24px; flex-wrap: wrap; }
  .knob .small { margin: 0; }
  .btns { display: flex; gap: 8px; }
  .btns button { all: unset; cursor: pointer; display: flex; gap: 2px; padding: 4px; border-radius: 8px; transition: background 0.2s; }
  .btns button:hover { background: var(--btn-2); }
  .btns button:active kbd { transform: translateY(1px); border-bottom-width: 1px; }
  .nots { list-style: none; margin: 0; padding: 0; display: flex; flex-direction: column; }
  .nots li { display: flex; gap: 16px; align-items: center; height: 56px; border-bottom: 1px solid var(--line); font-size: 17px; color: var(--ink); }
  .nots li:first-child { border-top: 1px solid var(--line); }
  .x { width: 24px; color: var(--ink-3); font-size: 20px; text-align: center; }
  @media (max-width: 900px) { .row { grid-template-columns: 1fr; } }
</style>
