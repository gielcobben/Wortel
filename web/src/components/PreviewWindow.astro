---
// A replica of Wortel's file-preview window, holding one Markdown file.
//
// The changelog is a folder of .md files (src/content/releases/), and the app
// opens a .md in exactly this window. So the page is not dressing the notes up
// as something they aren't: it shows the real files in the real window.
//
// Chrome is static markup rather than a Svelte island. There are 18 of these on
// the page and none of them has behaviour: the window is a picture. What makes
// it match the app is the palette, and that comes from the demo's own tokens by
// wearing .wortel-app.m27, so this file never restates a colour.
//
// LOOK: macOS 27 only, which is what the built HTML carries for the landing
// page too. A visitor on macOS 26 gets the 27 window here while the home page
// swaps to 26 after hydration. See look.svelte.js; making this follow would
// mean an island per window, which is a lot of runtime for a picture.
import '../demo/tokens.css';
import '../demo/tokens27.css';

interface Props {
  /** Filename in the titlebar, e.g. "2026.32.2.md". */
  name: string;
  /** Element id, used by the :target rule that shows one window at a time. */
  id: string;
  /** The newest release, shown when the URL carries no hash. */
  latest?: boolean;
}

const { name, id, latest = false } = Astro.props;
---

<!-- tabindex="-1" so opening a file can move focus here. Activating a link that
     silently swaps a region somewhere else leaves anyone not watching the
     pointer with no idea it did anything; focus is what says so. Not reachable
     by Tab, only programmatically. -->
<div class="wortel-app m27 win" id={id} tabindex="-1" data-latest={latest ? '' : undefined}>
  <div class="tb">
    <div class="lights">
      <span class="light r"></span><span class="light y"></span><span class="light g"></span>
    </div>
    <div class="t1">{name}</div>

    <!-- The preview window's own controls: font size, then Source and Rendered.
         Rendered is the selected one, because that is what the page is showing.
         They are inert here (a picture, not a control), so they are marked
         aria-hidden rather than given roles they do not honour. -->
    <div class="toolbar" aria-hidden="true">
      <div class="btns">
        <span class="cbtn">
          <svg viewBox="0 0 16 16" width="15" height="15" fill="none" stroke="currentColor"
            stroke-width="1.4" stroke-linecap="round">
            <path d="M3 8h10M8 3v10" />
          </svg>
        </span>
        <span class="sep"></span>
        <span class="cbtn">
          <svg viewBox="0 0 16 16" width="15" height="15" fill="none" stroke="currentColor"
            stroke-width="1.3" stroke-linejoin="round">
            <path d="M4 1.75h5L12.25 5v9.25H4z" />
            <path d="M8.75 2v3.25H12" />
          </svg>
        </span>
        <span class="cbtn on">
          <svg viewBox="0 0 16 16" width="15" height="15" fill="none" stroke="currentColor"
            stroke-width="1.3" stroke-linejoin="round">
            <path d="M4 1.75h5L12.25 5v9.25H4z" />
            <path d="M8.75 2v3.25H12" />
            <path d="M5.75 8.5h4.5M5.75 11h3" stroke-width="1.2" />
          </svg>
        </span>
      </div>
    </div>
  </div>

  <div class="doc-body">
    <div class="md"><slot /></div>
  </div>
</div>

<style>
  /* The shell, matching WortelApp27's: same radius, border, shadow and font,
     all read off the tokens rather than restated. Unlike the app window this
     one has an opaque fill, because there is no translucent sidebar over it to
     sample the page behind. */
  .win, .win :global(*) { box-sizing: border-box; }

  .win {
    position: relative;
    width: 100%;
    height: 100%;
    display: flex;
    flex-direction: column;
    overflow: hidden;
    border-radius: var(--w-radius);
    border: 0.5px solid var(--w-border);
    box-shadow: var(--w-shadow);
    background: var(--w-terminal-bg);
    color: var(--w-chrome-text);
    font-family: var(--w-sans);
    -webkit-font-smoothing: antialiased;
    text-align: left;
  }

  /* the 52px titlebar, the same strip the app window wears */
  .tb {
    position: relative;
    flex-shrink: 0;
    height: 52px;
    background: var(--w-titlebar-bg);
    border-bottom: 0.5px solid var(--w-hairline);
  }

  /* measured in WortelApp27: 14px circles at 18.75, 9px apart */
  .lights {
    position: absolute;
    left: 18.75px;
    top: 18.75px;
    display: flex;
    gap: 9px;
  }
  .light { width: 14px; height: 14px; border-radius: 50%; }
  .light.r { background: var(--w-light-red); }
  .light.y { background: var(--w-light-amber); }
  .light.g { background: var(--w-light-green); }

  /* A preview window has no sidebar to make room for, so the title sits where
     the lights leave off rather than at the app window's 173px. */
  .t1 {
    position: absolute;
    left: 108px;
    top: 18px;
    font-size: 13px;
    font-weight: 700;
    line-height: 16px;
  }

  .toolbar {
    position: absolute;
    top: 7.5px;
    right: 8.5px;
    display: flex;
    align-items: center;
  }
  .btns {
    display: flex;
    align-items: center;
    height: 36px;
    padding: 0 4px;
    gap: 2px;
    border-radius: 18px;
    background: var(--w-pill-fill);
    box-shadow: var(--w-pill-shadow), inset 0 0.5px 0 0 var(--w-pill-rim);
  }
  .cbtn {
    width: 32px; height: 28px;
    display: grid; place-items: center;
    border-radius: 14px;
    color: var(--w-chrome-text);
  }
  .cbtn.on { background: var(--w-btn-active); }
  .sep {
    width: 1px; height: 16px;
    margin: 0 2px;
    background: var(--w-seg-divider);
  }
  .cbtn svg { display: block; }

  /* ---- the document -------------------------------------------------------
     The window's own scroller, so a long release scrolls inside the window the
     way it does in the app rather than growing the page. */
  .doc-body {
    flex: 1;
    min-height: 0;
    overflow-y: auto;
    overscroll-behavior: contain;
    background: var(--w-terminal-bg);
  }
  .md {
    /* A measure, then centred in whatever the window is. Left-anchored, a note
       runs its text against a few hundred px of nothing on a wide window, which
       reads as the text having failed to fill rather than as a measure. */
    max-width: 820px;
    margin: 0 auto;
    padding: 40px 44px 56px;
    color: var(--w-term-text, var(--w-chrome-text));
    font-size: 15px;
    line-height: 1.62;
    -webkit-user-select: text;
    user-select: text;
  }

  /* GitHub's type scale, which is what the app's renderer follows: a titled
     first heading with a rule under it, and the same rule under every h2. */
  .md :global(h1) {
    font-size: 30px;
    font-weight: 600;
    letter-spacing: -0.02em;
    line-height: 1.25;
    padding-bottom: 10px;
    margin-bottom: 16px;
    border-bottom: 1px solid var(--w-hairline-strong);
  }
  .md :global(h2) {
    font-size: 21px;
    font-weight: 600;
    letter-spacing: -0.01em;
    padding-bottom: 8px;
    margin: 28px 0 14px;
    border-bottom: 1px solid var(--w-hairline-strong);
  }
  .md :global(p) { margin-bottom: 14px; }
  .md :global(strong) { font-weight: 600; }
  .md :global(ul) { margin: 0 0 14px; padding-left: 26px; }
  .md :global(li) { margin-bottom: 7px; }
  .md :global(li::marker) { color: var(--w-chrome-muted); }
  .md :global(a) { color: var(--w-accent); text-decoration: none; }
  .md :global(a:hover) { text-decoration: underline; }
  .md :global(blockquote) {
    margin: 0 0 14px;
    padding-left: 16px;
    border-left: 3px solid var(--w-hairline-strong);
    color: var(--w-chrome-sub);
  }
  .md :global(code) {
    font-family: var(--w-mono);
    font-size: 0.86em;
    padding: 2px 5px;
    border-radius: 5px;
    background: var(--w-code-bg);
  }
  .md :global(pre) {
    margin: 0 0 14px;
    padding: 14px 16px;
    border: 1px solid var(--w-hairline-strong);
    border-radius: 8px;
    background: var(--w-code-bg);
    overflow-x: auto;
  }
  .md :global(pre code) { padding: 0; background: none; font-size: 12.5px; }

  /* The version and date under the title: the file's own subtitle, not chrome. */
  .md :global(.file-meta) {
    margin: -8px 0 20px;
    font-size: 13px;
    color: var(--w-chrome-muted);
  }
</style>
