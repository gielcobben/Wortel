---
import Layout from '../layouts/Layout.astro';
import WortelApp from '../demo/WortelApp.svelte';
---

<Layout title="Wortel — live demo">
  <main class="demo-stage">
    <div class="fit">
      <WortelApp client:load sidebar={true} initialTab="history" />
    </div>
  </main>
</Layout>

<style>
  /* the app resizes with the browser like a native window; below ~900px
     viewport we scale the whole canvas down instead of crushing the panes */
  .demo-stage {
    position: fixed;
    inset: 0;
    display: grid;
    place-items: center;
    overflow: hidden;
  }
  .fit {
    width: clamp(880px, 100vw - 48px, 1800px);
    height: clamp(560px, 100vh - 48px, 1160px);
    scale: min(1, calc((100vw - 24px) / 880px), calc((100vh - 24px) / 560px));
  }
</style>
