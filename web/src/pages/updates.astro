---
// The changelog: the newest release in full at the top, then every earlier
// one as a row under the month it shipped in, so the whole history can be
// read down in one go. Each release has a page of its own
// (pages/updates/[version].astro), which the version, the headline and the
// rows link to. The notes are the Markdown files in src/content/releases/, the
// same ones release-notes/[version].html.ts turns into Sparkle's in-app dialog.
import Layout from '../layouts/Layout.astro';
import ReleaseStamp from '../components/ReleaseStamp.astro';
import ReleaseRow from '../components/ReleaseRow.astro';
import { getCollection, render } from 'astro:content';
import { compareVersions } from '../content.config';
import { SITE } from '../data/site';

const releases = (await getCollection('releases')).sort((a, b) => compareVersions(b.id, a.id));
const oldest = releases[releases.length - 1];
/** The newest release, in full at the top: it is what "What's new" leads to. */
const latest = releases[0] && { entry: releases[0], Content: (await render(releases[0])).Content };
/** Every release before it, a row each, under the month it shipped in. */
const months: [string, string, typeof releases][] = [];
for (const entry of releases.slice(1)) {
  const [month, year] = entry.data.date.toLocaleDateString('en-US', { month: 'long', year: 'numeric', timeZone: 'UTC' }).split(' ');
  const last = months[months.length - 1];
  if (last && last[0] === month && last[1] === year) last[2].push(entry);
  else months.push([month, year, [entry]]);
}
const fmt = (d: Date) => d.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric', timeZone: 'UTC' });
const abs = (p: string) => new URL(p, SITE.url).href;
const title = `Changelog: every ${SITE.name} release`;
const description =
  `Release notes for every version of ${SITE.name}, the native macOS terminal built on Ghostty. ` +
  `${releases.length} releases since ${oldest ? fmt(oldest.data.date) : ''}.`;
const schema = [{
  '@type': 'WebPage', '@id': abs('/updates#webpage'), url: abs('/updates'), name: title, description,
  isPartOf: { '@id': abs('/#website') }, about: { '@id': abs('/#app') }, inLanguage: 'en',
  ...(latest && { dateModified: latest.entry.data.date.toISOString().slice(0, 10) }),
}];
---
<Layout title={title} description={description} path="/updates" schema={schema} ogImage="/og/updates.png" markdown="/updates.md">
  <header class="page phead" data-reveal-group>
    <h1 class="display" data-reveal>Changelog</h1>
    <p class="lead" data-reveal>
      {releases.length} releases since {oldest && fmt(oldest.data.date)}. Wortel updates itself, quietly, so this page is for reading rather than for doing anything.
    </p>
  </header>

  <div class="page">
    {latest && (
      <article class="row12 read rel" id={latest.entry.id}>
        <div class="k stick"><ReleaseStamp id={latest.entry.id} date={latest.entry.data.date} href={`/updates/${latest.entry.id}`} latest /></div>
        <div class="v">
          <h2 class="t"><a href={`/updates/${latest.entry.id}`}>{latest.entry.data.title}</a></h2>
          <div class="prose"><latest.Content /></div>
        </div>
      </article>
    )}
    {months.map(([month, year, list]) => (
      <section class="row12 read">
        <div class="k stick"><h2 class="h2">{month} <span class="tone">{year}</span></h2></div>
        <div class="v">
          {list.map((entry) => <ReleaseRow id={entry.id} title={entry.data.title} date={entry.data.date} />)}
        </div>
      </section>
    ))}
  </div>
</Layout>

<script>
  // /updates#<version> is how the app links to a release. The newest one is
  // on this page; any other has a page of its own: go there.
  const moved = () => {
    const v = decodeURIComponent(location.hash.slice(1));
    if (!v || document.getElementById(v)) return;
    if (document.querySelector(`[data-release="${CSS.escape(v)}"]`)) location.replace(`/updates/${v}`);
  };
  moved();
  window.addEventListener('hashchange', moved);
</script>

<style>
  .t { margin: 0 0 16px; font: 500 24px/32px var(--font-display); letter-spacing: -0.02em; color: var(--ink); text-wrap: balance; }
  @media (hover: hover) and (pointer: fine) { .t a:hover { text-decoration: underline; text-decoration-thickness: 1px; text-underline-offset: 6px; } }
</style>
