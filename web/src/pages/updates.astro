---
// The changelog. Renders every file in src/content/releases/, newest first.
// The notes themselves are Markdown; see src/content.config.ts for the rules
// (filename is the version, and nothing else writes it down).
//
// The page deliberately borrows the landing page's shell: .shell, .hero-left,
// .intro and .features are that page's global classes, not copies of them, so
// the two share one geometry (text column at x=36, the panel beside it starting
// on x=432) and can't drift apart. What changes is which side is pinned: the
// landing page pins the app window on the right and scrolls the prose, this one
// pins the text on the left and scrolls the releases.
import Layout from '../layouts/Layout.astro';
import { getCollection, render } from 'astro:content';
import { compareVersions } from '../content.config';
import { SITE } from '../data/site';

const entries = await getCollection('releases');
const releases = await Promise.all(
  entries
    .sort((a, b) => compareVersions(b.id, a.id))
    .map(async (entry) => ({ entry, Content: (await render(entry)).Content })),
);

const latest = releases[0];
const oldest = releases[releases.length - 1];

const fmt = (d: Date) =>
  d.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric', timeZone: 'UTC' });
// The index in the pinned column has 96px for the whole entry, so it drops the
// year: every release so far is from the same one, and the full date is two
// inches to the right on the release itself.
const shortFmt = (d: Date) =>
  d.toLocaleDateString('en-US', { month: 'short', day: 'numeric', timeZone: 'UTC' });

const abs = (p: string) => new URL(p, SITE.url).href;

const title = `Changelog: every ${SITE.name} release`;
const description =
  `Release notes for every version of ${SITE.name}, the native macOS terminal built on Ghostty. ` +
  `${releases.length} releases since ${oldest ? fmt(oldest.entry.data.date) : ''}.`;

// A minimal graph: this page, and the app it is the changelog for. The app node
// itself is described on the home page, so this one references it by @id rather
// than restating a second, driftable copy of it.
const schema = [
  {
    '@type': 'WebPage',
    '@id': abs('/updates#webpage'),
    url: abs('/updates'),
    name: title,
    description,
    isPartOf: { '@id': abs('/#website') },
    about: { '@id': abs('/#app') },
    inLanguage: 'en',
    ...(latest && { dateModified: latest.entry.data.date.toISOString().slice(0, 10) }),
  },
];
---

<Layout title={title} description={description} path="/updates" schema={schema}>
  <main>
    <div class="shell">
      <!-- The pinned column. Same box as the landing page's hero text: 100vh,
           content on the (36,36) intersection, first thing at the top and last
           thing at the bottom. -->
      <aside class="hero-left side">
        <div class="intro">
          <p class="mark"><a href="/">Wortel</a></p>
          <h1 class="page-title">Changelog</h1>
          <p class="desc">
            Every release, newest first. Wortel updates itself through Sparkle,
            so the app checks on its own: Wortel ▸ Check for Updates… takes the
            newest one immediately.
          </p>
          <p class="links">
            <a class="download" href={SITE.download}>
              <svg viewBox="0 0 16 16" width="15" height="15" aria-hidden="true">
                <path d="M8 1v8.5M8 9.5 4.75 6.25M8 9.5l3.25-3.25M2.5 12.5h11"
                  fill="none" stroke="currentColor" stroke-width="1.4"
                  stroke-linecap="round" stroke-linejoin="round" />
              </svg>
              Download the latest
            </a>
          </p>
          {latest && (
            <p class="version">
              {releases.length} releases · newest {latest.entry.id}
            </p>
          )}
        </div>

        <!-- Where the landing page puts Features. Same markup and the same two
             columns, so the pinned column reads as the same object on both. -->
        <nav class="features index" aria-label="Releases">
          <p class="head">Releases</p>
          <dl>
            {releases.map(({ entry }) => (
              <div>
                <dt><a href={`#${entry.id}`}>{entry.id}</a></dt>
                <dd>{shortFmt(entry.data.date)}</dd>
              </div>
            ))}
          </dl>
        </nav>
      </aside>

      <div class="panel-rail">
        <article class="panel doc changelog">
          {releases.map(({ entry, Content }, i) => (
            <section class="rel" id={entry.id}>
              <div class="meta">
                {/* The anchor is the version, so a link to one release is a link
                    anyone can read and retype. */}
                <a class="ver" href={`#${entry.id}`}>
                  {entry.id}
                  {i === 0 && <span class="tag">latest</span>}
                </a>
                <time datetime={entry.data.date.toISOString().slice(0, 10)}>
                  {fmt(entry.data.date)}
                </time>
              </div>
              <div class="body">
                <h2>{entry.data.title}</h2>
                <Content />
              </div>
            </section>
          ))}
        </article>
      </div>
    </div>

    <footer class="foot">
      <p>
        <strong>Wortel</strong>: a minimal, native macOS terminal built on Ghostty.
        Dutch for <em>root</em>.
      </p>
      <nav aria-label="Footer">
        <a href="/">Home</a>
        <a href={SITE.download}>Download</a>
        <a href="/#faq">FAQ</a>
        <a href={SITE.appcast}>Update feed</a>
        <a href="/llms.txt">llms.txt</a>
      </nav>
    </footer>
  </main>
</Layout>

<style>
  /* ==========================================================================
     The pinned column.

     .hero-left already gives the 100vh box, the 36px padding and the top/bottom
     split; this only pins it. The landing page pins the other side, so between
     them exactly one column is always moving.
     ========================================================================== */
  .side {
    position: sticky;
    top: 0;
    /* height, not min-height: .hero-left's min-height would let a tall index
       grow the column past the viewport, and the part below the fold of a
       pinned element is unreachable. Fixed height plus the scroll on .index
       keeps everything in it reachable at any window size. */
    height: 100vh;
  }

  .page-title {
    font-family: var(--round);
    font-size: 27px;
    font-weight: 600;
    letter-spacing: -0.02em;
    margin-top: 2px;
  }
  .mark a { color: var(--text-50); }
  .mark a:hover { color: var(--text); }

  /* The index takes what the intro leaves and scrolls inside itself rather than
     pushing the column past 100vh. min-height: 0 because a flex item's floor is
     its content, which would defeat the overflow. */
  .index {
    min-height: 0;
    overflow-y: auto;
    padding-top: 36px;
  }
  .index dt a { color: var(--text); font-family: var(--mono); font-size: 13px; }
  .index dt a:hover { text-decoration: underline; }
  .index dd { font-size: 13px; }

  /* ==========================================================================
     The panel.

     The rail's 36px padding puts its left edge on x=432, the same line the app
     window starts on over on the landing page, and it caps at 30 cells the way
     the window caps at the real thing's size: past that it would be a measure
     nobody can read across, not a bigger panel.

       panel     =  72 pad + content + 72 pad
       content   =  144 rail + 36 gutter + notes

     round() lands the right edge on a grid line at any viewport, the same
     technique .app-frame uses.
     ========================================================================== */
  .panel-rail {
    --panel: #22232e;
    --panel-edge: rgba(255, 255, 255, 0.07);
    --rule: rgba(255, 255, 255, 0.09);
    padding: 36px;
  }
  @media (prefers-color-scheme: light) {
    .panel-rail {
      /* Same white as the page behind it. What separates them is that the grid
         lines stop at the panel's edge, plus the hairline ring below. */
      --panel: #ffffff;
      --panel-edge: rgba(20, 22, 34, 0.10);
      --rule: rgba(20, 22, 34, 0.09);
    }
  }

  .panel {
    width: round(down, min(100%, 1080px), 36px);
    padding: 72px;
    background: var(--panel);
    /* A ring rather than a border: a border is 2px of box the grid math would
       have to account for, and the edges landing on the lines is the point.
       box-shadow does not take part in layout. */
    box-shadow: 0 0 0 1px var(--panel-edge);
  }

  /* Version and date in a left rail, notes beside them: 144 + 36, so the notes
     start on a grid line. */
  .rel {
    display: grid;
    grid-template-columns: 144px minmax(0, 1fr);
    gap: 36px;
    padding: 36px 0;
    border-top: 1px solid var(--rule);
  }
  .rel:first-child { border-top: 0; padding-top: 0; }
  .rel:last-child { padding-bottom: 0; }

  .meta { padding-top: 2px; }
  .ver {
    display: block;
    font-family: var(--mono);
    font-size: 13px;
    color: var(--text);
    text-decoration: none;
  }
  .ver:hover { text-decoration: underline; }
  .meta time {
    display: block;
    margin-top: 6px;
    font-size: 12.5px;
    color: var(--text-50);
  }
  .tag {
    display: inline-block;
    margin-left: 8px;
    padding: 1px 6px;
    border-radius: 999px;
    font-family: var(--sans);
    font-size: 10.5px;
    letter-spacing: 0.02em;
    color: var(--accent-text);
    background: var(--accent);
    vertical-align: 1px;
  }

  .body :global(h2) {
    font-size: 19px;
    margin-bottom: 12px;
  }
  /* Markdown from the collection lands here, so the shared .doc rules for p, ul
     and li already apply; only the first-child margin needs correcting. */
  .body :global(> :first-child) { margin-top: 0; }
  .body :global(code) {
    font-family: var(--mono);
    font-size: 0.9em;
  }
  /* Links inside a note's Markdown. The base rule strips underlines from every
     anchor on the site, which is right for navigation and wrong for prose. */
  .body :global(a) {
    color: inherit;
    text-decoration: underline;
    text-underline-offset: 2px;
    text-decoration-color: var(--text-50);
  }
  .body :global(a:hover) { text-decoration-color: currentColor; }

  /* Jumping to a release from the index lands it under the panel's top padding
     rather than flush against the viewport. */
  .rel:target { scroll-margin-top: 36px; }

  /* Stacked. .shell and .hero-left already collapse at this width (global.css);
     what is left is to stop pinning, and to let the index run at its natural
     height now that it is part of the page rather than a fixed column. */
  @media (max-width: 900px) {
    .side { position: static; height: auto; }
    .index { overflow-y: visible; padding-top: 0; }
    .panel-rail { padding: 0 0 36px 36px; }
    .panel {
      /* Left edge stays on x=36 with the text above it; the right runs to the
         viewport, where the body's overflow-x clips it. */
      width: 100%;
      padding: 36px;
    }
    .rel {
      grid-template-columns: minmax(0, 1fr);
      gap: 14px;
    }
  }
</style>
