---
// The landing: what Wortel is, the download, and the app on the foggy lake,
// where you type a request and an agent does the job (scripts/hero.ts).
import Stage from '../Stage.astro';
import HeroWindow from '../../app/gen/HeroWindow.astro';
import { SITE } from '../../data/site';
import { latestRelease } from '../../data/release';
const latest = await latestRelease();
---
<section class="hero" id="what-is-wortel" data-hero>
  <div class="page">
    <div class="bhead">
      <h1 class="display" data-fade>
        <span class="vh">Wortel: a native macOS terminal for coding agents. </span>
        Many agents.<br /><span class="tone">One calm terminal.</span>
      </h1>
      <p class="lead" data-fade>
        Wortel is a native macOS terminal on Ghostty’s engine. Every agent gets a named session and its own worktree, and the sidebar tells you which one needs you.
      </p>
      <div class="ctas" data-fade>
        <a class="btn" href={SITE.download} data-ph="download_clicked" data-ph-location="hero" data-ph-version={latest?.version}>Download for macOS</a>
        {latest && <a class="btn ghost" href="/updates" data-ph="changelog_opened" data-ph-location="hero" data-ph-version={latest.version}>What’s new in {latest.version}</a>}
      </div>
      <p class="label" data-fade>Free · macOS {SITE.minMacOS} {SITE.minMacOSName} or later</p>
    </div>

    <Stage w={1104} h={704} class="first">
      <div class="win wapp" data-win data-ph-demo aria-hidden="true" inert>
        <HeroWindow />
      </div>
    </Stage>
  </div>
</section>

<script>
  import { playHero } from '../../scripts/hero';
  playHero();
</script>

<style>
  .hero { padding-top: 144px; }
  .bhead { margin-bottom: 64px; }
  .lead { max-width: 560px; margin-top: 24px; }
  .ctas { display: flex; flex-wrap: wrap; gap: 8px; margin-top: 32px; }
  .label { margin-top: 16px; }
  .hero :global(.stage.first) { padding-block: 48px; }
  @media (max-width: 800px) { .hero { padding-top: 112px; } .bhead { margin-bottom: 48px; } }
</style>
