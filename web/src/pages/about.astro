---
// /about: the name, a short history of the terminal Wortel grows out of, and
// what it believes. One text column, like every page that is read.
import Layout from '../layouts/Layout.astro';
import { SITE } from '../data/site';

const abs = (p: string) => new URL(p, SITE.url).href;
const title = `Roots: about ${SITE.name}`;
const description = `Why ${SITE.name} exists, where it comes from, and what it believes. A native macOS terminal built on Ghostty, made in the Netherlands.`;
const schema = [{
  '@type': 'AboutPage', '@id': abs('/about#webpage'), url: abs('/about'), name: title, description,
  isPartOf: { '@id': abs('/#website') }, about: { '@id': abs('/#app') }, inLanguage: 'en',
}];

// The terminal's family tree. Dates are the first release of each.
const history = [
  { y: '1963', t: 'Teletype Model 33', d: 'Paper, ink and ten characters a second. The word tty still comes from here.' },
  { y: '1978', t: 'DEC VT100', d: 'A screen instead of paper, and the escape codes every terminal still speaks.' },
  { y: '1984', t: 'xterm', d: 'The terminal becomes a window among other windows.' },
  { y: '1987', t: 'GNU Screen', d: 'Sessions that outlive the connection that started them.' },
  { y: '2001', t: 'Terminal.app', d: 'Mac OS X ships, and a Unix shell comes with every Mac.' },
  { y: '2007', t: 'tmux', d: 'Panes, windows, and detaching on purpose.' },
  { y: '2024', t: 'Ghostty', d: 'Fast, native and correct, with an engine others can build on.' },
  { y: '2026', t: 'Wortel', d: 'Ghostty’s engine in a window made for working next to agents.', us: true },
  { y: 'Now', t: 'You', d: 'Five agents, one calm window. What are you growing?' },
];

const beliefs = [
  ['Native, or nothing', 'AppKit, Metal and the system’s own controls. Where macOS already has a way to do something, Wortel uses it, and it looks like it belongs.'],
  ['Decided once', 'Fonts, colours, keys, scrollback: chosen carefully, then left alone. You get your afternoons back.'],
  ['Calm by default', 'Nothing moves unless something happened. A dot, not a siren. A notification only for a session you are not looking at.'],
  ['The agent is a guest', 'Nothing is installed into an agent and nothing is written into its configuration. Wortel reads the screen, like you do.'],
  ['Your work outlives the window', 'Quit, crash, update: the shells keep running, and come back with everything they printed.'],
  ['Less, until it is right', 'Every feature has to earn its place in the window. Most of the work is taking things out.'],
];
---
<Layout title={title} description={description} path="/about" schema={schema}>
  <header class="column phead" data-reveal-group>
    <h1 class="display" data-reveal>Wortel is Dutch for root.</h1>
    <p class="lead" data-reveal>
      The root of a plant, the part below the surface that holds everything up. And the root shell, where the real work happens.
    </p>
  </header>

  <section class="column prose" data-reveal-group>
    <p data-reveal>Working with coding agents changed what a terminal is for. You no longer sit in one shell. You keep five going, in five checkouts, and the hard part stops being the typing. It becomes knowing which one is waiting for you, what each one changed, and not losing any of it when you close the lid.</p>
    <p data-reveal>The tools that grew up around this tend to be apps with a terminal tucked inside. Wortel goes the other way: it is the terminal, a real one on Ghostty’s engine, and the rest of the window is arranged around it. Native, quiet, and with nothing to configure.</p>
    <p data-reveal>Made in the Netherlands by {SITE.author}.</p>
  </section>

  <section class="section column">
    <div class="head" data-reveal-group>
      <h2 class="h2" data-reveal>Sixty years of the same blinking cursor.</h2>
    </div>
    <ol class="rows" data-reveal-group="0.04">
      {history.map((h) => (
        <li class:list={{ us: h.us }} data-reveal>
          <span class="y">{h.y}</span>
          <div><p class="t">{h.t}</p><p class="body">{h.d}</p></div>
        </li>
      ))}
    </ol>
  </section>

  <section class="section column">
    <div class="head" data-reveal-group>
      <h2 class="h2" data-reveal>What it believes.</h2>
    </div>
    <ol class="rows" data-reveal-group="0.04">
      {beliefs.map(([t, d], i) => (
        <li data-reveal>
          <span class="y">{String(i + 1).padStart(2, '0')}</span>
          <div><p class="t">{t}</p><p class="body">{d}</p></div>
        </li>
      ))}
    </ol>
  </section>
</Layout>

<style>
  .prose { font-size: 17px; line-height: 28px; }
  .rows { list-style: none; margin: 0; padding: 0; }
  .rows li { display: grid; grid-template-columns: 80px 1fr; gap: 16px; padding-block: 20px; border-top: 1px solid var(--line); }
  .rows li:last-child { border-bottom: 1px solid var(--line); }
  .y { font: 500 14px/24px var(--font-mono); color: var(--ink-3); }
  .t { margin: 0 0 4px; font-weight: 600; font-size: 16px; line-height: 24px; color: var(--ink); }
  .us .y, .us .t { color: var(--blue); }
</style>
