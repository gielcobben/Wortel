---
// A plain terminal window in the app's dark terminal colours, for the smaller
// demos. Lines are typed out by scripts/sections.ts when the card comes on
// screen: a line with `cmd` is typed after a prompt, the rest appear whole.
export type Line = { cmd?: string; out?: string; tone?: 'dim' | 'ok' | 'warn' | 'err' | 'accent'; pause?: number };
interface Props { title: string; lines: Line[]; height?: number; class?: string; id?: string }
const { title, lines, height = 360, class: cls, id } = Astro.props;
---
<div class:list={['term', cls]} style={`--h:${height}px`} data-term id={id}>
  <div class="bar">
    <span class="lights"><i></i><i></i><i></i></span>
    <span class="title">{title}</span>
  </div>
  <div class="screen" data-screen>
    {lines.map((l) => l.cmd !== undefined
      ? <p class="ln cmd" data-cmd={l.cmd} data-pause={l.pause}><span class="pr">❯</span> <span class="typed">{l.cmd}</span></p>
      : <p class:list={['ln', l.tone]} data-pause={l.pause}>{l.out || ' '}</p>)}
    <p class="ln cur"><span class="pr">❯</span> <span class="caret"></span></p>
  </div>
</div>
<style>
  .term {
    border-radius: 16px; overflow: hidden; background: #1f1f1f;
    box-shadow: var(--shadow-window), inset 0 0 0 0.5px rgb(255 255 255 / 0.1);
    -webkit-font-smoothing: antialiased; user-select: none;
  }
  .bar { position: relative; height: 40px; display: flex; align-items: center; justify-content: center; background: #2a2a2a; border-bottom: 1px solid rgb(255 255 255 / 0.06); }
  .lights { position: absolute; left: 14px; top: 14px; display: flex; gap: 8px; }
  .lights i { width: 12px; height: 12px; border-radius: 50%; background: #ff5f57; }
  .lights i:nth-child(2) { background: #febc2e; } .lights i:nth-child(3) { background: #28c840; }
  .title { font: 500 13px/16px var(--font-sans); color: rgb(255 255 255 / 0.55); }
  .screen {
    height: var(--h); padding: 12px 16px; overflow: hidden;
    display: flex; flex-direction: column; justify-content: flex-start;
    font: 500 14px/19px var(--font-mono); letter-spacing: -0.155px; color: #e6edf3;
  }
  .ln { margin: 0; white-space: pre-wrap; min-height: 19px; }
  .pr { color: #3fb950; }
  .cmd .typed { color: #e6edf3; }
  .dim { color: #8b949e; } .ok { color: #3fb950; } .warn { color: #d29922; } .err { color: #ff7b72; } .accent { color: #79c0ff; }
  .caret { display: inline-block; width: 8.5px; height: 17px; background: #3081f7; vertical-align: -3px; animation: caret 1.1s steps(1) infinite; }
  @keyframes caret { 50% { opacity: 0; } }
</style>
