---
// /compare. Copy lives in src/data/compare.ts.
//
// NO HERO AND NO WINDOW, unlike the other two pages. The landing page and
// /updates each pin the app beside their text, and this page did too, which
// meant a reader arrived at a comparison and was shown a terminal first. The
// page is a reference: a title, the categories, the grid, and the caveat. The
// product is one click away on every other surface here.
//
// It follows that none of the shell classes apply either. `.shell`,
// `.hero-left` and `.app-rail` exist to hold a 100vh board with a window on it;
// there is no window, so this is an ordinary centred document.
//
// THE ROUTE COST SOMETHING TO GET. `/compare` used to be the local pixel
// harness: `web/src/pages/compare.astro` was in .gitignore and `npm run build`
// ended with `rm -rf dist/refs dist/compare`, so a page here was untracked by
// git and deleted from every deploy while working perfectly in dev. The harness
// now lives at `/pixel` (.gitignore, package.json and web/README.md all moved
// with it), which frees this one.
import Layout from '../layouts/Layout.astro';
import CompareGrid from '../components/CompareGrid.astro';
import { SITE } from '../data/site';
import SiteFooter from '../components/SiteFooter.astro';
import { COMPARE, CATEGORIES } from '../data/compare';

const abs = (p: string) => new URL(p, SITE.url).href;

// One WebPage node pointing back at the app the whole site is about. No FAQPage:
// the questions here are table rows, not questions a person asked, and marking
// them up as an FAQ is the kind of structured data that earns a manual action.
const schema = [
  {
    '@type': 'WebPage',
    '@id': abs('/compare#webpage'),
    url: abs('/compare'),
    name: COMPARE.title,
    description: COMPARE.description,
    about: { '@id': abs('/#app') },
    isPartOf: { '@id': abs('/#website') },
    inLanguage: 'en',
  },
];
---

<Layout title={COMPARE.title} description={COMPARE.description} path="/compare" schema={schema}>
  <main>
    <div class="page">
    <header class="top">
      <p class="mark"><a href="/">{SITE.name}</a></p>
      <h1>{COMPARE.heading}</h1>
      <p class="lead">{COMPARE.lead}</p>
      {COMPARE.intro.map((p) => <p class="intro">{p}</p>)}
      <p class="cta">
        <a class="download" href={SITE.download}
          data-ph="download_clicked" data-ph-location="compare">
          <svg viewBox="0 0 16 16" width="15" height="15" aria-hidden="true">
            <path d="M8 1v8.5M8 9.5 4.75 6.25M8 9.5l3.25-3.25M2.5 12.5h11"
              fill="none" stroke="currentColor" stroke-width="1.4"
              stroke-linecap="round" stroke-linejoin="round" />
          </svg>
          Download for macOS
        </a>
      </p>
    </header>

    <!-- The categories, which is how you find the right column below. They carry
         no verdicts: everything a card could score is answered in the grid,
         once, and a summary that restates those answers disagrees with them on
         its third edit. -->
    <section class="cards" aria-label="Kinds of tool">
      {CATEGORIES.map((c) => (
        <div class={`card${c.key === 'wortel' ? ' us' : ''}`}>
          <p class="cname">{c.kind}</p>
          <p class="cwhat">{c.what}</p>
          <p class="ceg">{c.examples}</p>
          {c.useIf && <p class="cuse">{c.useIf}</p>}
        </div>
      ))}
    </section>

    <section class="grid-sect" aria-labelledby="grid-h">
      <h2 id="grid-h">{COMPARE.tableHeading}</h2>
      <p class="lead">{COMPARE.tableLead}</p>
      <CompareGrid />
      <p class="caveat">{COMPARE.caveat}</p>
    </section>

    </div>

    <!-- The floor, the same one every other page ends on (.tail-band in
         global.css). It has to sit OUTSIDE the centred container above:
         .page is 1152px wide with 36px gutters, and a full-bleed band cannot
         be painted from inside a box that narrow. That is also why the footer
         moved out with it, and why the .foot resets this page used to carry
         are gone: it is no longer inside a container that owns the gutters. -->
    <div class="tail-band">
      <SiteFooter location="compare-footer" />
    </div>
  </main>
</Layout>

<style>
  /* One centred measure, on the page's own 36px rhythm. Everything here is a
     multiple of it, which is what "on the grid" means on this site: the blocks
     do not draw the grid, they land on it. */
  .page {
    position: relative;
    z-index: 2;
    /* 34 cells wide, 1 cell of padding, so the panels inside are 32 cells and
       BOTH their edges land on a grid line. */
    --measure: 1224px;
    width: min(var(--measure), 100%);
    padding: 72px 36px;         /* 2 cells top and bottom, 1 cell sides */

    /* Centred TO THE NEAREST GRID LINE rather than to the exact half. A plain
       `margin: 0 auto` puts the left edge at (100% - 1224)/2, which is almost
       never a multiple of 36, so every panel edge sat between two lines. This
       is the same rule the app window follows on the other pages, where the
       drag and resize scripts snap it to whole 36px cells. round() is CSS
       Values 4; where it is unsupported the fallback below just centres. */
    margin-inline: auto;
    margin-left: round(down, max(0px, (100% - var(--measure)) / 2), 36px);
    margin-right: auto;
  }

  /* 15 cells, and the same measure .doc .prose uses on the other pages.
     At 720 the lead ran to 91 characters a line and the intro to 104,
     which is half again what reads comfortably. */
  .top { max-width: 540px; margin-bottom: 72px; }

  .mark { font-size: 14px; margin-bottom: 36px; }
  .mark a { color: var(--text-50); }
  .mark a:hover { color: var(--text); }

  /* The site's own heading: --sans (inherited), weight 500, -0.02em. Same as
     .doc h2 in global.css, one step down in size. Nothing on this page goes
     over 18px. */
  h1 {
    font-size: 18px;
    line-height: 1.3;
    letter-spacing: -0.02em;
    font-weight: 500;
    color: var(--text);
  }

  .lead {
    margin-top: 14px;
    font-size: 16px;
    line-height: 1.5;
    color: var(--text);
    text-wrap: pretty;
  }
  .intro {
    margin-top: 16px;
    font-size: 14px;
    line-height: 1.62;
    color: var(--text-70);
    text-wrap: pretty;
  }
  .cta { margin-top: 36px; }

  /* ---- the cards ----------------------------------------------------------
     The same panel as the grid below: one surface, its own edge, lifted off the
     paper. No rules between the columns; the space does that. */
  .cards {
    display: grid;
    grid-template-columns: repeat(5, minmax(0, 1fr));
    background: var(--bg);
    border: 1px solid var(--panel-border);
    border-radius: 16px;
    box-shadow: var(--panel-shadow);
    /* An inset, so the Wortel wash can round its own corners inside the panel
       instead of colliding with the panel's radius. */
    padding: 6px;
    margin-bottom: 72px;        /* 2 cells */
  }
  .card {
    display: flex;
    flex-direction: column;
    padding: 22px 18px 24px;
  }
  .card.us {
    border-radius: 11px;
    background: color-mix(in srgb, var(--accent) 6%, transparent);
  }

  .cname { font-size: 14px; font-weight: 500; color: var(--text); }
  .cwhat { margin-top: 5px; font-size: 13px; line-height: 1.45; color: var(--text-70); }
  .ceg { margin-top: 16px; font-size: 12px; line-height: 1.45; color: var(--text-50); }
  .cuse { margin-top: 16px; font-size: 12px; line-height: 1.55; color: var(--text-50); }

  .grid-sect h2 {
    font-size: 16px;
    line-height: 1.3;
    letter-spacing: -0.018em;
    font-weight: 500;
    color: var(--text);
  }
  .grid-sect .lead { max-width: 540px; margin-bottom: 36px; font-size: 14px; color: var(--text-70); }

  .caveat {
    margin-top: 36px;
    max-width: 540px;
    font-size: 13px;
    line-height: 1.6;
    color: var(--text-50);
  }

  /* NO .foot rules here any more. They existed because the footer used to sit
     inside .page, which owns the side gutters, so the global 756px block and
     its padding had to be reset back out. The footer is a sibling of .page now,
     in the band below it, and takes the same global .foot treatment as every
     other page. Do not reintroduce a scoped `.foot nav` here: it would beat
     the global one on specificity and silently unstack the link columns. */

  @media (max-width: 1040px) {
    .cards { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  }
  @media (max-width: 640px) {
    .page { padding: 36px 20px; margin-left: auto; }
    .top { margin-bottom: 48px; }
    h1 { font-size: 17px; }
    .lead { font-size: 14px; }
    .cards { grid-template-columns: minmax(0, 1fr); margin-bottom: 54px; }
  }
</style>
