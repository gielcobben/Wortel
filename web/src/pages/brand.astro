---
// /brand: the name, the mark, the icon and the colours, for anyone writing
// about Wortel. The assets download as one zip from public/brand/.
import Layout from '../layouts/Layout.astro';
import Mark from '../components/Mark.astro';
import { SITE } from '../data/site';

const abs = (p: string) => new URL(p, SITE.url).href;
const title = `Brand: the ${SITE.name} name, mark and colours`;
const description = `How to write ${SITE.name}, the mark and the app icon in light and dark, and the colours of the foggy lake the brand comes from.`;
const schema = [{ '@type': 'WebPage', '@id': abs('/brand#webpage'), url: abs('/brand'), name: title, description, isPartOf: { '@id': abs('/#website') }, inLanguage: 'en' }];

const colours = [
  { n: 'Fog', h: '#fbfaf7', note: 'The page' },
  { n: 'Mist', h: '#f3f2ed', note: 'Raised bands' },
  { n: 'Stone', h: '#dedbd2', note: 'Hairlines, tiles' },
  { n: 'Ink', h: '#1b1b17', note: 'Type, the mark', dark: true },
  { n: 'Moss', h: '#4f6127', note: 'The one accent', dark: true },
  { n: 'Sunlit moss', h: '#7d9a3c', note: 'Accent on dark', dark: true },
  { n: 'Night lake', h: '#0e0e0c', note: 'Dark mode', dark: true },
];
---
<Layout title={title} description={description} path="/brand" schema={schema}>
  <header class="page phead" data-reveal-group>
    <p class="eyebrow" data-reveal>Brand</p>
    <h1 class="display" data-reveal>A cursor,<br /><span class="tone">and its root.</span></h1>
    <p class="lead" data-reveal>The name, the mark, the icon and the colours. Use them freely to write about Wortel; please don’t use them to look like Wortel.</p>
    <p data-reveal class="dl"><a class="btn" href="/brand/wortel-brand.zip" download>Download brand assets</a></p>
  </header>

  <section class="section page">
    <div class="split">
      <div class="k"><p class="eyebrow">The name</p></div>
      <div class="v prose big">
        <p><strong>Wortel</strong>, one word, with a capital W in a sentence. It is Dutch for root: the root of a plant, and the root shell. Not “Wortel Terminal”, not “WORTEL”. The wordmark itself is set lowercase.</p>
      </div>
    </div>
  </section>

  <section class="section page tiles">
    <div class="split">
      <div class="k"><p class="eyebrow">The mark</p></div>
      <div class="v"><p class="body">A prompt, a block cursor, and under the surface its reflection. The part below the line is the root. On a light ground it is ink, on a dark one it is fog, and it is never any other colour.</p></div>
    </div>
    <div class="grid2">
      <div class="tile light" data-reveal><span class="lockup"><Mark size={48} /><span>wortel</span></span></div>
      <div class="tile dark" data-reveal><span class="lockup"><Mark size={48} /><span>wortel</span></span></div>
      <div class="tile light sm" data-reveal><Mark size={96} /></div>
      <div class="tile dark sm" data-reveal><Mark size={96} /></div>
    </div>
  </section>

  <section class="section page">
    <div class="split">
      <div class="k"><p class="eyebrow">The icon</p></div>
      <div class="v"><p class="body">The cursor standing in a foggy lake at first light, with its reflection underneath. Calm, and still very much a terminal.</p></div>
    </div>
    <div class="icons">
      <div class="itile fog" data-reveal><img src="/brand/wortel-icon.svg" width="320" height="320" alt="The Wortel app icon: a prompt and a block cursor standing in a foggy lake, reflected below" /></div>
      <div class="itile night" data-reveal><img src="/brand/wortel-icon.svg" width="200" height="200" alt="" /><img src="/brand/wortel-icon.svg" width="96" height="96" alt="" /><img src="/brand/wortel-icon.svg" width="48" height="48" alt="" /></div>
    </div>
  </section>

  <section class="section page">
    <div class="split">
      <div class="k"><p class="eyebrow">Colour</p></div>
      <div class="v"><p class="body">Every colour comes from one photograph: a still lake in morning fog, mossy rocks catching the first sun. Mostly fog and ink. Moss, sparingly.</p></div>
    </div>
    <div class="sw" data-reveal-group="0.05">
      {colours.map((c) => (
        <div class:list={['swatch', { dk: c.dark }]} style={`background:${c.h}`} data-reveal>
          <p class="n">{c.n}</p>
          <p class="h">{c.h}</p>
          <p class="note">{c.note}</p>
        </div>
      ))}
    </div>
  </section>

  <section class="section page">
    <div class="split">
      <div class="k"><p class="eyebrow">Type</p></div>
      <div class="v type">
        <p class="sample sans">SF Pro, the Mac’s own face, for everything.</p>
        <p class="sample serif">New York, for the few pages that are read rather than scanned.</p>
        <p class="sample mono">SF Mono, for anything you would type.</p>
      </div>
    </div>
  </section>
</Layout>

<style>
  .dl { margin-top: 40px; }
  .prose.big { font-size: 21px; line-height: 32px; color: var(--ink); }
  .tiles .grid2, .icons, .sw { margin-top: 64px; }
  .grid2 { display: grid; grid-template-columns: 1fr 1fr; gap: 16px; }
  .tile { height: 320px; border-radius: 24px; display: grid; place-items: center; }
  .tile.sm { height: 240px; }
  .tile.light { background: #fbfaf7; color: #1b1b17; box-shadow: inset 0 0 0 1px var(--line); }
  .tile.dark { background: #0e0e0c; color: #ecebe6; }
  .lockup { display: inline-flex; align-items: center; gap: 16px; font: 600 64px/1 var(--font-display); letter-spacing: -0.04em; }
  .icons { display: grid; grid-template-columns: 7fr 5fr; gap: 16px; }
  .itile { border-radius: 24px; min-height: 440px; display: flex; align-items: center; justify-content: center; gap: 24px; }
  .itile.fog { background: linear-gradient(#fbfaf7, #e9e7e0); }
  .itile.night { background: #1e1e1e; }
  .sw { display: grid; grid-template-columns: repeat(7, 1fr); gap: 8px; }
  .swatch { height: 240px; border-radius: 16px; padding: 16px; display: flex; flex-direction: column; justify-content: flex-end; color: #1b1b17; box-shadow: inset 0 0 0 1px rgb(0 0 0 / 0.06); }
  .swatch.dk { color: #fbfaf7; }
  .swatch p { margin: 0; }
  .swatch .n { font-weight: 600; font-size: 15px; line-height: 24px; }
  .swatch .h { font: 500 13px/16px var(--font-mono); opacity: 0.8; }
  .swatch .note { font-size: 13px; line-height: 24px; opacity: 0.6; }
  .type { display: flex; flex-direction: column; gap: 24px; }
  .sample { margin: 0; font-size: 32px; line-height: 40px; color: var(--ink); letter-spacing: -0.02em; }
  .sample.sans { font-family: var(--font-display); font-weight: 600; }
  .sample.serif { font-family: var(--font-serif); }
  .sample.mono { font-family: var(--font-mono); font-size: 24px; letter-spacing: 0; }
  @media (max-width: 900px) {
    .grid2, .icons { grid-template-columns: 1fr; }
    .sw { grid-template-columns: repeat(2, 1fr); }
    .lockup { font-size: 40px; }
  }
</style>
