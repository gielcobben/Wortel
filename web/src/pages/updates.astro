---
// The changelog, as the folder of Markdown files it actually is.
//
// Same shell as the landing page (.shell, .hero-left, .app-rail, .app-frame are
// that page's own global classes, used rather than copied), so the window lands
// on the same x=432 and the same snapped size. What sits in the frame differs:
// there it is the app, here it is the app's file-preview window with one
// release note open in it. Picking a file on the left opens it on the right.
//
// Every release is in the HTML, every one has a shareable URL, and the page
// works with JavaScript off: :target alone opens the right window, and the
// generated CSS below covers the one thing :target can't express. When the
// script IS there it takes that over (html.js-open), because reaching :target
// means a fragment navigation and a fragment navigation scrolls the page.
import Layout from '../layouts/Layout.astro';
import PreviewWindow from '../components/PreviewWindow.astro';
import { getCollection, render } from 'astro:content';
import { compareVersions } from '../content.config';
import { SITE } from '../data/site';
import SiteFooter from '../components/SiteFooter.astro';

const entries = await getCollection('releases');
const releases = await Promise.all(
  entries
    .sort((a, b) => compareVersions(b.id, a.id))
    .map(async (entry) => ({ entry, Content: (await render(entry)).Content })),
);

const latest = releases[0];
const oldest = releases[releases.length - 1];

const fmt = (d: Date) =>
  d.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric', timeZone: 'UTC' });
// The file list has 96px for a date, so it drops the year: every release so far
// is from the same one, and the full date is in the window two inches right.
const shortFmt = (d: Date) =>
  d.toLocaleDateString('en-US', { month: 'short', day: 'numeric', timeZone: 'UTC' });

const abs = (p: string) => new URL(p, SITE.url).href;

const title = `Changelog: every ${SITE.name} release`;
const description =
  `Release notes for every version of ${SITE.name}, the native macOS terminal built on Ghostty. ` +
  `${releases.length} releases since ${oldest ? fmt(oldest.entry.data.date) : ''}.`;

// ---- the one rule :target can't state -------------------------------------
// :target styles the element the URL names, and that is the window. The file
// on the LEFT that should look open is a different element in a different
// column, and CSS has no way to say "the link whose href matches whatever is
// targeted". So it is written out, one pair of rules per release, from the same
// array that renders them. is:inline because these are page-global selectors,
// not scoped ones, and Astro would otherwise rewrite them out of matching.
const openRow = 'background: rgba(128,128,128,0.14);';
const openName = 'color: var(--text);';
// html:not(.js-open) on every one of them: these are the no-script path. The
// script adds that class to take over, because once it does the URL is changed
// with pushState and :target goes deliberately stale (see the script for why).
// Without the guard the stale :target would keep a second row lit.
const openRule = (sel: string) =>
  `html:not(.js-open) ${sel}{${openRow}}\nhtml:not(.js-open) ${sel} .fname{${openName}}`;
const activeCss = [
  ...releases.map(({ entry }) =>
    openRule(`.shell:has([id="${entry.id}"]:target) .files a[href="#${entry.id}"]`),
  ),
  // Nothing targeted yet: the newest file is the one that is open. This has to
  // be conditional on nothing being targeted, or the newest stays lit next to
  // whichever file you actually opened, and two rows read as open at once.
  openRule('.shell:not(:has(.win:target)) .files a[data-latest]'),
].join('\n');

const schema = [
  {
    '@type': 'WebPage',
    '@id': abs('/updates#webpage'),
    url: abs('/updates'),
    name: title,
    description,
    isPartOf: { '@id': abs('/#website') },
    about: { '@id': abs('/#app') },
    inLanguage: 'en',
    ...(latest && { dateModified: latest.entry.data.date.toISOString().slice(0, 10) }),
  },
];
---

<Layout title={title} description={description} path="/updates" schema={schema}>
  <style is:inline set:html={activeCss} />

  <main>
    <div class="shell">
      <aside class="hero-left side">
        <div class="intro">
          <p class="mark"><a href="/">Wortel</a></p>
          <h1 class="page-title">Changelog</h1>
          <p class="desc">
            Every release is a Markdown file, and this is the window Wortel opens
            one in. Pick a version to read it.
          </p>
          <p class="links">
            <a class="download" href={SITE.download}
              data-ph="download_clicked" data-ph-location="updates">
              <svg viewBox="0 0 16 16" width="15" height="15" aria-hidden="true">
                <path d="M8 1v8.5M8 9.5 4.75 6.25M8 9.5l3.25-3.25M2.5 12.5h11"
                  fill="none" stroke="currentColor" stroke-width="1.4"
                  stroke-linecap="round" stroke-linejoin="round" />
              </svg>
              Download the latest
            </a>
          </p>
        </div>

        <!-- Where the landing page puts Features. A list of files, because that
             is what the folder holds. -->
        <nav class="files" aria-label="Releases">
          <p class="head">{releases.length} releases</p>
          <ol>
            {releases.map(({ entry }, i) => (
              <li>
                {/* aria-current starts on the newest because that is what a
                    visitor with no hash is looking at. The script moves it. */}
                <a
                  href={`#${entry.id}`}
                  data-latest={i === 0 ? '' : undefined}
                  aria-current={i === 0 ? 'true' : undefined}
                  data-ph="changelog_opened"
                  data-ph-version={entry.id}
                >
                  <span class="fname">{entry.id}.md</span>
                  <span class="fdate">{shortFmt(entry.data.date)}</span>
                </a>
              </li>
            ))}
          </ol>
        </nav>
      </aside>

      <div class="app-rail">
        <div class="app-frame">
          {releases.map(({ entry, Content }, i) => (
            <PreviewWindow id={entry.id} name={`${entry.id}.md`} latest={i === 0}>
              <h1>{entry.data.title}</h1>
              <p class="file-meta">
                Version {entry.id} · {fmt(entry.data.date)}
              </p>
              <Content />
            </PreviewWindow>
          ))}
          <!-- Eight resize handles, like a real window: four sides and four
               corners. They belong to the frame, not to a window, because all
               18 share one box. Pulling a top or left handle moves the window
               as well as resizing it, since the opposite edge is what stays
               put. None of them draws anything; the cursor says it. -->
          {['n', 's', 'e', 'w', 'ne', 'nw', 'se', 'sw'].map((edge) => (
            <span class={`rz rz-${edge}`} data-edge={edge} aria-hidden="true"></span>
          ))}
        </div>
      </div>
    </div>

    <!-- The floor, the same one the homepage ends on (.tail-band in
         global.css). Without it this page was one 100vh board and then a bare
         footer sitting on graph paper: the only thing scrolling down revealed
         was the footer itself, on a surface that had no reason to still be
         ruled. The grid belongs to the shell above, where the file list and
         the window line up against it. Below that it is ruling nothing, so it
         ramps out and the page has an ending. -->
    <div class="tail-band">
      <SiteFooter location="updates-footer" feed />
    </div>
  </main>

  <!-- Drag by the titlebar, resize from any edge or corner, both resting on
       whole grid cells: the same behaviour, and the same reasons, as the app
       window on the landing page. is:inline so it runs before first paint
       rather than after, which is what keeps the window from painting once and
       then jumping.

       All of it is enhancement. With no JavaScript the window keeps the size and
       place the stylesheet gives it, every release is still readable, and every
       link still works. -->
  <script is:inline>
    const CELL = 36;
    const TITLEBAR = 52;              // the preview window's own strip
    const DEFAULT = { w: 576, h: 612 };   // 16 x 17 cells
    const MIN = { w: 396, h: 288 };   // 11 x 8 cells, both whole ones

    const rail = document.querySelector('.app-rail');
    const frame = document.querySelector('.app-frame');
    const narrow = window.matchMedia('(max-width: 900px)');

    let size = { ...DEFAULT };
    let pos = { x: 0, y: 0 };
    let touched = false;   // until it is moved or resized, it follows the default
    let settleTimer;

    // hi can fall below lo on a very short rail, so lo wins rather than
    // producing a negative box.
    const clamp = (v, lo, hi) => Math.min(Math.max(v, lo), Math.max(lo, hi));
    const down = (v) => Math.floor(v / CELL) * CELL;
    const near = (v) => Math.round(v / CELL) * CELL;

    function avail() {
      const cs = getComputedStyle(rail);
      return {
        w: rail.clientWidth - parseFloat(cs.paddingLeft) - parseFloat(cs.paddingRight),
        h: rail.clientHeight - parseFloat(cs.paddingTop) - parseFloat(cs.paddingBottom),
      };
    }

    function apply() {
      frame.style.width = size.w + 'px';
      frame.style.height = size.h + 'px';
      frame.style.transform = pos.x || pos.y ? `translate(${pos.x}px, ${pos.y}px)` : '';
    }

    // Size first, then position: how far the window may travel depends on how
    // big it is, so clamping them the other way round lets a resize leave it
    // hanging outside the rail.
    function contain() {
      const a = avail();
      size.w = clamp(size.w, MIN.w, a.w);
      size.h = clamp(size.h, MIN.h, a.h);
      pos.x = clamp(pos.x, 0, a.w - size.w);
      pos.y = clamp(pos.y, 0, a.h - size.h);
    }

    function layout() {
      if (narrow.matches) {
        frame.style.width = frame.style.height = frame.style.transform = '';
        return;
      }
      if (!touched) {
        // Centred in the rail, then floored to whole cells so it opens on a
        // grid intersection rather than a half pixel off one. Floor and not
        // round, so it can never be pushed past the far edge on an odd size.
        const a = avail();
        size = { w: Math.min(DEFAULT.w, a.w), h: Math.min(DEFAULT.h, a.h) };
        pos = {
          x: Math.max(0, down((a.w - size.w) / 2)),
          y: Math.max(0, down((a.h - size.h) / 2)),
        };
      }
      contain();
      apply();
    }

    // On release, snap all four edges onto grid lines. The rail's origin is
    // (432, 36), both whole cells, so a snapped size AND a snapped offset put
    // every edge on a line the page is already painting. Snapping only the size
    // would leave the right edge floating wherever the left one landed.
    // `anchor` names the edges the gesture held still. Snapping the offset and
    // the size independently would shift them by up to a cell, so the edge you
    // were not touching would jump on release, which is exactly the edge you
    // were lining something up against. Snap the anchored edge instead and let
    // the offset fall out of it; both are whole cells, so the result still
    // lands on the grid.
    function settle(anchor) {
      const a = avail();
      const right = pos.x + size.w;
      const bottom = pos.y + size.h;
      size.w = clamp(near(size.w), MIN.w, down(a.w));
      size.h = clamp(near(size.h), MIN.h, down(a.h));
      pos.x = anchor && anchor.right ? near(right) - size.w : near(pos.x);
      pos.y = anchor && anchor.bottom ? near(bottom) - size.h : near(pos.y);
      pos.x = clamp(pos.x, 0, down(a.w - size.w));
      pos.y = clamp(pos.y, 0, down(a.h - size.h));
      frame.classList.add('settling');
      apply();
      clearTimeout(settleTimer);
      settleTimer = setTimeout(() => frame.classList.remove('settling'), 200);
    }

    function track(onMove, bodyClass, anchor) {
      // A gesture interrupting a settle has to be instant from the first frame.
      clearTimeout(settleTimer);
      frame.classList.remove('settling');
      touched = true;
      frame.classList.add('gesturing');
      document.body.classList.add(bodyClass);
      const stop = () => {
        settle(anchor);
        frame.classList.remove('gesturing');
        document.body.classList.remove(bodyClass);
        document.body.style.removeProperty('--rz-cursor');
        window.removeEventListener('pointermove', onMove);
        window.removeEventListener('pointerup', stop);
        window.removeEventListener('pointercancel', stop);
      };
      window.addEventListener('pointermove', onMove);
      window.addEventListener('pointerup', stop);
      window.addEventListener('pointercancel', stop);
    }

    frame.addEventListener('pointerdown', (e) => {
      if (narrow.matches) return;
      if (e.target.closest('.rz')) return;               // that gesture is a resize
      if (e.target.closest('a, button, input')) return;  // a link inside a note
      // Below the strip is the document: selecting a paragraph must not drag
      // the window out from under the pointer.
      if (e.clientY - frame.getBoundingClientRect().top >= TITLEBAR) return;
      const grab = { x: e.clientX - pos.x, y: e.clientY - pos.y };
      const a = avail();
      track((ev) => {
        pos.x = clamp(ev.clientX - grab.x, 0, a.w - size.w);
        pos.y = clamp(ev.clientY - grab.y, 0, a.h - size.h);
        apply();
      }, 'dragging-app');
      e.preventDefault();   // no text selection while dragging
    });

    // Eight handles off one routine. A handle names the edges it moves, and the
    // edges it does NOT name are the ones that stay put: pull the left side and
    // the right side is the anchor, so the window has to travel as it narrows.
    // That is the whole difference between resizing north/west and south/east,
    // and why the top-left corner cannot just be the bottom-right with signs
    // flipped.
    const CURSOR = {
      n: 'ns-resize', s: 'ns-resize', e: 'ew-resize', w: 'ew-resize',
      ne: 'nesw-resize', sw: 'nesw-resize', nw: 'nwse-resize', se: 'nwse-resize',
    };

    for (const handle of frame.querySelectorAll('.rz')) {
      handle.addEventListener('pointerdown', (e) => {
        if (narrow.matches) return;
        const edge = handle.dataset.edge;
        const a = avail();
        const start = { x: e.clientX, y: e.clientY, w: size.w, h: size.h, px: pos.x, py: pos.y };
        // The anchored edges, in rail coordinates. They do not move all gesture.
        const right = start.px + start.w;
        const bottom = start.py + start.h;

        document.body.style.setProperty('--rz-cursor', CURSOR[edge]);
        track((ev) => {
          const dx = ev.clientX - start.x;
          const dy = ev.clientY - start.y;
          if (edge.includes('e')) {
            // Growing right: the room is whatever is left of the rail past the
            // window's own left edge, which is not moving.
            size.w = clamp(start.w + dx, MIN.w, a.w - start.px);
          } else if (edge.includes('w')) {
            // Growing left: it can reach the rail's edge and no further, which
            // is the same as saying it can be at most as wide as `right`.
            size.w = clamp(start.w - dx, MIN.w, right);
            pos.x = right - size.w;
          }
          if (edge.includes('s')) {
            size.h = clamp(start.h + dy, MIN.h, a.h - start.py);
          } else if (edge.includes('n')) {
            size.h = clamp(start.h - dy, MIN.h, bottom);
            pos.y = bottom - size.h;
          }
          apply();
        }, 'resizing-win', {
          right: edge.includes('w'),
          bottom: edge.includes('n'),
        });
        e.preventDefault();
        e.stopPropagation();   // never also a drag
      });
    }

    new ResizeObserver(layout).observe(rail);
    narrow.addEventListener('change', layout);
    layout();

    // ---- the file list ----------------------------------------------------
    const files = document.querySelector('.files');
    const links = [...files.querySelectorAll('a')];
    const FADE = 30;

    // A fade at whichever end still has something behind it, and at neither end
    // when the whole list fits. Two pixels of slack because a scroll that has
    // reached the bottom can land a fraction short of it.
    function fades() {
      const room = files.scrollHeight - files.clientHeight;
      files.style.setProperty('--top-fade', files.scrollTop > 2 ? FADE + 'px' : '0px');
      files.style.setProperty('--bot-fade', files.scrollTop < room - 2 ? FADE + 'px' : '0px');
    }
    files.addEventListener('scroll', fades, { passive: true });
    new ResizeObserver(fades).observe(files);
    fades();

    // The window's scroller: the separator under the titlebar, which is drawn
    // only once something has actually gone under it, and the thumb, which is
    // drawn because the native one would run under the titlebar too.
    for (const body of document.querySelectorAll('.win .doc-body')) {
      const win = body.closest('.win');
      const track = win.querySelector('.sb');
      const thumb = win.querySelector('.sb-thumb');
      const sync = () => {
        const { scrollTop, scrollHeight, clientHeight } = body;
        win.classList.toggle('scrolled', scrollTop > 0);
        const room = scrollHeight - clientHeight;
        win.classList.toggle('scrollable', room > 1);
        if (room <= 1) return;
        const h = Math.max(28, (track.clientHeight * clientHeight) / scrollHeight);
        thumb.style.height = h + 'px';
        thumb.style.transform = `translateY(${(track.clientHeight - h) * (scrollTop / room)}px)`;
      };
      // Overlay behaviour: the thumb is shown by scrolling and taken away again
      // a moment after it stops, unless the pointer is on the window, in which
      // case it stays until the pointer leaves. The timer is what makes it feel
      // like the platform's rather than like a bar that is simply always there.
      let hide;
      const show = (hold) => {
        win.classList.add('sb-on');
        clearTimeout(hide);
        if (!hold) hide = setTimeout(() => win.classList.remove('sb-on'), 900);
      };

      body.addEventListener('scroll', () => { sync(); show(win.matches(':hover')); }, { passive: true });
      win.addEventListener('pointerenter', () => show(true));
      win.addEventListener('pointerleave', () => show(false));

      // Dragging the thumb, and clicking the track to go there. Both are the
      // same gesture: the only difference is where the thumb is considered to
      // have been grabbed. On the thumb it is where you actually took hold of
      // it, so it does not jump under the pointer; on the track there is no
      // such point, so it takes the middle and the thumb centres on the click.
      // That is what macOS does with "jump to the spot that's clicked".
      track.addEventListener('pointerdown', (e) => {
        const room = body.scrollHeight - body.clientHeight;
        const trackH = track.clientHeight;
        const thumbH = thumb.getBoundingClientRect().height;
        const span = trackH - thumbH;         // how far the thumb itself travels
        if (room <= 1 || span <= 0) return;
        const top = track.getBoundingClientRect().top;

        const grab = e.target === thumb ? e.clientY - thumb.getBoundingClientRect().top : thumbH / 2;
        const to = (clientY) =>
          Math.min(1, Math.max(0, (clientY - top - grab) / span)) * room;
        if (e.target !== thumb) body.scrollTop = to(e.clientY);

        win.classList.add('sb-drag');
        show(true);
        const move = (ev) => { body.scrollTop = to(ev.clientY); };
        const stop = () => {
          win.classList.remove('sb-drag');
          // Release it to the timer: the pointer may well have ended up off the
          // window entirely, and hover cannot be relied on to take it away.
          show(win.matches(':hover'));
          window.removeEventListener('pointermove', move);
          window.removeEventListener('pointerup', stop);
          window.removeEventListener('pointercancel', stop);
        };
        window.addEventListener('pointermove', move);
        window.addEventListener('pointerup', stop);
        window.addEventListener('pointercancel', stop);
        e.preventDefault();    // no text selection while dragging
        e.stopPropagation();   // never also a window drag
      });

      // Covers the two moments a scroll listener cannot: the window being
      // resized, and it going from display:none to open, which is a resize from
      // nothing and is why this needs no hook in openFile().
      new ResizeObserver(sync).observe(body);
      sync();
    }

    const linkFor = (hash) => links.find((a) => a.getAttribute('href') === hash);
    const wins = [...document.querySelectorAll('.app-frame > .win')];
    const idOf = (a) => decodeURIComponent(a.getAttribute('href').slice(1));

    // From here the script owns which window is open, not :target. Saying so in
    // the DOM is what switches the generated :target rules off.
    document.documentElement.classList.add('js-open');

    // Keep the open row in view inside the list. Deep-linking an old release
    // otherwise opens it on the right while its own row sits scrolled out of
    // sight on the left.
    function reveal(a) {
      if (!a) return;
      const r = a.getBoundingClientRect();
      const f = files.getBoundingClientRect();
      // Clear the fade as well as the edge, or the row it scrolls to is the one
      // the mask is busy dissolving.
      if (r.top < f.top + FADE) files.scrollTop -= f.top + FADE - r.top;
      else if (r.bottom > f.bottom - FADE) files.scrollTop += r.bottom - (f.bottom - FADE);
      // Directly, rather than waiting for the scroll event this just caused: a
      // background tab throttles that event, and the fades would sit describing
      // a scroll position the list has already left.
      fades();
    }

    // Opening a file without navigating to it.
    //
    // :target is the switch with no script behind it, and it stays for that
    // case, but reaching it needs a real fragment navigation and that scrolls:
    // the browser aligns the window's top edge with the viewport, which is the
    // snap to the titlebar. Restoring the scroll afterwards does not fix it.
    // The browser may do its scroll on a later frame, after the undo has run,
    // so the undo silently loses the race. (It appeared to work only in a
    // background tab, where that frame never came.)
    //
    // So: never navigate. pushState changes the URL and never scrolls, which
    // keeps the link shareable and the page still. It leaves :target pointing
    // at whatever it pointed at before, which is why html.js-open switches the
    // :target rules off and inline display decides instead.
    function openFile(a, push) {
      if (!a) return;
      const id = idOf(a);
      for (const w of wins) w.style.display = w.id === id ? 'flex' : 'none';
      for (const l of links) {
        const on = l === a;
        l.classList.toggle('is-open', on);
        if (on) l.setAttribute('aria-current', 'true');
        else l.removeAttribute('aria-current');
      }
      if (push && location.hash !== a.getAttribute('href')) {
        history.pushState(null, '', a.getAttribute('href'));
      }
      reveal(a);
    }

    for (const a of links) {
      a.addEventListener('click', (e) => {
        // A modified click is a request for a new tab, not for this.
        if (e.button !== 0 || e.metaKey || e.ctrlKey || e.shiftKey || e.altKey) return;
        e.preventDefault();
        openFile(a, true);
        // Focus says the region changed, for anyone not watching the pointer.
        // preventScroll, because moving the page is the whole thing being fixed.
        const win = document.getElementById(idOf(a));
        if (win) win.focus({ preventScroll: true });
      });
    }

    // Back, forward, and a hash typed into the bar. popstate covers our own
    // pushState history; hashchange covers a fragment edited by hand.
    const sync = () => openFile(linkFor(location.hash) || links[0], false);
    window.addEventListener('popstate', sync);
    window.addEventListener('hashchange', sync);
    sync();
  </script>
</Layout>

<style>
  /* The pinned column. .hero-left gives the 100vh box, the 36px padding and the
     top/bottom split; this only pins it, the way .app-rail pins the other side
     of the landing page. height rather than min-height because the part of a
     pinned element below the fold cannot be reached. */
  .side {
    position: sticky;
    top: 0;
    height: 100vh;
  }

  .page-title {
    font-family: var(--round);
    font-size: 27px;
    font-weight: 600;
    letter-spacing: -0.02em;
    margin-top: 2px;
  }
  .mark a { color: var(--text-50); }
  .mark a:hover { color: var(--text); }

  /* The file list takes what the intro leaves and scrolls inside itself rather
     than growing the column past the viewport.
     Eighteen files do not fit a short window and will never fit, so the list
     has to say so. It does it twice over: a thin scrollbar, and a fade at
     whichever end still has more behind it. A list that simply stops at the
     edge of its box reads as a list that ended. */
  .files {
    --fade: 30px;
    --top-fade: 0px;
    --bot-fade: 0px;
    min-height: 0;
    overflow-y: auto;
    /* Explicit, and not just left to the default: setting overflow-y alone
       computes the other axis to auto, so a row a pixel too wide would give the
       list a horizontal scrollbar of its own. There is nothing to see sideways
       in a list of filenames. */
    overflow-x: hidden;
    overscroll-behavior: contain;
    padding-top: 30px;
    scrollbar-width: thin;
    scrollbar-color: rgba(128, 128, 128, 0.4) transparent;
    /* Set to 0 by default, so with the script absent (or the list short enough)
       the mask is a hard edge at both ends: no fade, nothing clipped. */
    -webkit-mask-image: linear-gradient(
      to bottom,
      transparent 0, #000 var(--top-fade),
      #000 calc(100% - var(--bot-fade)), transparent 100%
    );
    mask-image: linear-gradient(
      to bottom,
      transparent 0, #000 var(--top-fade),
      #000 calc(100% - var(--bot-fade)), transparent 100%
    );
  }
  .files .head { color: var(--text-50); margin-bottom: 10px; }
  .files ol { list-style: none; }
  /* Tight enough that all eighteen fit a normal window without scrolling. The
     list is an index, not reading matter: its job is to be scannable in one
     look, and a row does not need the leading of a paragraph to manage that.
     The scroll and its fades stay for the windows too short to hold them. */
  .files a {
    display: grid;
    grid-template-columns: 1fr auto;
    gap: 12px;
    align-items: baseline;
    padding: 2px 8px;
    margin: 0 -8px;
    border-radius: 5px;
    line-height: 1.45;
  }
  .files a:hover { background: var(--grid); }
  /* A visible ring for the keyboard, and only for the keyboard: tabbing the
     list is the other way through it and it should not be invisible. */
  .files a:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 1px;
  }
  .fname { font-family: var(--mono); font-size: 12px; color: var(--text-70); }
  .fdate { font-size: 11.5px; color: var(--text-50); }
  /* Hover is the only state that can be stated without knowing which file is
     open. The open row itself has two rules, for the two paths: the generated
     :target ones above when there is no script, and these when there is. */
  .files a:hover .fname { color: var(--text); }
  .files a.is-open { background: rgba(128, 128, 128, 0.14); }
  .files a.is-open .fname { color: var(--text); }

  /* ==========================================================================
     The frame. .app-rail and .app-frame are the landing page's, so the window
     is the same size, in the same place, snapped to the same cells. All 18
     windows are stacked in it and :target picks one, which keeps every release
     in the HTML for anything that reads the page rather than looks at it.
     ========================================================================== */
  /* A preview window, not the whole app: 16 x 17 cells, portrait, which is the
     shape a document window actually has. Both are whole cells, so all four
     edges land on grid lines. This overrides .app-frame's own
     round(min(100%, --app-max-w)) sizing, which is the real app's dimensions
     and belongs to the page that draws the real app.
     The script centres it in the rail; without the script it stays here, at
     the rail's top left. */
  .app-frame {
    position: relative;
    width: min(100%, 576px);
    height: min(100%, 612px);
    /* global.css eases .app-frame's width and height, which is right on the
       landing page: there they only change when the viewport does. Here a
       resize gesture changes them on every pointermove, so each frame
       re-targets a 200ms ease and the corner trails the pointer by a fifth of
       a second. The gesture has to be instant; the ease belongs to the settle,
       and .settling below is the only place it comes back. */
    transition: none;
  }
  .app-frame > :global(.win) {
    position: absolute;
    inset: 0;
    display: none;
  }
  .app-frame > :global(.win:target) { display: flex; }
  /* Arriving with no hash: the newest release is open. */
  .app-frame:not(:has(:target)) > :global(.win[data-latest]) { display: flex; }

  /* ---- drag and resize ----------------------------------------------------
     Both are progressive enhancement: with no JavaScript the window keeps the
     size and place the stylesheet gives it, which is a working page. */
  .app-frame > :global(.win .tb) { cursor: grab; }
  :global(body.dragging-app) .app-frame > :global(.win .tb) { cursor: grabbing; }

  /* Only while settling, so a gesture tracks the pointer to the pixel and only
     the last hop onto the grid is animated. */
  .app-frame.settling {
    transition:
      width 0.18s cubic-bezier(0.3, 0.9, 0.3, 1),
      height 0.18s cubic-bezier(0.3, 0.9, 0.3, 1),
      transform 0.18s cubic-bezier(0.3, 0.9, 0.3, 1);
  }
  /* The open window carries a 80px-blur drop shadow, which is a real repaint to
     move. Promoting the frame for the length of the gesture (and only that
     long: a permanent will-change keeps the layer alive for nothing) is what
     keeps a drag on one frame. */
  .app-frame.gesturing { will-change: transform, width, height; }

  /* global.css turns .app-frame's transitions off for reduced motion; .settling
     above would put them back, so it has to opt out too. */
  @media (prefers-reduced-motion: reduce) {
    .app-frame.settling { transition: none; }
  }

  /* Opening a file focuses its window (see the script). That focus is
     programmatic, so a ring on a pointer click would be noise; after Enter on
     the link it is exactly what a keyboard user needs, and :focus-visible is
     the one that can tell those apart. */
  .app-frame > :global(.win:focus:not(:focus-visible)) { outline: none; }
  .app-frame > :global(.win:focus-visible) {
    outline: 2px solid var(--accent);
    outline-offset: 2px;
  }

  /* The handles straddle the edge rather than sitting inside it, the way a real
     window's do: a few pixels of grab room on the outside is what stops the
     resize from being a game of hitting a 1px border. The frame does not clip,
     so the overhang costs nothing. */
  .rz {
    position: absolute;
    z-index: 6;
    touch-action: none;
  }
  /* Sides stop short of the corners so the corner handles keep their own room. */
  .rz-n, .rz-s { left: 16px; right: 16px; height: 9px; cursor: ns-resize; }
  .rz-n { top: -4px; }
  .rz-s { bottom: -4px; }
  .rz-e, .rz-w { top: 16px; bottom: 16px; width: 9px; cursor: ew-resize; }
  .rz-e { right: -4px; }
  .rz-w { left: -4px; }
  /* Above the sides, so the overlap at each corner resolves to the corner. */
  .rz-ne, .rz-nw, .rz-se, .rz-sw { width: 20px; height: 20px; z-index: 7; }
  .rz-ne { top: -4px; right: -4px; cursor: nesw-resize; }
  .rz-nw { top: -4px; left: -4px; cursor: nwse-resize; }
  .rz-se { bottom: -4px; right: -4px; cursor: nwse-resize; }
  .rz-sw { bottom: -4px; left: -4px; cursor: nesw-resize; }

  /* Nothing is drawn on any of them, the way macOS draws nothing. The cursor
     changing as you cross an edge is the affordance, and it is the one every
     window on the machine already uses. */

  /* The cursor has to survive leaving the handle mid-drag, so it goes on the
     body; which cursor depends on the edge, hence the variable. */
  :global(body.resizing-win),
  :global(body.resizing-win) * {
    cursor: var(--rz-cursor, nwse-resize) !important;
    user-select: none;
  }

  /* Stacked. The window is a desktop conceit: on a phone it stops being a
     picture of an app and becomes 18 boxes to scroll past, so they flow as
     ordinary cards and all of them are open at once. .app-rail's own narrow
     rules are the landing page's (a 468px tall, pointer-inert window) and have
     to be undone here. */
  @media (max-width: 900px) {
    .side { position: static; height: auto; }
    /* overflow, not overflow-y. Both of these carry overflow-x: hidden from
       their base rules, and a `visible` on one axis paired with anything else
       on the other computes to `auto`: they would stay scroll containers, still
       carrying overscroll-behavior: contain, and swallow the page's scroll
       instead of passing it on. Nothing here scrolls but the page. */
    .files {
      overflow: visible;
      overscroll-behavior: auto;
      padding-top: 0;
    }
    .app-rail {
      position: static;
      height: auto;
      /* A cell either side, so the window is inset from both edges rather than
         bleeding off the right. */
      padding: 0 36px 0 36px;
      pointer-events: auto;
    }
    .app-frame { width: 100%; height: auto; }
    /* relative, not static: the titlebar is absolute now and needs this to be
       its containing block. Relative is still in flow, so the stacking works. */
    .app-frame > :global(.win) {
      position: relative;
      display: flex;
      height: auto;
      margin-bottom: 36px;
    }
    /* Back into flow, so the document is what gives the window its height
       instead of the window capping the document, and with no scrolling of its
       own at all: see the note on .files above for why overflow-y alone would
       leave it a scroll container. */
    .app-frame > :global(.win .doc-body) {
      position: static;
      overflow: visible;
      overscroll-behavior: auto;
    }
    /* Nothing scrolls inside a window here, so there is nothing to indicate. */
    .app-frame > :global(.win .sb) { display: none; }
  }
