---
// Agents: who needs you, as it happens. The desktop's corner: a window on the
// left, and where macOS puts notifications on the right. The chapters are the
// moments (scripts/scenes.ts): at work, stopped for permission, one shortcut
// to get there, answered.
import Stage from '../Stage.astro';
import Sidebar from '../../app/gen/Sidebar.astro';
import TerminalNarrow from '../../app/gen/TerminalNarrow.astro';

const chapters = [
  { label: 'At work', caption: 'Output that keeps moving is an agent at work. Nothing is installed into it to know that.' },
  { label: 'Needs you', caption: 'A screen gone still is a question. The session gets a dot, and a notification finds you.' },
  { label: 'Go to it', keys: '⌥⇧⌘↓', caption: 'One shortcut jumps to the next session that is waiting.' },
  { label: 'Answered', keys: '⏎', caption: 'Say yes, and it is back at work. The dot is gone.' },
];
---
<section class="sec" id="coding-agents">
  <div class="page">
    <div class="bhead" data-reveal>
      <h2 class="h2">Know which agent needs you. <span class="tone">Hand one repository to Claude Code, another to Codex, a third to Aider. Wortel reads the screen and marks what is working and what is waiting.</span></h2>
    </div>
    <Stage film="agents" chapters={chapters} at="86% 64%" zoom="210%" w={744} h={600} class="corner">
      <div class="desk" aria-hidden="true">
        <div class="win wapp" inert>
          <div class="absolute inset-0 bg-sidebar backdrop-blur-[50px] backdrop-saturate-[1.8]"></div>
          <div class="relative flex size-full">
            <div class="flex w-[234px] shrink-0"><Sidebar /></div>
            <div class="w-px shrink-0 bg-sidebar-border"></div>
            <div class="flex min-w-0 flex-1"><TerminalNarrow /></div>
          </div>
        </div>
        <div class="notes">
          <div class="note" data-note>
            <img src="/icon-128.png" width="40" height="40" alt="" />
            <div class="txt">
              <p class="ttl"><b>Landing page hero</b><span>now</span></p>
              <p class="msg">Claude wants to run <span class="mono">npm run build</span></p>
            </div>
          </div>
        </div>
        <div class="keys glass" data-keys="jump"><kbd>⌥</kbd><kbd>⇧</kbd><kbd>⌘</kbd><kbd>↓</kbd></div>
        <div class="keys glass" data-keys="enter"><kbd>⏎</kbd></div>
      </div>
    </Stage>
  </div>
</section>

<style>
  /* The window stands to the left; notifications arrive top right, as on a Mac. */
  .desk { position: relative; width: 100%; display: flex; justify-content: flex-start; gap: 24px; }
  .notes { flex: 1; min-width: 0; display: flex; justify-content: flex-end; align-items: flex-start; }
  .note {
    width: min(344px, 100%);
    display: flex; gap: 8px; align-items: center; padding: 12px 16px 12px 12px;
    border-radius: 18px;
    background: rgb(246 246 246 / 0.8);
    backdrop-filter: blur(24px) saturate(1.8); -webkit-backdrop-filter: blur(24px) saturate(1.8);
    box-shadow: 0 0 0 0.5px rgb(0 0 0 / 0.12), 0 8px 24px rgb(0 0 0 / 0.14);
    font-family: var(--font-sans); color: #1d1d1f;
    opacity: 0;
  }
  .note img { width: 40px; height: 40px; flex: none; }
  .note p { margin: 0; }
  .txt { flex: 1; min-width: 0; }
  .ttl { display: flex; justify-content: space-between; font-size: 13px; line-height: 16px; }
  .ttl span { opacity: 0.5; font-size: 12px; }
  .msg { font-size: 13px; line-height: 16px; opacity: 0.8; }
  .msg .mono { font-size: 12px; }
  .keys { right: 0; bottom: 0; }
  @media (prefers-color-scheme: dark) {
    .note { background: rgb(44 44 44 / 0.8); color: #f5f5f7; box-shadow: 0 0 0 0.5px rgb(255 255 255 / 0.14), 0 8px 24px rgb(0 0 0 / 0.4); }
  }
  @media (max-width: 1000px) {
    .notes { position: absolute; right: 0; top: 16px; z-index: 3; }
    .keys { right: 16px; bottom: 16px; }
  }
  @media (max-width: 760px) { .notes { right: 32px; } .note { width: 296px; } .keys { right: 32px; } }
</style>
