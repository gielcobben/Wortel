---
// A statement whose words light up as it scrolls past (scripts/sections.ts).
const text = 'Wortel is written in Swift and AppKit around Ghostty’s own engine. No Electron, no web view, no settings window. It opens in a blink, draws on Metal, and looks like it came with your Mac.';
const words = text.split(' ');
---
<section class="statement section" id="what-is-wortel">
  <div class="page">
    <p class="eyebrow" data-reveal>Native, at the root</p>
    <p class="big" data-lit>
      {words.map((w) => <span>{w} </span>)}
    </p>
  </div>
</section>
<style>
  .statement { padding-block: 200px 160px; }
  .big {
    margin: 24px 0 0; max-width: 1000px;
    font-family: var(--font-display); font-weight: 600;
    font-size: clamp(32px, 4vw, 56px); line-height: 1.12; letter-spacing: -0.03em;
    text-wrap: pretty;
  }
  .big span { color: var(--ink); }
  :global(.js) .big span { color: var(--fog-3); transition: color 0.3s; }
  :global(.js) .big span.lit { color: var(--ink); }
</style>
