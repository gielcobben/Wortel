---
// Splits on the homepage: the section's words (HOME.window in data/site.ts)
// over the splits film (components/films/PanesFilm.astro), with a link to the
// page that shows everything a window's layout does (/layouts).
import Section from '../Section.astro';
import { HOME } from '../../data/site';
import PanesFilm from '../films/PanesFilm.astro';
---
<Section id="splits" {...HOME.window}>
  <Fragment slot="anchors"><span id="panes" class="anchor"></span><span id="sessions" class="anchor"></span></Fragment>
  <PanesFilm />
</Section>
