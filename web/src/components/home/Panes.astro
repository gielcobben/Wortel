---
// The window, explained by the ways people arrange it.
//
// One live window built from the canvas's pane library. Its chapters are
// arrangements you would actually use, named for what you are doing rather
// than for the panes involved; scripts/panes.ts moves the window from one to
// the next the way the app does it, a place at a time. The window is never
// scaled.
import Stage from '../Stage.astro';
import Sidebar from '../../app/gen/Sidebar.astro';
import TerminalNarrow from '../../app/gen/TerminalNarrow.astro';
import FileMain from '../../app/gen/FileMain.astro';
import Browser from '../../app/gen/Browser.astro';
import Changes from '../../app/gen/Changes.astro';
import History from '../../app/gen/History.astro';
import Files from '../../app/gen/Files.astro';
import BottomStrip from '../../app/gen/BottomStrip.astro';

const chapters = [
  { label: 'Everything', caption: 'Four places: the sidebar, the main area, a side column and a bottom strip. Each has its own tabs.' },
  { label: 'Reviewing', caption: 'The commits and their graph in the column, beside the agent that made them.' },
  { label: 'Previewing', caption: 'A browser in the main area, with the dev server in the strip under it.' },
  { label: 'Reading', caption: 'Any file opens in a tab: source, rendered Markdown, or Quick Look for the rest.' },
  { label: 'Quiet', keys: '⌘B ⌥⌘B ⌘J', caption: 'Three keys fold the rest away. What is left is a very good terminal.' },
];
---
<section id="panes" class="sec">
  <span id="sessions" class="anchor"></span><span id="git-and-files" class="anchor"></span>
  <div class="page">
    <div class="bhead" data-reveal>
      <h2 class="h2">One window, four places. <span class="tone">Each place holds what you put there, or nothing at all. Nothing is fixed, and there is no layout to configure.</span></h2>
    </div>
    <Stage film="panes" chapters={chapters} at="12% 78%" zoom="170%" w={1040} h={616}>
      <div class="win wapp" data-pwin aria-hidden="true" inert>
        <div class="absolute inset-0 bg-sidebar backdrop-blur-[50px] backdrop-saturate-[1.8]"></div>
        <div class="relative flex size-full">
          <div class="slot sb" data-slot="sidebar">
            <div class="pane" data-pane="sidebar"><Sidebar /></div>
          </div>
          <div class="divider" data-div="sidebar"></div>
          <div class="mainarea">
            <div class="slot main" data-slot="main">
              <div class="pane" data-pane="terminal"><TerminalNarrow /></div>
              <div class="pane" data-pane="file"><FileMain /></div>
              <div class="pane" data-pane="browser"><Browser /></div>
            </div>
            <div class="slot strip" data-slot="strip">
              <div class="pane" data-pane="strip"><BottomStrip /></div>
            </div>
          </div>
          <div class="divider" data-div="side"></div>
          <div class="slot side" data-slot="side">
            <div class="pane" data-pane="changes"><Changes /></div>
            <div class="pane" data-pane="history"><History /></div>
            <div class="pane" data-pane="files"><Files /></div>
          </div>
        </div>
        <div class="lights">
          <img src="/app/3ef4fc84971102ffed5f4a10ada4399c.png" alt="" width="16" height="16" />
          <img src="/app/d1dbbe84aaf8f948789bed8b07c2622c.png" alt="" width="16" height="16" />
          <img src="/app/ebeda5316137eb91580afb0a92bd4f45.png" alt="" width="16" height="16" />
        </div>
      </div>
    </Stage>
  </div>
</section>

<script>
  import { initPanes } from '../../scripts/panes';
  initPanes();
</script>

<style>
  .win :global([data-pane="browser"] img[data-name="Web page"]) { object-position: 50% 0; }

  /* Slots, sized the way the app's split views are (minimums from the source). */
  .slot { position: relative; display: grid; min-height: 0; min-width: 0; overflow: hidden; }
  .slot > * { grid-area: 1 / 1; min-width: 0; min-height: 0; }
  .sb { width: 234px; flex: none; }
  .mainarea { display: flex; flex-direction: column; flex: 1; min-width: 80px; min-height: 0; }
  .main { flex: 1; min-height: 80px; }
  .strip { flex: none; height: 168px; min-height: 0; }
  .side { width: 336px; flex: none; }
  .divider { width: 1px; flex: none; background: var(--sidebar-border); align-self: stretch; }
  .pane { display: flex; }
  /* A folding slot clips its pane, the way a split view does, instead of
     reflowing it through every width on the way to zero. */
  .sb .pane { min-width: 234px; }
  .side .pane { min-width: 336px; }
  .strip .pane { min-height: 168px; }
  .pane > :global(*) { flex: 1; }
  .pane:not(:first-child) { visibility: hidden; opacity: 0; }

  /* The window owns the traffic lights, as AppKit does; the pane's copy hides. */
  .lights { position: absolute; left: 11px; top: 12px; display: flex; gap: 7px; z-index: 5; }
  .lights img { width: 16px; height: 16px; }
  .win :global([data-pane="sidebar"] [data-name="Traffic lights"]) { visibility: hidden; }
</style>
