---
// The close of every page: a photo with the icon and the download on it,
// then the links, on the same container and grid as everything above.
import { SITE, FEATURE_PAGES } from '../data/site';
import GitHubMark from './GitHubMark.astro';
import { photo as crop } from '../data/photo';
interface Props { bare?: boolean }
const { bare = false } = Astro.props;
// Each page closes on its own photo (README, Photos), so going from page to
// page never ends on the same picture twice: [photo, which part, how far in].
// The words sit top left, so each crop keeps fog there, never a dark hill.
const here = Astro.url.pathname.replace(/\/$/, '') || '/';
const closing: Record<string, [string, string, number]> = {
  '/': ['lake', '50% 38%', 1],
  '/updates': ['skye', '50% 60%', 1],
  '/docs': ['haze', '50% 70%', 1],
  '/compare': ['hills', '0% 0%', 1.3],
  '/about': ['haze', '0% 45%', 1.6],
  '/mark-up': ['skye', '50% 60%', 1],
  '/layouts': ['haze', '50% 70%', 1],
  '/learn': ['hills', '0% 0%', 1.3],
};
// A release's page closes like the changelog it belongs to.
const [photo, at, zoom] = closing[here] ?? closing['/' + here.split('/')[1]] ?? closing['/'];
const cols: [string, [string, string][]][] = [
  ['Wortel', [['Download', '/download'], ['Learn', '/learn'], ...FEATURE_PAGES.map((p): [string, string] => [p.name, p.path]), ['Changelog', '/updates'], ['Docs', '/docs'], ['Compare', '/compare']]],
  ['More', [['About', '/about'], ['GitHub', SITE.repo], ['Changelog feed', '/feed.xml'], ['Newsletter', '/letter'], ['llms.txt', '/llms.txt']]],
  ['Legal', [['Privacy', '/privacy'], ['Terms', '/terms']]],
];
---
<footer class="foot">
  {!bare && (
    <section class="sec page">
      <div class="stage cta" data-photo style={crop(photo, at, zoom)} data-reveal>
        <img src="/icon-256.png" width="80" height="80" alt="" loading="lazy" />
        <h2 class="h2">Put down roots. <span class="tone">Free for macOS {SITE.minMacOS} {SITE.minMacOSName} or later, and it updates itself.</span></h2>
        <div class="go">
          <a class="btn" href="/download#footer">Download for macOS</a>
          <a class="btn ghost" href={SITE.repo} target="_blank" rel="noopener"><GitHubMark />GitHub</a>
        </div>
      </div>
    </section>
  )}
  <div class="page">
    <div class="grid12 links">
      <div class="sig">
        <a class="brand tap" href="/"><img src="/icon-128.png" width="24" height="24" alt="" /><span>Wortel</span></a>
        <p class="small">Wortel is Dutch for root.</p>
      </div>
      {cols.map(([h, items]) => (
        <div class="col">
          <p class="label">{h}</p>
          <ul>{items.map(([t, href]) => <li><a href={href} target={href.startsWith('http') ? '_blank' : undefined} rel={href.startsWith('http') ? 'noopener' : undefined}>{t}</a></li>)}</ul>
        </div>
      ))}
    </div>
    <div class="base">
      <p class="label">© {new Date().getFullYear()} <a class="link" href={SITE.authorUrl}>{SITE.author}</a></p>
      <p class="label">Built on <a class="link" href="https://ghostty.org">Ghostty</a></p>
    </div>
  </div>
</footer>

<style>
  .foot { padding-bottom: 40px; }
  .cta { min-height: 480px; padding: 48px; align-items: flex-start; gap: 0; }
  /* Fog over the top of the photo, so the words always have something to sit on. */
  .cta { --over: linear-gradient(color-mix(in srgb, var(--fog-0) 88%, transparent), transparent 75%); }
  .cta > * { position: relative; }
  .cta .h2 { max-width: 560px; margin-top: 32px; }
  .cta .tone { color: var(--ink-2); }
  .cta .go { display: flex; align-items: center; gap: 16px 8px; margin-top: 32px; flex-wrap: wrap; }
  /* On the photo the second button is the page's fog, so it reads on any crop. */
  .cta .btn.ghost { background: var(--fog-0); }
  .links { margin-top: 96px; padding-top: 48px; border-top: 1px solid var(--line); row-gap: 40px; }
  .sig { grid-column: span 6; display: flex; flex-direction: column; gap: 16px; }
  .col { grid-column: span 2; }
  .brand { display: inline-flex; align-self: flex-start; align-items: center; gap: 8px; font: 600 17px/24px var(--font-display); letter-spacing: -0.02em; color: var(--ink); }
  .col ul { list-style: none; padding: 0; margin: 16px 0 0; display: flex; flex-direction: column; gap: 8px; }
  .col a { font-size: 14px; line-height: 24px; color: var(--ink-2); transition: color 200ms ease; }
  @media (hover: hover) and (pointer: fine) { .col a:hover { color: var(--ink); } }
  .base { display: flex; justify-content: space-between; gap: 16px; margin-top: 64px; flex-wrap: wrap; }
  /* Under a finger each link is a row of its own height. */
  @media (pointer: coarse) { .col ul { gap: 0; margin-top: 8px; } .col a { display: block; padding-block: 8px; } }
  @media (max-width: 800px) {
    .cta { padding: 32px 24px; min-height: 440px; }
    /* A stage this narrow is taller than the photo's shape, so the photo
       fills its height and the part behind the words is whatever lies there
       (a dark hill, on /compare). The fog holds through the words first. */
    .cta { --over: linear-gradient(color-mix(in srgb, var(--fog-0) 88%, transparent) 48%, transparent 88%); }
    .sig { grid-column: 1 / -1; }
    .col { grid-column: span 4; }
  }
</style>
