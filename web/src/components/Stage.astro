---
// A stage: a part of the foggy lake, a window (or whatever the slot holds)
// standing on it, and, when the scene has chapters, the bar that runs it:
// chapter tabs, the current chapter's caption, play/pause. scripts/film.ts
// drives it.
export interface Chapter { label: string; caption: string; keys?: string }
interface Props {
  /** The scene's name: scripts find the stage by [data-film="name"]. */
  film?: string;
  chapters?: Chapter[];
  /** Said when the reader arranges something no chapter covers. */
  own?: string;
  /** Which part of the photo: a background-position, and how far in. */
  at?: string;
  zoom?: string;
  /** The window's size, in the app's own points. */
  w?: number;
  h?: number;
  /** Fade up the first time it comes on screen (the hero brings itself in). */
  reveal?: boolean;
  class?: string;
}
const { film, chapters = [], own, at = '50% 62%', zoom = 'cover', w = 1104, h = 664, reveal = true, class: cls } = Astro.props;
---
<div class:list={['stage', cls]} data-film={film} data-reveal={reveal ? '' : undefined} style={`--at:${at};--zoom:${zoom};--w:${w}px;--h:${h}px`}>
  {chapters.length > 0 && (
    <div class="bar glass">
      <div class="chapters" role="tablist" aria-label="Chapters">
        <span class="thumb still" aria-hidden="true"></span>
        {chapters.map((c, i) => (
          <button type="button" role="tab" data-chapter={i} aria-selected={i === 0 ? 'true' : 'false'} tabindex={i === 0 ? 0 : -1}>{c.label}</button>
        ))}
      </div>
      <div class="say" aria-live="polite">
        {chapters.map((c, i) => (
          <p class:list={{ on: i === 0 }} data-caption={i}>{c.keys && <kbd>{c.keys}</kbd>}{c.caption}</p>
        ))}
        {own && <p data-caption="own">{own}</p>}
      </div>
      <button type="button" class="play" data-play aria-label="Pause" aria-pressed="false">
        <svg class="i-pause" width="12" height="14" viewBox="0 0 12 14" aria-hidden="true"><rect x="1" y="1" width="3.5" height="12" rx="1" fill="currentColor"/><rect x="7.5" y="1" width="3.5" height="12" rx="1" fill="currentColor"/></svg>
        <svg class="i-play" width="12" height="14" viewBox="0 0 12 14" aria-hidden="true"><path d="M2.5 1.6v10.8a.6.6 0 0 0 .9.5l8.4-5.4a.6.6 0 0 0 0-1L3.4 1.1a.6.6 0 0 0-.9.5z" fill="currentColor"/></svg>
      </button>
    </div>
  )}
  <div class="set"><slot /></div>
</div>
