---
import '../styles/app.css';
import '../styles/site.css';
import Analytics from '../components/Analytics.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import { SITE } from '../data/site';

interface Props {
  title?: string;
  description?: string;
  /** Path of this page, leading slash. Canonical + og:url are built from it. */
  path?: string;
  /** JSON-LD graph nodes. Rendered as one @graph so crawlers see one document. */
  schema?: unknown[];
  /** The nav starts transparent over a hero photo and turns solid on scroll. */
  overHero?: boolean;
  /** Leave out the footer's closing call to download. */
  bare?: boolean;
}

const {
  title = SITE.title,
  description = SITE.description,
  path = '/',
  schema = [],
  overHero = false,
  bare = false,
} = Astro.props;

// Built off the configured `site` rather than Astro.url, so a preview host or a
// wrangler dev origin can never emit a canonical pointing at itself.
const canonical = new URL(path, SITE.url).href;
const ogImage = new URL('/og.png', SITE.url).href;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="generator" content={Astro.generator} />

    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1" />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={SITE.name} />
    <meta property="og:locale" content="en_US" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:type" content="image/png" />
    <meta property="og:image:alt" content={`${SITE.name}: ${SITE.tagline}`} />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <meta name="twitter:image:alt" content={`${SITE.name}: ${SITE.tagline}`} />

    <meta name="apple-mobile-web-app-title" content={SITE.name} />
    <meta name="theme-color" media="(prefers-color-scheme: dark)" content="#0e0e0c" />
    <meta name="theme-color" media="(prefers-color-scheme: light)" content="#fbfaf7" />

    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/favicon-96.png" type="image/png" sizes="96x96" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="preconnect" href="https://updates.wortel.sh" crossorigin />

    <link rel="alternate" type="text/plain" href="/llms.txt" title="llms.txt: a site map for language models" />
    <link rel="describedby" type="text/markdown" href="/llms-full.txt" title="Full page content as Markdown" />

    {schema.length > 0 && (
      <script
        type="application/ld+json"
        set:html={JSON.stringify({ '@context': 'https://schema.org', '@graph': schema })}
      />
    )}

    <!-- Reveal-on-enter hides content until it is on screen. Only with JS, so
         a reader without it, or a crawler, sees everything. -->
    <script is:inline>document.documentElement.classList.add('js')</script>

    <slot name="head" />
    <Analytics />
  </head>
  <body>
    <Nav overHero={overHero} />
    <main id="top">
      <slot />
    </main>
    <Footer bare={bare} />
    <script>
      import '../scripts/reveal';
    </script>
  </body>
</html>
