---
// Agents: the sidebar as the thing that tells you who needs you. The pane is
// the real one from the canvas at 1:1; scripts/sections.ts runs a small loop
// on it while it is on screen: a session starts working, goes still, asks for
// permission, and a notification comes in.
import Sidebar from '../../app/gen/Sidebar.astro';
import TerminalNarrow from '../../app/gen/TerminalNarrow.astro';
---
<section class="agents section" id="agents">
  <div class="page grid">
    <div class="copy" data-reveal-group>
      <p class="eyebrow" data-reveal>Agents</p>
      <h2 class="h2" data-reveal>Know which one<br /><span class="tone">needs you.</span></h2>
      <p class="body" data-reveal>
        Hand one repository to Claude Code, another to Codex, a third to Aider. Wortel reads the screen: output that keeps moving is an agent working, a screen gone still is one waiting on you. Where an agent announces itself, Wortel takes its word for it. Where it says nothing, Wortel still knows.
      </p>
      <ul class="legend" data-reveal>
        <li><span class="dots"><i></i><i></i><i></i></span><span><b>Working.</b> Output is still moving.</span></li>
        <li><span class="dot orange"></span><span><b>Wants you.</b> A question, a permission, a stop.</span></li>
        <li><span class="dot mint"></span><span><b>Finished.</b> Done, and you have not looked yet.</span></li>
      </ul>
      <p class="small" data-reveal><kbd>⌥⇧⌘↓</kbd> &nbsp;jumps to the next session that is waiting.</p>
    </div>

    <div class="visual" data-agents data-reveal>
      <div class="desk">
        <div class="wapp dark side">
          <div class="absolute inset-0 bg-sidebar backdrop-blur-[50px] backdrop-saturate-[1.8]"></div>
          <div class="relative flex size-full">
            <div class="flex w-[234px] shrink-0"><Sidebar /></div>
            <div class="w-px shrink-0 bg-sidebar-border"></div>
            <div class="flex min-w-0 flex-1"><TerminalNarrow /></div>
          </div>
          <div class="pointer-events-none absolute inset-0 rounded-[18px] shadow-[inset_0_0_0_0.5px_rgb(255_255_255/0.1)]"></div>
        </div>
        <div class="note" data-note aria-hidden="true">
          <img src="/brand/wortel-icon.svg" width="40" height="40" alt="" />
          <div class="txt">
            <p class="ttl"><b>Landing page hero</b><span>now</span></p>
            <p class="msg">Claude wants to run <span class="mono">npm run build</span></p>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .grid { display: grid; grid-template-columns: 5fr 7fr; gap: 64px; align-items: center; }
  .copy { display: flex; flex-direction: column; gap: 24px; }
  .copy .h2 { margin: 0; }
  .copy .body { margin: 0; }
  .legend { list-style: none; padding: 0; margin: 8px 0 0; display: flex; flex-direction: column; gap: 16px; }
  .legend li { display: grid; grid-template-columns: 32px 1fr; align-items: center; font-size: 15px; line-height: 24px; color: var(--ink-2); }
  .legend b { color: var(--ink); font-weight: 600; }
  .dots { display: inline-flex; gap: 3px; }
  .dots i { width: 4px; height: 4px; border-radius: 50%; background: var(--ink-3); animation: blink 1.2s infinite; }
  .dots i:nth-child(2) { animation-delay: 0.2s; } .dots i:nth-child(3) { animation-delay: 0.4s; }
  @keyframes blink { 50% { opacity: 0.25; } }
  .dot { width: 8px; height: 8px; border-radius: 50%; }
  .dot.orange { background: #ff9f0a; } .dot.mint { background: #63e6e2; }

  .visual { position: relative; }
  .desk {
    position: relative; height: 640px; border-radius: 24px; overflow: hidden;
    background: url(/img/lake-1600.jpg) 30% 70% / cover;
  }
  @media (prefers-color-scheme: dark) { .desk { background-image: linear-gradient(rgb(14 14 12 / 0.55), rgb(14 14 12 / 0.55)), url(/img/lake-1600.jpg); } }
  .side {
    position: absolute; left: 48px; top: 96px; display: flex; width: 900px; height: 640px;
    border-radius: 18px; overflow: hidden;
    box-shadow: var(--shadow-window);
  }
  .note {
    position: absolute; z-index: 2; top: 32px; right: 32px; width: 344px;
    display: flex; gap: 8px; align-items: center; padding: 12px 16px 12px 8px;
    border-radius: 18px;
    background: rgb(246 246 246 / 0.72);
    backdrop-filter: blur(24px) saturate(1.8); -webkit-backdrop-filter: blur(24px) saturate(1.8);
    box-shadow: 0 0 0 0.5px rgb(0 0 0 / 0.12), 0 8px 24px rgb(0 0 0 / 0.12);
    font-family: var(--font-sans); color: #1d1d1f;
    opacity: 0; transform: translateX(380px);
  }
  .note img { width: 40px; height: 40px; flex: none; }
  .note p { margin: 0; }
  .ttl { display: flex; justify-content: space-between; font-size: 13px; line-height: 16px; }
  .ttl span { color: rgb(0 0 0 / 0.45); font-size: 12px; }
  .msg { font-size: 13px; line-height: 16px; color: rgb(0 0 0 / 0.75); }
  .msg .mono { font-size: 12px; }
  @media (max-width: 900px) {
    .grid { grid-template-columns: 1fr; }
    .note { right: 16px; width: 300px; }
  }
</style>
