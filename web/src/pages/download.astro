---
// /download: the button and the four steps after it, nothing else. Every
// Download button on the site leads here and says where it was (/download#hero,
// #nav, #footer, #404), and arriving that way starts the download at once, so
// nobody gets a disk image without the steps that say what to do with it. A visit
// with no such mark (a search result, a reload, the back button) only shows
// the button.
//
// On a phone or a tablet there is nothing to install, and a Mac app in its
// Downloads is no use to anyone. There the button sends this page on instead
// (the share sheet, so AirDrop to the Mac is one tap; where there is no
// sheet it copies the link), nothing starts by itself, and the download
// stays one small link away for whoever does want it there.
//
// The version line comes from the Sparkle feed (data/release.ts). Notes,
// requirements and file locations live on /updates and /docs; this page
// only gets the app onto the Mac.
import Layout from '../layouts/Layout.astro';
import { SITE, INSTALL_STEPS } from '../data/site';
import { latestRelease } from '../data/release';
import { photo } from '../data/photo';

const latest = await latestRelease();

const macOS = `macOS ${SITE.minMacOS} ${SITE.minMacOSName} or later`;
const abs = (p: string) => new URL(p, SITE.url).href;
const title = `Download ${SITE.name} for macOS`;
const description = `Download ${SITE.name}, the native macOS terminal for coding agents. Free, signed and notarized, one app for Apple silicon and Intel, ${macOS}.`;
const schema = [{
  '@type': 'WebPage', '@id': abs('/download#webpage'), url: abs('/download'), name: title, description,
  isPartOf: { '@id': abs('/#website') }, about: { '@id': abs('/#app') }, inLanguage: 'en',
}];

---
<Layout title={title} description={description} path="/download" schema={schema} ogImage="/og/download.png" bare>
  <header class="page phead" data-reveal-group>
    <img class="icon" src="/icon-256.png" width="96" height="96" alt="" data-reveal />
    <h1 class="display" data-reveal>Download Wortel.</h1>
    <p class="lead" data-reveal>
      One app for every Mac on {macOS}, signed and notarized by Apple. It is free, and it keeps itself up to date.
    </p>
    <div class="ctas" data-reveal>
      <a class="btn" href={SITE.download} data-get data-ph="download_clicked" data-ph-location="download" data-ph-version={latest?.version}>Download for macOS</a>
      <button class="btn" type="button" data-send hidden data-version={latest?.version}>Send to your Mac</button>
      {latest && <a class="btn ghost" href="/updates" data-ph="changelog_opened" data-ph-location="download" data-ph-version={latest.version}>What’s new in {latest.version}</a>}
    </div>
    <p class="label" data-reveal aria-live="polite">
      <span data-idle>{latest ? `Version ${latest.version}${latest.size ? ` · ${latest.size}` : ''}` : 'The newest version'} · {macOS}</span>
      <span data-busy hidden>Downloading{latest && ` Wortel ${latest.version}`}. Nothing yet? <a class="link" href={SITE.download}>Try again</a>.</span>
      <span data-away hidden>Wortel runs on a Mac. Open this page there, or <a class="link" href={SITE.download} data-ph="download_clicked" data-ph-location="download-phone" data-ph-version={latest?.version}>download it here anyway</a>.</span>
    </p>
  </header>

  <div class="page">
    <section class="stage install" style={photo('skye', '50% 50%')} aria-label="Installing" data-reveal>
      <figure class="file" aria-hidden="true">
        <img src="/icon-256.png" width="80" height="80" alt="" />
        <figcaption>Wortel</figcaption>
      </figure>
      <ol class="steps">
        {INSTALL_STEPS.map(([t, d], i) => (
          <li class="glass">
            <span class="n">{i + 1}</span>
            <h2 class="t">{t}</h2>
            <p>{d}</p>
          </li>
        ))}
      </ol>
    </section>
  </div>
</Layout>

<script>
  // The download starts in place (the link is the DMG), so the page stays and
  // says so, with a second link in case the browser held it back.
  const get = document.querySelector<HTMLAnchorElement>('[data-get]');
  const idle = document.querySelector<HTMLElement>('[data-idle]');
  const busy = document.querySelector<HTMLElement>('[data-busy]');
  get?.addEventListener('click', () => {
    if (idle) idle.hidden = true;
    if (busy) busy.hidden = false;
    document.documentElement.dataset.downloading = '';
  });

  // Sent here by a Download button: press this page's button for them. The
  // mark is taken out of the address first, so a reload or coming back does
  // not download again, and it is passed on as where the click was made.
  // A phone or a tablet: an iPad calls itself a Mac, and is told apart by
  // its touch screen. This asks what the device is, not how wide it is,
  // because the question is whether a Mac app can be opened on it.
  const handheld = /iPhone|iPad|iPod|Android/i.test(navigator.userAgent) || (/Macintosh/.test(navigator.userAgent) && navigator.maxTouchPoints > 1);
  const send = document.querySelector<HTMLButtonElement>('[data-send]');
  const away = document.querySelector<HTMLElement>('[data-away]');
  if (handheld && get && send && idle && away) {
    const url = location.origin + location.pathname;
    get.hidden = true;
    send.hidden = false;
    idle.hidden = true;
    away.hidden = false;
    if (!navigator.share) send.textContent = 'Copy the link';
    // Counted once the page has really gone somewhere, not on the tap: a
    // sheet closed without choosing sent nothing.
    const sent = () => (window as { posthog?: { capture: (name: string, props?: object) => void } }).posthog
      ?.capture('download_link_sent', { location: 'download', ...(send.dataset.version ? { version: send.dataset.version } : {}) });
    send.addEventListener('click', async () => {
      if (navigator.share) {
        // Closing the sheet without choosing rejects; that is not an error.
        try { await navigator.share({ title: document.title, url }); sent(); } catch {}
        return;
      }
      try { await navigator.clipboard.writeText(url); } catch { return; }
      sent();
      // The button says so itself, for a moment, and the download's link stays.
      send.textContent = 'Link copied';
      setTimeout(() => { send.textContent = 'Copy the link'; }, 2000);
    });
  }

  const FROM = ['hero', 'nav', 'footer', '404'];
  const start = () => {
    const from = location.hash.slice(1);
    if (!get || !FROM.includes(from)) return;
    history.replaceState(null, '', location.pathname + location.search);
    if (handheld) return;
    const here = get.dataset.phLocation;
    get.dataset.phLocation = from;
    get.click();
    get.dataset.phLocation = here;
  };
  start();
  // The nav's Download, pressed on this page itself.
  addEventListener('hashchange', start);
</script>

<style>
  .icon { display: block; width: 96px; height: 96px; margin-bottom: 32px; }
  .ctas { display: flex; flex-wrap: wrap; gap: 8px; margin-top: 32px; }
  .phead .label { margin-top: 16px; }
  .phead .label [hidden], .ctas [hidden] { display: none; }
  .phead .label { max-width: 560px; }
  button.btn { appearance: none; border: 0; cursor: pointer; }

  /* The lake as a desktop: the app where the download leaves it, and the four
     steps from there on glass along the bottom. */
  .install { min-height: 480px; padding: 48px; align-items: stretch; justify-content: space-between; gap: 48px; }
  .file { margin: 0; display: flex; flex-direction: column; align-items: center; gap: 8px; width: 112px; }
  .file img { display: block; width: 80px; height: 80px; filter: drop-shadow(0 4px 8px rgb(0 0 0 / 0.25)); }
  /* Finder draws a desktop label dark on a light desktop and light on a dark
     one; the fog is light by day and the lake dark at night. */
  .file figcaption { font-size: 13px; line-height: 16px; font-weight: 500; color: var(--ink); padding: 0 6px; border-radius: 4px; }
  @media (prefers-color-scheme: dark) { .file figcaption { color: #fff; text-shadow: 0 1px 3px rgb(0 0 0 / 0.6); } }
  /* After the click, the file is selected, as Finder draws a selected icon. */
  :global([data-downloading]) .file figcaption { background: var(--accent); color: #fff; text-shadow: none; }
  .steps { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 16px; }
  .steps li { border-radius: 18px; padding: 24px; }
  .n { display: inline-flex; align-items: center; justify-content: center; width: 24px; height: 24px; border-radius: 999px; background: var(--ink); color: var(--fog-0); font: 500 13px/24px var(--font-display); }
  .steps .t { margin: 16px 0 0; font: 500 17px/24px var(--font-display); letter-spacing: -0.01em; color: var(--ink); }
  .steps p { margin: 8px 0 0; font-size: 15px; line-height: 24px; color: var(--ink-2); text-wrap: pretty; }

  /* Four across needs the full width: two rows of two below it. */
  @media (max-width: 1200px) { .steps { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  @media (max-width: 900px) {
    .install { padding: 24px; gap: 32px; }
    .steps { grid-template-columns: 1fr; gap: 8px; }
    .steps li { display: grid; grid-template-columns: 24px 1fr; column-gap: 16px; padding: 16px; }
    .steps .t { margin: 0; }
    .steps p { grid-column: 2; }
  }
</style>
