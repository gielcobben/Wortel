---
// /docs: the reference. Everything here comes from DOCS_SECTIONS in site.ts,
// which llms-full.txt renders too. A section whose feature has a page of its
// own (/layouts, /mark-up) links to it under its name, as the homepage's
// sections do under their headings.
import Layout from '../layouts/Layout.astro';
import Blocks from '../components/Blocks.astro';
import Beta from '../components/Beta.astro';
import { inline } from '../data/inline';
import { SITE, DOCS, DOCS_SECTIONS } from '../data/site';
const abs = (p: string) => new URL(p, SITE.url).href;
const schema = [{
  '@type': 'TechArticle', '@id': abs('/docs#article'), url: abs('/docs'), headline: DOCS.title,
  description: DOCS.description, isPartOf: { '@id': abs('/#website') }, about: { '@id': abs('/#app') }, inLanguage: 'en',
}];
---
<Layout title={DOCS.title} description={DOCS.description} path="/docs" schema={schema} ogImage="/og/docs.png" markdown="/docs.md">
  <header class="page phead" data-reveal-group>
    <h1 class="display" data-reveal>{DOCS.heading}</h1>
    <p class="lead" data-reveal>{DOCS.lead}</p>
    <nav class="toc" aria-label="On this page" data-reveal>
      {DOCS_SECTIONS.map((s) => <a href={`#${s.id}`}>{s.title}</a>)}
    </nav>
  </header>
  <div class="page">
    {DOCS_SECTIONS.map((s) => (
      <section id={s.id} class="row12 read">
        <div class="k stick">
          <h2 class="h2">{s.title}</h2>
          {s.beta && <Beta />}
          {s.page && <a class="arrow" href={s.page[1]}>{s.page[0]}<svg width="7" height="11" viewBox="0 0 7 11" aria-hidden="true"><path d="M1.5 1.5 5.5 5.5l-4 4" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg></a>}
        </div>
        <div class="v">
          {s.lead && <p class="lead" set:html={inline(s.lead)} />}
          <div class="prose"><Blocks blocks={s.blocks} /></div>
        </div>
      </section>
    ))}
  </div>
</Layout>
<style>
  .v .lead { margin-bottom: 24px; }
  /* A link to the feature's page sits under the section's name on its own
     line, and 16 under "Beta" where there is one. */
  .k .arrow { display: flex; width: fit-content; margin-top: 16px; }
  /* Beside the text, each section's name stays in view as you read. Stacked
     on a narrow screen there is no such column, and the page is ten screens
     long, so its sections are listed at the top instead. */
  .toc { display: none; }
  @media (max-width: 900px) {
    .toc { display: flex; flex-direction: column; margin-top: 32px; border-bottom: 1px solid var(--line); }
    .toc a { display: flex; align-items: center; min-height: 48px; padding-block: 8px; border-top: 1px solid var(--line); font-size: 15px; line-height: 24px; font-weight: 500; color: var(--ink); }
  }
</style>
