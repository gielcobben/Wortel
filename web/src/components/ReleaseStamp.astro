---
// What a release is called beside its notes: the version in ink, its date in
// grey on the line under it, like every heading on the site. On the changelog
// the version is a link to the release's own page.
interface Props { id: string; date: Date; href?: string; latest?: boolean }
const { id, date, href, latest = false } = Astro.props;
const fmt = (d: Date) => d.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric', timeZone: 'UTC' });
---
<p class="h2 when">
  {href
    ? <a class="ver" href={href} data-ph="changelog_opened" data-ph-version={id}>{id}</a>
    : <span class="ver">{id}</span>}
  <time class="tone" datetime={date.toISOString().slice(0, 10)}>{fmt(date)}</time>
</p>
{latest && <span class="pill">Latest</span>}

<style>
  .when { font-variant-numeric: tabular-nums; }
  @media (hover: hover) and (pointer: fine) { a.ver:hover { text-decoration: underline; text-decoration-thickness: 1px; text-underline-offset: 6px; } }
  .pill { display: inline-block; margin-top: 16px; font-size: 12px; line-height: 16px; font-weight: 500; padding: 4px 8px; border-radius: 999px; background: var(--accent-soft); color: var(--accent); }
  @media (max-width: 900px) { .pill { margin-top: 8px; } }
</style>
