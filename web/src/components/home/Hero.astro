---
// The landing: the name in two tones, one line under it, the download with
// the newest release beside it, and then the app on the foggy lake, where you type a request and an agent does
// the job (scripts/hero.ts). The words are HOME.hero in data/site.ts.
import Stage from '../Stage.astro';
import HeroWindow from '../../app/gen/HeroWindow.astro';
import { HOME } from '../../data/site';
import { latestRelease } from '../../data/release';
const latest = await latestRelease();
---
<section class="hero" id="what-is-wortel" data-hero>
  <div class="page">
    <div class="top">
      <h1 class="display">
        <span class="vh">Wortel: a native macOS terminal for coding agents. </span>
        <span class="line" data-fade>{HOME.hero.title}</span> <span class="line tone" data-fade>{HOME.hero.tone}</span>
      </h1>
      <p class="lead" data-fade>{HOME.hero.body}</p>
      <div class="ctas" data-fade>
        <a class="btn" href="/download#hero">
          Download for macOS
          <svg width="7" height="11" viewBox="0 0 7 11" aria-hidden="true"><path d="M1.5 1.5 5.5 5.5l-4 4" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
        </a>
        {latest && <a class="btn ghost" href="/updates" data-ph="changelog_opened" data-ph-location="hero" data-ph-version={latest.version}>What’s new in {latest.version}</a>}
      </div>
    </div>

    <Stage class="first" reveal="manual" eager fold>
      <div class="win wapp" data-win data-narrow data-ph-demo aria-hidden="true" data-nosnippet inert>
        <HeroWindow />
      </div>
    </Stage>
  </div>
</section>

<script>
  import { playHero } from '../../scripts/hero';
  playHero();
</script>

<style>
  .hero { padding-top: 144px; }
  .top { margin-bottom: 64px; }
  /* Each line of the name comes in by itself (scripts/hero.ts). */
  .line { display: block; }
  .lead { max-width: 560px; margin-top: 24px; }
  .ctas { display: flex; flex-wrap: wrap; align-items: center; gap: 16px 8px; margin-top: 32px; }
  .ctas .btn:not(.ghost) svg { margin-left: 2px; }
  .hero :global(.stage.first) { padding-top: 48px; }
  /* scripts/hero.ts brings all of this in, in reading order; until it runs,
     nothing shows, so nothing flashes and then vanishes. */
  :global(.js) [data-fade] { opacity: 0; animation: unhide 0s 4s forwards; }
  /* If the script never runs, the words still come back. */
  @keyframes unhide { to { opacity: 1; } }
  /* The window rises once the photo has opened a little, not with it. */
  :global(.js) .hero :global(.stage.first > *) { transition-delay: 450ms; }
  /* The column a little narrower than the canvas drew it (it is a divider you
     drag), so the three tabs in the main row show their names in full beside
     the "+" and the split buttons: at the canvas's 360 the row is 4 short and
     the tabs behind the front one lose the room for their close buttons. */
  .hero :global([data-name="Side column slot"]) { width: 336px; }
  /* The list of changes and the diff share the column's height, half each:
     the canvas gives the list a fixed basis and the diff the rest. */
  .hero :global([data-name="Changes pane"] [data-name="Changes"] > [data-name="List"]),
  .hero :global([data-name="Changes pane"] [data-name="Changes"] > [data-name="Diff"]) { flex: 1 1 0; height: auto; }
  @media (max-width: 900px) { .hero { padding-top: 104px; } .top { margin-bottom: 48px; } }
  /* No controls over this window: on a phone the photo keeps a strip above it. */
  @media (max-width: 760px) { .hero :global(.stage.first) { padding-top: 32px; } }
</style>
