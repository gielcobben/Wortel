---
// The comparison. Framer's grid at the top end, Apple's compare page at the
// bottom, and the same markup the whole way.
//
// THE ONE RULE THAT MAKES IT WORK: there is no row-label column, at any width.
// The question is printed inside every cell, under the answer, the way Apple
// writes "unified memory" under "16GB". That is the move that fits a real
// comparison on a phone: a label column would take a third of 390px and leave
// two crushed slivers, which is exactly what sank the last three attempts here.
// Without it, two categories get half the screen each and you can actually read
// them side by side. NN/g says the same thing: for wordy entries, two columns
// is what fits, and ours are sentences rather than ticks.
//
// So the layout never changes shape. Only the column COUNT changes: five on a
// desktop, two on a phone, chosen with the two pickers in the sticky header
// exactly as Apple's model dropdowns work. Nothing is hidden that you cannot
// bring back, nothing scrolls sideways, and the header pins on both.
//
// The pickers are real <select> elements on purpose. They are the native
// control: on a Mac they open a Mac menu, on iOS the system wheel, and they are
// keyboard and screen-reader correct without a line of ARIA. That is also the
// page's wink at the app, which is otherwise carried by the real window up in
// the hero.
import { APPS, AXES, GROUPS } from '../data/compare';

const byId = new Map(AXES.map((a) => [a.id, a]));
const groups = GROUPS.map((g) => ({ ...g, axes: g.axes.map((id) => byId.get(id)!) }));

// FOUR SLOTS, and how many are filled is what the screen decides: two on a
// phone, three on a tablet, four when there is room. There are ten apps and
// there is no width that shows ten columns of sentences, so every column is
// chosen rather than assumed. This is Apple's compare page exactly: three model
// dropdowns on a desktop, two on a phone, the same grid under both.
const SLOTS = ['a', 'b', 'c', 'd'] as const;
// What each slot starts on, server-rendered, so the page works with no
// JavaScript and the first two are the pair most people came to see.
const START: Record<string, string> = {
  a: 'wortel', b: 'conductor', c: 'cmux', d: 'ghostty',
};

const MARK: Record<string, string> = { yes: '●', partial: '◐', no: '○', unknown: '?' };

// Which cell fills which slot. Generated from APPS so a new app cannot be added
// and forgotten here, and `order` is what lets slot A hold an app that comes
// later in the DOM than slot B's: the pickers are independent, so a pair can be
// chosen in either order. The script keeps two slots from holding the same app,
// which is what stops one cell trying to be in two places.
//
// Unconditional, not inside a media query: a cell is shown because a slot holds
// it, at every width. How many slots exist is the only thing width decides, and
// that is done by hiding the slots themselves.
// A slot's cells live in the rows, not inside the slot's own box, so hiding the
// box does NOT hide its column: on a phone all four slots' cells rendered and
// wrapped into a second grid row. Each slot's rules therefore carry the same
// width gate that reveals its picker, and the two lists below are the single
// place that pairing is written down.
const SLOT_MIN: Record<string, number> = { a: 0, b: 0, c: 1040, d: 1280 };

const rulesFor = (slot: string, i: number) =>
  APPS.flatMap((app) => [
    `.cmp[data-${slot}="${app.key}"] .c-${app.key}{display:flex;order:${i + 1}}`,
    // Scoped to the slot's own box. Without `.s-${slot}` this matches the kind
    // line inside EVERY slot, and each picker prints all four.
    `.cmp[data-${slot}="${app.key}"] .s-${slot} .k-${app.key}{display:block}`,
  ]);

const slotCss = [
  '.cmp .cell{display:none}',
  ...SLOTS.flatMap((slot, i) => {
    const rules = rulesFor(slot, i).join('\n');
    const min = SLOT_MIN[slot];
    return min ? [`@media (min-width:${min}px){\n${rules}\n}`] : [rules];
  }),
].join('\n');
---

<div class="cmp" data-a={START.a} data-b={START.b} data-c={START.c} data-d={START.d}>
  <div class="head">
    <div class="picks">
      {SLOTS.map((slot, i) => (
        <div class={`slot s-${slot}`}>
          <label class="pick">
            <span class="vh">App {i + 1} to compare</span>
            <select data-slot={slot}>
              {APPS.map((app) => (
                <option value={app.key} selected={app.key === START[slot]}>{app.name}</option>
              ))}
            </select>
            <svg class="chev" viewBox="0 0 10 6" width="10" height="6" aria-hidden="true">
              <path d="M1 1l4 4 4-4" fill="none" stroke="currentColor" stroke-width="1.5"
                stroke-linecap="round" stroke-linejoin="round" />
            </svg>
          </label>
          {/* What kind of thing the chosen app is, under its menu. One per app,
              shown by the same slot rule the cells use. */}
          {APPS.map((app) => (
            <p class={`skind k-${app.key}`}>{app.kind}</p>
          ))}
        </div>
      ))}
    </div>
  </div>

  {groups.map((group) => (
    <section class="grp">
      <header class="band">
        <h3>{group.title}</h3>
        <p>{group.blurb}</p>
      </header>

      {group.axes.map((axis) => (
        <div class="row">
          {APPS.map((c) => {
            const cell = axis.cells[c.key];
            return (
              <div class={`cell c-${c.key} v-${cell.v}${axis.descriptive ? ' plain' : ''}${c.key === 'wortel' ? ' us' : ''}`}>
                <p class="ans">
                  {!axis.descriptive && <span class="vmark" aria-hidden="true">{MARK[cell.v]}</span>}
                  <span class="note">{cell.note}</span>
                </p>
                {/* The caption IS the row label. Repeated per cell on purpose:
                    it is what buys the phone its second column. */}
                <p class="cap">{axis.short}</p>
              </div>
            );
          })}
        </div>
      ))}
    </section>
  ))}
</div>

<style is:inline set:html={slotCss} />

<style>
  .cmp, .cmp :global(*) { box-sizing: border-box; }

  .cmp {
    font-family: var(--sans);
    -webkit-font-smoothing: antialiased;
    color: var(--text);
    /* An opaque sheet over the page's graph paper, for the reason the cards
       above have one: a hairline and a grid line are the same mark, and two
       lattices at different offsets read as mess. Nothing in here draws a rule. */
    /* A panel: its own surface, its own edge, lifted off the graph paper. The
       "no lines" rule still holds INSIDE it (no row rules, no column dividers);
       this is the container's edge, not a rule between things.
       No overflow:hidden. Clipping an ancestor is what silenced the sticky
       header before; the head rounds its own top instead, and the bottom
       padding keeps the Wortel wash off the bottom corners. */
    background: var(--bg);
    border: 1px solid var(--panel-border);
    border-radius: 16px;
    box-shadow: var(--panel-shadow);
    padding: 0 6px 12px;
    --fill: color-mix(in srgb, var(--text) 7%, transparent);
  }

  /* Pins while the grid scrolls under it, which is the one thing Framer's page
     does that a long comparison genuinely needs: four rows down you have
     forgotten which column is which. */
  .head {
    position: sticky;
    top: 0;
    z-index: 4;
    /* The one opaque thing on the page, and it has to be: rows scroll under it,
       and a transparent bar would let them through. It is the page colour, so
       at rest it is invisible against it; the soft shadow only reads once
       something has gone underneath. */
    background: var(--bg);
    /* EDGE TO EDGE. The panel's 6px inset exists so the Wortel wash can round
       its corners inside the border; a bar does not want that, so the head
       takes the inset back out with a negative margin and re-adds it as its own
       padding. Net effect: the bar spans the full panel while the menus stay
       lined up with the cells beneath them. */
    margin: 0 -6px 8px;
    padding: 0 6px;
    border-radius: 15px 15px 0 0;
    box-shadow: var(--pinned-shadow);
  }

  .picks {
    display: grid;
    grid-template-columns: repeat(var(--cols), minmax(0, 1fr));
  }
  .slot { padding: 10px 12px 14px; min-width: 0; }
  /* Slots beyond what the width allows do not exist. --cols and this rule move
     together; if they ever disagree the grid grows a blank column. */
  .s-c, .s-d { display: none; }

  /* The kind line under the menu: one per app, and the same slot rule that
     shows a cell shows this. */
  .skind {
    display: none;
    margin: 8px 0 0;
    font-size: 12px;
    line-height: 1.3;
    color: var(--text-50);
  }

  /* Named for a screen reader, not for the page: the menu shows the app it
     holds, and a visible "App 2 to compare" says nothing you cannot see. */
  .vh {
    position: absolute;
    width: 1px; height: 1px; margin: -1px; padding: 0; border: 0;
    overflow: hidden; clip-path: inset(50%); white-space: nowrap;
  }
  /* A real menu, wearing the app's pill. The chevron is ours because a native
     select's own arrow cannot be positioned, but everything that matters (the
     menu, the keyboard, the screen reader) is the platform's. */
  .pick {
    position: relative;
    display: block;
    border-radius: 8px;
    background: var(--fill);
  }
  .pick select {
    appearance: none;
    width: 100%;
    height: 38px;
    padding: 0 30px 0 13px;
    border: 0;
    border-radius: 8px;
    background: none;
    color: var(--text);
    font: inherit;
    font-size: 14px;
    font-weight: 590;
    line-height: 38px;
    cursor: pointer;
  }
  .pick select:focus-visible { outline: 2px solid var(--accent); outline-offset: 1px; }
  .chev {
    position: absolute;
    right: 10px; top: 17px;
    margin-top: -3px;
    color: var(--text-50);
    pointer-events: none;
  }

  /* A band across the whole grid, heading plus a line of context, the way
     Framer separates its sections. */
  .band { padding: 36px 12px 18px; }
  .band h3 { margin: 0; font-size: 16px; font-weight: 500; letter-spacing: -0.014em; }
  .band p {
    margin: 5px 0 0;
    max-width: 62ch;
    font-size: 13px;
    line-height: 1.55;
    color: var(--text-50);
  }

  .row {
    display: grid;
    grid-template-columns: repeat(var(--cols), minmax(0, 1fr));
  }
  /* Two columns is the phone default, and the grid says so rather than leaving
     --cols undefined. */
  .cmp { --cols: 2; }

  .cell {
    display: flex;
    flex-direction: column;
    gap: 5px;
    padding: 20px 12px 24px;
    min-width: 0;
  }
  .cell.us { background: color-mix(in srgb, var(--accent) 6%, transparent); }
  /* One rounded block per group, not per row: the wash is a stack of separate
     cells, so rounding each would break the column into chips. Only the first
     and last row of a group take a radius, which is what makes the column read
     as one inset panel, the same shape the cards use. */
  .grp .row:first-of-type .cell.us { border-radius: 11px 11px 0 0; }
  .grp .row:last-of-type .cell.us { border-radius: 0 0 11px 11px; }
  .grp .row:only-of-type .cell.us { border-radius: 11px; }
  /* The wash has to run unbroken down the column, so every pixel of row spacing
     lives INSIDE the cell. Put it on the row and the wash stops at each gap and
     the column reads as stripes. */

  .ans {
    margin: 0;
    display: grid;
    grid-template-columns: 16px minmax(0, 1fr);
    gap: 6px;
    align-items: baseline;
    font-size: 14px;
    line-height: 1.5;
  }
  /* A descriptive answer has no verdict, so the answer takes the whole cell and
     its caption loses the indent that lines the others up under their mark. */
  .cell.plain .ans { grid-template-columns: minmax(0, 1fr); }
  .cell.plain .cap { padding-left: 0; }
  .vmark { font-size: 10px; line-height: 2.1; }
  .note { color: var(--text); }
  .v-no .note, .v-partial .note { color: var(--text-70); }

  .v-yes .vmark { color: var(--accent); }
  .v-partial .vmark { color: var(--text-50); }
  .v-no .vmark { color: var(--text-50); opacity: 0.5; }
  /* "?" is not a worse "no": it means they do not publish it, so it is drawn as
     a question rather than as a failure. */
  .v-unknown .vmark { color: var(--text-50); font-size: 12px; }
  .v-unknown .note { color: var(--text-70); font-style: italic; }

  /* The label, under the answer. Apple's caption: small, quiet, and the same in
     every column so the eye reads across rather than down. */
  .cap {
    margin: 0;
    padding-left: 22px;
    font-size: 12px;
    line-height: 1.4;
    color: var(--text-50);
  }

  /* Three slots once there is room for three columns of sentences, four when
     there is room for four. --cols and the slot visibility are set together. */
  @media (min-width: 1040px) {
    .cmp { --cols: 3; }
    .s-c { display: block; }
    .band { padding: 36px 12px 18px; }
    .cell { padding: 22px 16px 26px; }
    .slot { padding: 12px 16px 16px; }
  }
  @media (min-width: 1280px) {
    .cmp { --cols: 4; }
    .s-d { display: block; }
  }

  @media (max-width: 380px) {
    .cell { padding: 11px 9px 13px; }
    .ans { grid-template-columns: 11px minmax(0, 1fr); gap: 5px; font-size: 12px; }
    .cap { padding-left: 16px; }
  }
</style>

<script>
  // The pickers, kept from two slots landing on the same app: choosing the one
  // another slot holds swaps the pair, which is what a reader means by it. With
  // four slots the swap has to find WHICH other slot holds it, rather than
  // assuming there is only one other.
  for (const cmp of document.querySelectorAll<HTMLElement>('.cmp')) {
    const selects = [...cmp.querySelectorAll<HTMLSelectElement>('.pick select')];
    for (const sel of selects) {
      sel.addEventListener('change', () => {
        const slot = sel.dataset.slot!;
        const previous = cmp.dataset[slot];
        const clash = selects.find((s) => s.dataset.slot !== slot && s.value === sel.value);
        if (clash && previous) {
          clash.value = previous;
          cmp.dataset[clash.dataset.slot!] = previous;
        }
        cmp.dataset[slot] = sel.value;
      });
    }
  }
</script>
