---
// Worktrees: each session is its own branch in its own directory. The
// chapters are branches (scripts/scenes.ts): pick one and the window is that
// worktree, from the shell's directory to the changes in the column; the last
// chapter is the one history they all share.
import Stage from '../Stage.astro';
import Sidebar from '../../app/gen/Sidebar.astro';
import TerminalNarrow from '../../app/gen/TerminalNarrow.astro';
import BottomStrip from '../../app/gen/BottomStrip.astro';
import Changes from '../../app/gen/Changes.astro';
import History from '../../app/gen/History.astro';

const chapters = [
  { label: 'main', mono: true, caption: 'The session you started in: its shell, its branch, its changes.' },
  { label: 'codebase-survey-and-fixes', mono: true, keys: '⇧⌘N', caption: 'A session on a branch gets a directory of its own. It costs a directory, not a clone.' },
  { label: 'appcast-cleanup', mono: true, caption: 'Each one shows only its own work. Nothing changes the ground under another.' },
  { label: 'One history', caption: 'They share the repository’s history, objects and remotes. Worktrees live outside it.' },
];
---
<section class="sec" id="worktrees">
  <div class="page">
    <div class="bhead" data-reveal>
      <h2 class="h2">Five agents, one repository. <span class="tone">Open a session on a branch and Wortel checks it out in a directory of its own. Each agent edits its own files, and nothing changes the ground under another mid-task.</span></h2>
    </div>
    <Stage film="worktrees" chapters={chapters} at="50% 100%" zoom="150%" w={1040} h={616}>
      <div class="win wapp" aria-hidden="true" inert>
        <div class="absolute inset-0 bg-sidebar backdrop-blur-[50px] backdrop-saturate-[1.8]"></div>
        <div class="relative flex size-full">
          <div class="flex w-[234px] shrink-0"><Sidebar /></div>
          <div class="w-px shrink-0 bg-sidebar-border"></div>
          <div class="flex min-w-[80px] flex-1 flex-col">
            <div class="flex min-h-0 flex-1"><TerminalNarrow /></div>
            <div class="flex h-[96px] shrink-0"><BottomStrip /></div>
          </div>
          <div class="w-px shrink-0 bg-sidebar-border"></div>
          <div class="col">
            <div data-col="changes"><Changes /></div>
            <div data-col="history"><History /></div>
          </div>
        </div>
      </div>
    </Stage>
  </div>
</section>

<style>
  .col { display: grid; width: 360px; flex: none; min-height: 0; }
  .col > div { grid-area: 1 / 1; display: flex; min-width: 0; min-height: 0; }
  .col > div > :global(*) { flex: 1; }
  .col > [data-col="history"] { visibility: hidden; opacity: 0; }
</style>
