---
import Layout from '../layouts/Layout.astro';
---

<Layout>
  <div class="page">
    <div class="intro">
      <p class="lede">
        <b>Wortel</b> puts Ghostty’s engine behind a terminal stripped to what
        you actually use — named sessions, instant launch, instant switching.
        No tabs, no splits, no config to babysit. It’s finished the moment you
        open it.
      </p>
    </div>

    <div class="stage">
      <!-- Callouts use the exact arrow vectors exported from the Figma file. -->
      <div class="note n1">
