---
// Worktrees: each session is its own branch in its own directory. The
// chapters are sessions (scripts/scenes.ts): pick one, in the bar or in the
// sidebar itself, and the window is that worktree, from the shell's
// directory to the changes in the column; the last is the history they share.
import Stage from '../Stage.astro';
import Window from '../Window.astro';
import Sidebar from '../../app/gen/Sidebar.astro';
import TerminalNarrow from '../../app/gen/TerminalNarrow.astro';
import BottomStrip from '../../app/gen/BottomStrip.astro';
import Changes from '../../app/gen/Changes.astro';
import History from '../../app/gen/History.astro';

const chapters = [
  { label: 'First', caption: 'Every session works in a directory of its own, on a branch of its own.' },
  { label: 'Second', caption: 'Open another on a branch and it gets its own worktree. It costs a directory, not a clone.' },
  { label: 'Third', caption: 'Each shows only its own changes, so no agent edits the ground under another.' },
  { label: 'Shared history', caption: 'They share one history, and the worktrees live outside the repository.' },
];
---
<section class="sec" id="worktrees">
  <div class="page">
    <Stage title="Five agents, one repository." film="worktrees" chapters={chapters} at="50% 100%" zoom="150%">
      <Window live>
        <div class="flex min-h-0 self-stretch w-[234px] min-w-[180px] shrink"><Sidebar /></div>
        <div class="w-px shrink-0 self-stretch bg-sidebar-border"></div>
        <div class="flex min-h-0 min-w-[80px] flex-1 flex-col self-stretch">
          <div class="flex min-h-0 flex-1"><TerminalNarrow /></div>
          <div class="flex h-[112px] shrink-0 flex-col"><BottomStrip /></div>
        </div>
        <div class="w-px shrink-0 self-stretch bg-sidebar-border"></div>
        <div class="col">
          <div data-col="changes"><Changes /></div>
          <div data-col="history"><History /></div>
        </div>
      </Window>
    </Stage>
  </div>
</section>

<style>
  .col { display: grid; width: 384px; flex: none; min-height: 0; align-self: stretch; }
  .col > div { grid-area: 1 / 1; display: flex; min-width: 0; min-height: 0; }
  .col > div > :global(*) { flex: 1; }
  .col > [data-col="history"] { visibility: hidden; opacity: 0; }
</style>
