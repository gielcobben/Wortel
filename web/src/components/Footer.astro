---
// The close of every page: the icon and the download, then the links, on the
// same container and grid as everything above.
import { SITE } from '../data/site';
import { latestRelease } from '../data/release';
interface Props { bare?: boolean }
const { bare = false } = Astro.props;
const latest = await latestRelease();
const cols: [string, [string, string][]][] = [
  ['Wortel', [['Download', SITE.download], ['Changelog', '/updates'], ['Docs', '/docs'], ['Compare', '/compare']]],
  ['More', [['About', '/about'], ['llms.txt', '/llms.txt']]],
  ['Legal', [['Privacy', '/privacy'], ['Terms', '/terms']]],
];
---
<footer class="foot">
  {!bare && (
    <section class="sec page cta" data-reveal-group>
      <img src="/icon-512.png" width="80" height="80" alt="" data-reveal />
      <h2 class="h2" data-reveal>Put down roots. <span class="tone">Free for macOS {SITE.minMacOS} {SITE.minMacOSName} or later, and it updates itself.</span></h2>
      <div class="go" data-reveal>
        <a class="btn" href={SITE.download} data-ph="download_clicked" data-ph-location="footer" data-ph-version={latest?.version}>Download for macOS</a>
        {latest && <span class="label">Version {latest.version}{latest.size && ` · ${latest.size}`}</span>}
      </div>
    </section>
  )}
  <div class="page">
    <div class="grid12 links">
      <div class="sig">
        <a class="brand" href="/"><img src="/icon-128.png" width="24" height="24" alt="" /><span>Wortel</span></a>
        <p class="small">Wortel is Dutch for root.</p>
      </div>
      {cols.map(([h, items]) => (
        <div class="col">
          <p class="label">{h}</p>
          <ul>{items.map(([t, href]) => <li><a href={href}>{t}</a></li>)}</ul>
        </div>
      ))}
    </div>
    <div class="base">
      <p class="label">© {new Date().getFullYear()} {SITE.author}</p>
      <p class="label">Built on <a class="link" href="https://ghostty.org">Ghostty</a></p>
    </div>
  </div>
</footer>

<style>
  .foot { padding-bottom: 40px; }
  .cta .h2 { max-width: 560px; margin-top: 32px; }
  .cta .go { display: flex; align-items: center; gap: 16px; margin-top: 32px; flex-wrap: wrap; }
  .links { margin-top: 96px; padding-top: 48px; border-top: 1px solid var(--line); row-gap: 40px; }
  .sig { grid-column: span 6; display: flex; flex-direction: column; gap: 16px; }
  .col { grid-column: span 2; }
  .brand { display: inline-flex; align-items: center; gap: 8px; font: 600 17px/24px var(--font-display); letter-spacing: -0.02em; color: var(--ink); }
  .col ul { list-style: none; padding: 0; margin: 16px 0 0; display: flex; flex-direction: column; gap: 8px; }
  .col a { font-size: 14px; line-height: 24px; color: var(--ink-2); transition: color 0.2s; }
  .col a:hover { color: var(--ink); }
  .base { display: flex; justify-content: space-between; gap: 16px; margin-top: 64px; flex-wrap: wrap; }
  @media (max-width: 800px) {
    .sig { grid-column: 1 / -1; }
    .col { grid-column: span 4; }
  }
</style>
