---
// The site footer, in one place.
//
// This markup was copied into five pages and drifted. When the homepage's
// footer was redesigned, the global `.foot` rules it needed silently broke the
// other four, which is exactly the failure a shared component exists to
// prevent. The pages that still carry their own copy are /compare, /docs and
// the legal pages; moving them over is the same edit as this one.
//
// The link set is deliberately identical everywhere. A footer that changes
// shape per page is a footer a reader has to re-read.
import LegalNav from './LegalNav.astro';
import { SITE } from '../data/site';

interface Props {
  /** data-ph-location for the download link: which page's footer clicked. */
  location: string;
  /** Version to tag that click with, on pages that have read the appcast. */
  version?: string;
  /** The raw Sparkle feed. Only /updates has a reason to offer it. */
  feed?: boolean;
  /** Id of the legal page being viewed, so LegalNav renders it unlinked. */
  current?: string;
}

const { location, version, feed = false, current } = Astro.props;
---

<footer class="foot">
  <div class="prose">
    <!-- Grouped and stacked rather than one wrapping row. Nine links in a
         single line broke wherever the measure ran out, which put the boundary
         between the product and the legal pages at whatever column the browser
         picked that day. A named group is also the only thing that says what
         llms.txt is doing next to Privacy. One <nav> per group, each labelled:
         a screen reader lists landmarks by name, and three navs called
         "Footer" are three identical entries. -->
    <div class="cols">
      <p class="blurb">
        <strong>{SITE.name}</strong> is a native macOS terminal built on
        Ghostty’s engine, for keeping a handful of coding agents running at
        once. The name is Dutch for <em>root</em>, as in the root shell.
      </p>

      <div class="group">
        <p class="head">Product</p>
        <nav aria-label="Product">
          <a href="/">Home</a>
          <a href={SITE.download}
            data-ph="download_clicked" data-ph-location={location} data-ph-version={version}>Download</a>
          <a href="/updates">Changelog</a>
          <a href="/compare">Compare</a>
        </nav>
      </div>

      <div class="group">
        <p class="head">Reference</p>
        <!-- `/#faq` and not `#faq`: from any other page the bare fragment is a
             link to nothing. On the homepage the path already matches, so the
             browser still treats it as a same-document jump and the smooth
             scroll is unchanged. -->
        <nav aria-label="Reference">
          <a href="/docs">Docs</a>
          <a href="/#faq">FAQ</a>
          <a href="/llms.txt">llms.txt</a>
          {feed && <a href={SITE.appcast}>Update feed</a>}
        </nav>
      </div>

      <!-- No heading and a row rather than a column: two links everyone
           already recognises do not need to be told apart, and a "Legal" label
           over them was a third column heading competing with the two carrying
           real navigation. Smaller for the same reason. -->
      <nav class="legal" aria-label="Legal">
        <LegalNav current={current} />
      </nav>
    </div>
  </div>
</footer>
